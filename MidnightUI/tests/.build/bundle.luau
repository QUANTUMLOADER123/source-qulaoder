__modules["src/Element"] = function()
--!strict
--[[
	MidnightUI · Element
	------------------------------------------------------------------
	Base class for every interactive element (Toggle, Slider, Dropdown,
	Textbox, Button, Keybind, ColorPicker, ...).

	It owns the boring but critical parts so that individual elements
	stay small and consistent:

		· container lifetime + :Destroy()
		· Flags (Window.Flags) + :OnChanged callbacks
		· theme colour bindings + live re-theming
		· height accounting used by the masonry layout
		· visibility / disabled state
		· hover helpers and tooltips
]]

local Maid = __req("src/Maid")
local Signal = __req("src/Signal")
local Util = __req("src/Util")

local Element = {}
Element.__index = Element

export type Props = {
	Title: string?,
	Description: string?,
	Tooltip: string?,
	Flag: string?,
	Default: any?,
	Visible: boolean?,
	Disabled: boolean?,
	Height: number?,
	Order: number?,
	Callback: ((value: any) -> ())?,
	Class: any?,
}

export type ColorBinding = {
	Instance: any,
	Property: string,
	Key: string,
	Transparency: number?,
	TransparencyProperty: string?,
}

export type Element = typeof(setmetatable(
	{} :: {
		Class: string,
		Instance: Frame,
		Container: Frame,
		Title: string?,
		Flag: string?,
		Value: any,
		Height: number,
		Section: any,
		Theme: any,
		Window: any,
		Changed: any,
		_bindings: { ColorBinding },
		_maid: any,
		_destroyed: boolean,
		_disabled: boolean,
		_visible: boolean,
		_tooltip: string?,
		_defaultValue: any,
	},
	Element
))

--// Construction -----------------------------------------------------

function Element.new(props: Props): Element
	local class = props.Class or Element

	local self: any = setmetatable({}, class)

	self.Class = class.Name or "Element"
	self.Title = props.Title
	self.Flag = props.Flag
	self.Value = props.Default
	self._defaultValue = props.Default
	self._tooltip = props.Tooltip
	self.Description = props.Description
	self.Height = props.Height or 20
	self._bindings = {}
	self._maid = Maid.new()
	self._destroyed = false
	self._disabled = props.Disabled == true
	self._visible = props.Visible ~= false
	self.Changed = Signal.new()
	self._callback = props.Callback

	local container = Instance.new("Frame")

	container.Name = self.Class
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.new(1, 0, 0, self.Height)
	container.LayoutOrder = props.Order or 1
	container.Visible = self._visible

	self.Container = container
	self.Instance = container

	return self :: Element
end

--// Registration helpers ---------------------------------------------

function Element.SetSection(self: Element, section: any)
	self.Section = section
	self.Theme = section.Theme
	self.Window = section.Window

	if self._tooltip ~= nil then
		self:_attachTooltip()
	end

	self:OnThemeChanged()
end

--- Registers a color that follows the active theme.
function Element.Bind(self: Element, instance: any, property: string, key: string): any
	table.insert(self._bindings, {
		Instance = instance,
		Property = property,
		Key = key,
	})

	local color = self.Theme and self.Theme.Colors[key]

	if color ~= nil then
		instance[property] = color
	end

	return instance
end

--- Registers a transparency tied to the theme's color key transparency
--- (kept simple: the caller passes the value, we just remember it).
function Element.BindTransparency(
	self: Element,
	instance: any,
	property: string,
	_transparencyKey: string,
	value: number
): any
	instance[property] = value

	return instance
end

--- Applies every registered theme binding. Called on window:SetTheme().
function Element.ApplyTheme(self: Element)
	for _, binding in self._bindings do
		local color = self.Theme.Colors[binding.Key]

		if color ~= nil then
			binding.Instance[binding.Property] = color
		end
	end

	if self.OnThemeChanged then
		self:OnThemeChanged()
	end
end

--// Value handling ---------------------------------------------------

function Element.GetValue(self: Element): any
	return self.Value
end

--- Commits a new value: updates visuals, flags and callbacks.
--- `fireCallback` defaults to true; internal syncs pass false.
function Element.SetValue(self: Element, value: any, fireCallback: boolean?)
	if self._destroyed then
		return
	end


	self.Value = value

	if self.ValueChanged then
		self:ValueChanged(value)
	end

	self.Changed:Fire(value)

	if self.Window ~= nil and self.Flag ~= nil then
		self.Window:_setFlag(self.Flag, value)
	end

	if fireCallback ~= false and self._callback ~= nil then
		local ok, err = pcall(self._callback, value)

		if not ok then
			warn(("[MidnightUI] Callback for element %q errored: %s"):format(tostring(self.Title), tostring(err)))
		end
	end
end

--- Returns the value back to the one passed at construction time.
function Element.Reset(self: Element)
	self:SetValue(self._defaultValue)
end

function Element.OnChanged(self: Element, callback: (value: any) -> ()): any
	return self.Changed:Connect(callback)
end

--- Optional visual update hook implemented by concrete elements.
function Element.ValueChanged(self: Element, _value: any) end

--// State ------------------------------------------------------------

function Element.SetTitle(self: Element, title: string)
	self.Title = title

	if self.TitleChanged then
		self:TitleChanged(title)
	end
end

function Element.SetVisible(self: Element, visible: boolean)
	if self._visible == visible then
		return
	end

	self._visible = visible
	self.Instance.Visible = visible

	if self.Section ~= nil then
		self.Section:_notifyLayoutChanged()
	end
end

function Element.IsVisible(self: Element): boolean
	return self._visible
end

function Element.SetDisabled(self: Element, disabled: boolean)
	self._disabled = disabled

	if self.DisabledChanged then
		self:DisabledChanged(disabled)
	end
end

function Element.IsDisabled(self: Element): boolean
	return self._disabled
end

function Element.SetTooltip(self: Element, text: string?)
	self._tooltip = text
end

--// Interaction helpers ----------------------------------------------

--- Wires hover enter/leave with optional tween presets.
export type HoverOptions = {
	OnEnter: (() -> ())?,
	OnLeave: (() -> ())?,
}

function Element.AddHover(self: Element, target: GuiObject, options: HoverOptions?)
	target.Active = true

	self:Connect(target.MouseEnter, function()
		if self._disabled then
			return
		end

		if options and options.OnEnter then
			options.OnEnter()
		end

		if self.OnHoverEnter then
			self:OnHoverEnter()
		end
	end)

	self:Connect(target.MouseLeave, function()
		if options and options.OnLeave then
			options.OnLeave()
		end

		if self.OnHoverLeave then
			self:OnHoverLeave()
		end
	end)
end

function Element._attachTooltip(self: Element)
	if self.Window == nil or self._tooltip == nil then
		return
	end

	self:Connect(self.Container.MouseEnter, function()
		self.Window:_showTooltip(self._tooltip :: string)
	end)

	self:Connect(self.Container.MouseLeave, function()
		self.Window:_hideTooltip()
	end)
end

--- Connects an RBXScriptSignal/our Signal and ties it to the element.
function Element.Connect(self: Element, signal: any, callback: (...any) -> ()): any
	local connection = signal:Connect(callback)

	if self._maid ~= nil then
		self._maid:Add(connection)
	end

	return connection
end

--- Remembers an instance created by this element for cleanup.
function Element.Track(self: Element, instance: Instance | any): any
	self._maid:Add(instance)

	return instance
end

--// Layout -----------------------------------------------------------

function Element.GetHeight(self: Element): number
	if not self._visible then
		return 0
	end

	return self.Height
end

--- Lets elements with dynamic height (e.g. multi-line paragraphs)
--- tell the section about a change.
function Element.NotifyHeightChanged(self: Element, height: number?)
	if height ~= nil then
		self.Height = height
		self.Instance.Size = UDim2.new(1, 0, 0, height)
	end

	if self.Section ~= nil then
		self.Section:_notifyLayoutChanged()
	end
end

--// Destructor -------------------------------------------------------

function Element.Destroy(self: Element)
	if self._destroyed then
		return
	end

	self._destroyed = true
	self.Changed:DisconnectAll()
	self._maid:Destroy()

	self.Instance:Destroy()

	if self.Section ~= nil then
		self.Section:_notifyLayoutChanged()
	end

	self.Section = nil
	self.Window = nil
end

function Element.IsDestroyed(self: Element): boolean
	return self._destroyed
end

return Element
end

__modules["src/Elements/Button"] = function()
--!strict
--[[
	MidnightUI · Button
	------------------------------------------------------------------
	Full width action button ("Set", "Apply", … on the screenshots).

	Styles
		· Default – flat dark box with a hairline border
		· Accent  – accent fill, dark label
		· Danger  – red fill
		· Ghost   – transparent with a border only

	Feedback: hover lift, press squash, material ripple, optional icon.
]]

local Icon = __req("src/Icon")
local Util = __req("src/Util")

local Element = __req("src/Element")

local Button = setmetatable({}, { __index = Element })
Button.__index = Button
Button.Name = "Button"

export type Props = {
	Title: string?,
	Icon: string?,
	Style: ("Default" | "Accent" | "Danger" | "Ghost")?,
	Width: number?,
	Callback: ((value: boolean) -> ())?,
	Flag: string?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Ripple: boolean?,
	Order: number?,
}

function Button.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Button,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = false,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Style = options.Style or "Default"
	self.Height = metrics.ButtonHeight
	self.Instance.Size = if options.Width ~= nil
		then UDim2.fromOffset(options.Width, self.Height)
		else UDim2.new(1, 0, 0, self.Height)

	local box = Instance.new("Frame")

	box.Name = "Box"
	box.BackgroundColor3 = theme.Colors.Element
	box.BorderSizePixel = 0
	box.ClipsDescendants = true
	box.Size = UDim2.new(1, 0, 1, 0)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, metrics.FieldRadius)

	local stroke = Util.addStroke(box, theme.Colors.ElementBorder, 1)

	local boxScale = Instance.new("UIScale")

	boxScale.Parent = box

	local iconSize = 14
	local labelOffset = 0
	local icon = nil

	if options.Icon ~= nil then
		icon = Icon.create(options.Icon, {
			Size = iconSize,
			Color = theme.Colors.Text,
			Parent = box,
			Position = UDim2.new(0.5, -(iconSize / 2), 0.5, -(iconSize / 2)),
			Name = "Icon",
			ZIndex = 3,
		})

		labelOffset = iconSize + 8
	end

	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Size = UDim2.new(1, -labelOffset, 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TextSize
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 3
	label.Parent = box

	Util.setFont(label, theme.Fonts.Text)

	if icon ~= nil then
		-- shift both icon and label so the pair stays centred
		icon.Position = UDim2.new(0.5, -(labelOffset / 2), 0.5, -(iconSize / 2))
		label.Position = UDim2.new(0.5, iconSize / 2 + 4, 0.5, 0)
		label.Size = UDim2.new(1, -(iconSize + 16), 1, 0)
		label.TextXAlignment = Enum.TextXAlignment.Left
	end

	self.Box = box
	self.Label = label
	self.Icon = icon
	self._labelOffset = labelOffset
	self._hovering = false
	self._pressed = false

	local function palette(): (Color3, Color3, Color3)
		-- (background, border, text)
		local style = self.Style

		if style == "Accent" then
			return theme.Colors.Accent, theme.Colors.AccentHover, theme.Colors.AccentText
		elseif style == "Danger" then
			return theme.Colors.Danger, theme.Colors.Danger, Color3.fromRGB(255, 255, 255)
		elseif style == "Ghost" then
			return theme.Colors.Panel, theme.Colors.ElementBorder, theme.Colors.Text
		end

		return theme.Colors.Element, theme.Colors.ElementBorder, theme.Colors.Text
	end

	function self.Refresh()
		local background, border, text = palette()
		local disabled = self:IsDisabled()

		if disabled then
			box.BackgroundColor3 = background
			box.BackgroundTransparency = 0.5
			stroke.Color = border
			stroke.Transparency = 0.5
			label.TextColor3 = theme.Colors.TextDisabled

			if icon ~= nil then
				Icon.setColor(icon, theme.Colors.TextDisabled)
			end

			return
		end

		box.BackgroundTransparency = self.Style == "Ghost" and 0.55 or 0
		box.BackgroundColor3 = if self._hovering and self.Style == "Default"
			then theme.Colors.ElementHover
			else background

		stroke.Color = if self._hovering then theme.Colors.Accent else border
		stroke.Transparency = if self._hovering then 0.25 else 0.4
		label.TextColor3 = text

		if icon ~= nil then
			Icon.setColor(icon, text)
		end
	end

	function self.OnHoverEnter()
		self._hovering = true

		if not self:IsDisabled() then
			Util.tween(boxScale, { Scale = 1.02 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end

		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false

		Util.tween(boxScale, { Scale = 1 }, theme, {
			Duration = theme.Animation.Fast,
		})

		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		self:Refresh()
	end

	self:AddHover(self.Instance)

	self:Connect(box.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		self._pressed = true

		Util.tween(boxScale, { Scale = 0.97 }, theme, {
			Duration = theme.Animation.Instant,
		})

		if options.Ripple ~= false then
			local rippleColor = if self.Style == "Accent" or self.Style == "Danger"
				then Color3.fromRGB(255, 255, 255)
				else theme.Colors.Accent

			Util.ripple(box, Vector2.new(input.Position.X, input.Position.Y), rippleColor, self._maid)
		end
	end)

	self:Connect(box.InputEnded, function(input: InputObject)
		if not self._pressed then
			return
		end

		self._pressed = false

		Util.tween(boxScale, { Scale = self._hovering and 1.02 or 1 }, theme, {
			Duration = theme.Animation.Fast,
		})
	end)

	self:Connect(box.MouseButton1Click, function()
		if self:IsDisabled() then
			return
		end

		self:SetValue(true)
	end)

	function self.SetTitle(title: string, iconName: string?)
		self.Title = title
		label.Text = title

		if iconName ~= nil and icon ~= nil then
			icon:Destroy()

			icon = Icon.create(iconName, {
				Size = iconSize,
				Color = theme.Colors.Text,
				Parent = box,
				Position = UDim2.new(0.5, -(self._labelOffset / 2), 0.5, -(iconSize / 2)),
				Name = "Icon",
				ZIndex = 3,
			})

			self.Icon = icon
		end
	end

	self:Refresh()

	return self
end

return Button
end

__modules["src/Elements/ColorPicker"] = function()
--!strict
--[[
	MidnightUI · ColorPicker
	------------------------------------------------------------------
	`Label ................................ ( ████ )` with a saturated
	value square + hue strip + hex field inside the popup.

	The picker keeps its own HSV state so that dragging never loses
	hue information (a pure Color3 cannot represent greys properly).
]]

local UserInputService = game:GetService("UserInputService")

local Util = __req("src/Util")

local Element = __req("src/Element")

local ColorPicker = setmetatable({}, { __index = Element })
ColorPicker.__index = ColorPicker
ColorPicker.Name = "ColorPicker"

export type Props = {
	Title: string?,
	Default: Color3?,
	Flag: string?,
	Callback: ((value: Color3) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

function ColorPicker.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = ColorPicker,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = options.Default or Color3.fromRGB(147, 168, 195),
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Height = metrics.ColorSwatchHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)
	self._hovering = false
	self._open = false
	self._popup = nil
	self._dragging = nil
	self._dragConnections = {}

	local swatchWidth = metrics.ColorSwatchWidth

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, -(swatchWidth + metrics.Gap), 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Swatch --------------------------------------------------------
	local swatch = Instance.new("Frame")

	swatch.Name = "Swatch"
	swatch.AnchorPoint = Vector2.new(1, 0.5)
	swatch.BackgroundColor3 = self.Value
	swatch.BorderSizePixel = 0
	swatch.Position = UDim2.new(1, 0, 0.5, 0)
	swatch.Size = UDim2.fromOffset(swatchWidth, swatchWidth)
	swatch.ZIndex = 2
	swatch.Parent = self.Instance

	Util.addCorner(swatch, 4)

	local swatchStroke = Util.addStroke(swatch, theme.Colors.ElementBorder, 1, 0.2)

	self.Swatch = swatch
	self.Label = label

	--// State helpers --------------------------------------------------
	local function toHsv(color: Color3): (number, number, number)
		return Color3.toHSV(color)
	end

	local function currentHsv(): (number, number, number)
		local hue, saturation, value = toHsv(self.Value)

		-- Grey colors carry no hue — reuse the last dragged hue.
		if saturation == 0 then
			hue = self._hue or hue
		end

		self._hue = hue

		return hue, saturation, value
	end

	function self.Refresh()
		local disabled = self:IsDisabled()

		swatch.BackgroundColor3 = self.Value
		swatchStroke.Color = if self._open or self._hovering then theme.Colors.Accent else theme.Colors.ElementBorder
		swatchStroke.Transparency = if disabled then 0.5 else 0.2
		swatch.BackgroundTransparency = if disabled then 0.5 else 0
		label.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false
		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		self:Refresh()
	end

	--// Popup ----------------------------------------------------------
	local function stopDragging()
		for _, connection in self._dragConnections do
			connection:Disconnect()
		end

		table.clear(self._dragConnections)

		self._dragging = nil
	end

	local function beginDrag(target: Frame, update: (relativeX: number, relativeY: number) -> ())
		self._dragging = target

		local function apply(input: InputObject)
			local position = Vector2.new(input.Position.X, input.Position.Y)
			local origin = target.AbsolutePosition
			local size = target.AbsoluteSize

			update(
				Util.clamp((position.X - origin.X) / math.max(size.X, 1), 0, 1),
				Util.clamp((position.Y - origin.Y) / math.max(size.Y, 1), 0, 1)
			)
		end

		table.insert(
			self._dragConnections,
			UserInputService.InputChanged:Connect(function(input: InputObject)
				if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
				then
					apply(input)
				end
			end)
		)

		table.insert(
			self._dragConnections,
			UserInputService.InputEnded:Connect(function(input: InputObject)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					stopDragging()
				end
			end)
		)
	end

	local function buildContent(parent: Frame): number
		local hue, saturation, value = currentHsv()

		local pickerSize = theme.Metrics.Popup.ColorPickerSize
		local areaHeight = 104
		local hueHeight = theme.Metrics.Popup.HueHeight
		local hexHeight = 26
		local gap = 8

		--// Saturation / value square ---------------------------------
		local area = Instance.new("Frame")

		area.Name = "SaturationValue"
		area.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		area.BorderSizePixel = 0
		area.ClipsDescendants = true
		area.Size = UDim2.fromOffset(pickerSize, areaHeight)
		area.ZIndex = 22
		area.Parent = parent

		Util.addCorner(area, 6)

		local whiteGradient = Util.addGradient(area, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 0)

		whiteGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		})

		local blackOverlay = Instance.new("Frame")

		blackOverlay.Name = "Value"
		blackOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
		blackOverlay.BorderSizePixel = 0
		blackOverlay.Size = UDim2.fromScale(1, 1)
		blackOverlay.ZIndex = 23
		blackOverlay.Parent = area

		local blackGradient = Util.addGradient(blackOverlay, Color3.new(0, 0, 0), Color3.new(0, 0, 0), 90)

		blackGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		})

		local marker = Instance.new("Frame")

		marker.Name = "Marker"
		marker.AnchorPoint = Vector2.new(0.5, 0.5)
		marker.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		marker.BackgroundTransparency = 1
		marker.BorderSizePixel = 0
		marker.Size = UDim2.fromOffset(12, 12)
		marker.Position = UDim2.new(saturation, 0, 1 - value, 0)
		marker.ZIndex = 25
		marker.Parent = area

		Util.addCorner(marker, 6)
		Util.addStroke(marker, Color3.fromRGB(255, 255, 255), 1.6)

		--// Hue strip ---------------------------------------------------
		local hueStrip = Instance.new("Frame")

		hueStrip.Name = "Hue"
		hueStrip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		hueStrip.BorderSizePixel = 0
		hueStrip.Position = UDim2.fromOffset(0, areaHeight + gap)
		hueStrip.Size = UDim2.fromOffset(pickerSize, hueHeight)
		hueStrip.ZIndex = 22
		hueStrip.Parent = parent

		Util.addCorner(hueStrip, hueHeight / 2)

		local hueGradient = Util.addGradient(
			hueStrip,
			Color3.fromHSV(0, 1, 1),
			Color3.fromHSV(1, 1, 1),
			0
		)

		hueGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
			ColorSequenceKeypoint.new(1.0, Color3.fromHSV(1, 1, 1)),
		})

		local hueKnob = Instance.new("Frame")

		hueKnob.Name = "Knob"
		hueKnob.AnchorPoint = Vector2.new(0.5, 0.5)
		hueKnob.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
		hueKnob.BorderSizePixel = 0
		hueKnob.Position = UDim2.new(hue, 0, 0.5, 0)
		hueKnob.Size = UDim2.fromOffset(hueHeight + 6, hueHeight + 6)
		hueKnob.ZIndex = 25
		hueKnob.Parent = hueStrip

		Util.addCorner(hueKnob, (hueHeight + 6) / 2)
		Util.addStroke(hueKnob, Color3.fromRGB(255, 255, 255), 1.6)

		--// Hex field ----------------------------------------------------
		local hexBox = Instance.new("TextBox")

		hexBox.Name = "Hex"
		hexBox.BackgroundColor3 = theme.Colors.Element
		hexBox.BorderSizePixel = 0
		hexBox.ClearTextOnFocus = false
		hexBox.Position = UDim2.fromOffset(0, areaHeight + gap + hueHeight + gap)
		hexBox.Size = UDim2.fromOffset(pickerSize, hexHeight)
		hexBox.Text = Util.colorToHex(self.Value)
		hexBox.TextColor3 = theme.Colors.Text
		hexBox.TextSize = theme.Metrics.Element.FieldTextSize
		hexBox.TextXAlignment = Enum.TextXAlignment.Left
		hexBox.ZIndex = 22
		hexBox.Parent = parent

		Util.addCorner(hexBox, 4)
		Util.addPadding(hexBox, 8, 8, 0, 0)
		Util.addStroke(hexBox, theme.Colors.ElementBorder, 1)
		Util.setFont(hexBox, theme.Fonts.Mono)

		local function commit(color: Color3, fromHex: boolean?)
			if not fromHex then
				hexBox.Text = Util.colorToHex(color)
			end

			self:SetValue(color)
		end

		local function updateMarker()
			local newHue, newSaturation, newValue = currentHsv()

			marker.Position = UDim2.new(newSaturation, 0, 1 - newValue, 0)
			area.BackgroundColor3 = Color3.fromHSV(newHue, 1, 1)
			hueKnob.Position = UDim2.new(newHue, 0, 0.5, 0)
			hueKnob.BackgroundColor3 = Color3.fromHSV(newHue, 1, 1)
		end

		self._updatePopupMarker = updateMarker

		area.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			local hueNow = currentHsv()

			beginDrag(area, function(relativeX, relativeY)
				commit(Color3.fromHSV(hueNow, relativeX, 1 - relativeY))
			end)

			commit(Color3.fromHSV(
				hueNow,
				Util.clamp((input.Position.X - area.AbsolutePosition.X) / math.max(area.AbsoluteSize.X, 1), 0, 1),
				Util.clamp(1 - (input.Position.Y - area.AbsolutePosition.Y) / math.max(area.AbsoluteSize.Y, 1), 0, 1)
			))
		end)

		hueStrip.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			local _, saturationNow, valueNow = currentHsv()

			beginDrag(hueStrip, function(relativeX)
				commit(Color3.fromHSV(relativeX, saturationNow, valueNow))
			end)

			commit(Color3.fromHSV(
				Util.clamp((input.Position.X - hueStrip.AbsolutePosition.X) / math.max(hueStrip.AbsoluteSize.X, 1), 0, 1),
				saturationNow,
				valueNow
			))
		end)

		hexBox.FocusLost:Connect(function()
			local parsed = Util.hexToColor(hexBox.Text)

			if parsed == nil then
				hexBox.Text = Util.colorToHex(self.Value)

				return
			end

			commit(parsed)
		end)

		return areaHeight + gap + hueHeight + gap + hexHeight
	end

	function self.Open()
		if self._open or self:IsDisabled() then
			return
		end

		self._open = true
		self:Refresh()

		local contentWidth = theme.Metrics.Popup.ColorPickerSize

		self._popup = self.Window:_createPopup({
			Name = "ColorPicker",
			Anchor = swatch,
			Width = contentWidth + theme.Metrics.Popup.Padding * 2,
			Padding = theme.Metrics.Popup.Padding,
			Content = buildContent,
			OnClose = function()
				self._open = false
				self._popup = nil
				self._updatePopupMarker = nil
				stopDragging()
				self:Refresh()
			end,
		})
	end

	function self.Close()
		if self._popup ~= nil then
			self._popup:Close()
		end
	end

	--// Public API -------------------------------------------------------
	function self.SetValue(value: any, fireCallback: boolean?)
		local color = typeof(value) == "Color3" and value or Util.hexToColor(tostring(value)) or self.Value

		self._hue = select(1, Color3.toHSV(color))

		Element.SetValue(self, color, fireCallback)

		if self._updatePopupMarker ~= nil then
			self._updatePopupMarker()
		end

		if self._popup ~= nil then
			local hexBox = self._popup.Inner:FindFirstChild("Hex")

			if hexBox ~= nil then
				hexBox.Text = Util.colorToHex(color)
			end
		end
	end

	function self.GetHex(): string
		return Util.colorToHex(self.Value)
	end

	--// Interaction -------------------------------------------------------
	self:Connect(swatch.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		if self._open then
			self:Close()
		else
			self:Open()
		end
	end)

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return ColorPicker
end

__modules["src/Elements/Divider"] = function()
--!strict
--[[
	MidnightUI · Divider
	------------------------------------------------------------------
	Hairline separator between groups of elements. With
	`Invisible = true` it becomes pure vertical spacing (used by
	`Section:Gap`).
]]

local Util = __req("src/Util")

local Element = __req("src/Element")

local Divider = setmetatable({}, { __index = Element })
Divider.__index = Divider
Divider.Name = "Divider"

export type Props = {
	Height: number?,
	Invisible: boolean?,
	Color: string?,
	Visible: boolean?,
	Order: number?,
	Transparency: number?,
}

function Divider.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element
	local invisible = options.Invisible == true

	local self: any = Element.new({
		Class = Divider,
		Default = false,
		Visible = options.Visible,
		Order = options.Order,
	})

	self.Height = options.Height or metrics.DividerHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)
	self.Invisible = invisible
	self.ColorKey = options.Color or "Divider"
	self.Transparency = options.Transparency or 0

	local line = nil

	if not invisible then
		line = Instance.new("Frame")

		line.Name = "Line"
		line.AnchorPoint = Vector2.new(0, 0.5)
		line.BackgroundColor3 = theme.Colors[self.ColorKey]
		line.BackgroundTransparency = self.Transparency
		line.BorderSizePixel = 0
		line.Position = UDim2.new(0, 0, 0.5, 0)
		line.Size = UDim2.new(1, 0, 0, 1)

		if self.Height <= 1 then
			line.Size = UDim2.new(1, 0, 1, 0)
			line.Position = UDim2.fromScale(0, 0)
			line.AnchorPoint = Vector2.new(0, 0)
		end

		line.ZIndex = 2
		line.Parent = self.Instance

		self.Line = line
	end

	function self.Refresh()
		if line == nil then
			return
		end

		line.BackgroundColor3 = theme.Colors[self.ColorKey] or theme.Colors.Divider
		line.BackgroundTransparency = if self:IsDisabled() then 1 else self.Transparency
	end

	function self.OnThemeChanged()
		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	self:Refresh()

	return self
end

return Divider
end

__modules["src/Elements/Dropdown"] = function()
--!strict
--[[
	MidnightUI · Dropdown
	------------------------------------------------------------------
	Closed state matches the screenshots: a label above, then a flat
	dark input box showing the current selection (no arrow unless
	`Arrow = true` is requested).

	Open state is rendered in the window's overlay through the Popup
	system, so it is never clipped by the page's ScrollingFrame and it
	stays glued to the box while the page scrolls.

	Supports single select, multi select, search and custom display.
]]

local Util = __req("src/Util")

local Icon = __req("src/Icon")

local Element = __req("src/Element")

local Dropdown = setmetatable({}, { __index = Element })
Dropdown.__index = Dropdown
Dropdown.Name = "Dropdown"

export type Props = {
	Title: string?,
	Options: { string }?,
	Default: (string | { string })?,
	Multi: boolean?,
	Search: boolean?,
	Arrow: boolean?,
	MaxHeight: number?,
	Placeholder: string?,
	Flag: string?,
	Callback: ((value: any) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Display: ((selection: any, options: { string }) -> string)?,
	Order: number?,
}

function Dropdown.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element
	local popupMetrics = theme.Metrics.Popup
	local multi = options.Multi == true
	local optionList: { string } = table.clone(options.Options or {})

	local defaultSelection: any

	if multi then
		defaultSelection = type(options.Default) == "table" and table.clone(options.Default) or {}
	else
		defaultSelection = options.Default
	end

	local self: any = Element.new({
		Class = Dropdown,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = defaultSelection,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Options = optionList
	self.Multi = multi
	self.Search = options.Search == true
	self.Arrow = options.Arrow == true
	self.Dim = options.Dim == true
	self.Placeholder = options.Placeholder or "Select…"
	self.MaxHeight = options.MaxHeight or popupMetrics.MaxHeight
	self.Display = options.Display
	self.Height = metrics.FieldHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	self._open = false
	self._popup = nil
	self._query = ""
	self._searchBox = nil
	self._list = nil
	self._hovering = false

	local labelHeight = 15
	local boxHeight = metrics.FieldBoxHeight

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, 0, 0, labelHeight)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Visible = options.Title ~= nil
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Box -----------------------------------------------------------
	local box = Instance.new("Frame")

	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0, 1)
	box.BackgroundColor3 = theme.Colors.Element
	box.BorderSizePixel = 0
	box.Position = UDim2.new(0, 0, 1, 0)
	box.Size = UDim2.new(1, 0, 0, boxHeight)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, metrics.FieldRadius)

	local boxStroke = Util.addStroke(box, theme.Colors.ElementBorder, 1)

	local valueText = Instance.new("TextLabel")

	valueText.Name = "Value"
	valueText.BackgroundTransparency = 1
	valueText.Position = UDim2.fromOffset(metrics.FieldPadding, 0)
	valueText.Size = UDim2.new(1, -(metrics.FieldPadding * 2 + (self.Arrow and 18 or 0)), 1, 0)
	valueText.Text = ""
	valueText.TextColor3 = theme.Colors.Text
	valueText.TextSize = metrics.FieldTextSize
	valueText.TextXAlignment = Enum.TextXAlignment.Left
	valueText.TextYAlignment = Enum.TextYAlignment.Center
	valueText.TextTruncate = Enum.TextTruncate.AtEnd
	valueText.ZIndex = 3
	valueText.Parent = box

	Util.setFont(valueText, theme.Fonts.Text)

	local arrow = nil

	if self.Arrow then
		arrow = Icon.create("chevronDown", {
			Size = 13,
			Color = theme.Colors.TextMuted,
			Parent = box,
			Position = UDim2.new(1, -(metrics.FieldPadding + 13), 0.5, -6.5),
			Name = "Arrow",
			ZIndex = 3,
		})
	end

	self.Box = box
	self.ValueText = valueText
	self.Label = label

	--// Selection helpers ---------------------------------------------
	local function normalize(selection: any): any
		if multi then
			if type(selection) ~= "table" then
				return {}
			end

			local copy = {}

			for _, entry in selection do
				local text = tostring(entry)

				if table.find(optionList, text) ~= nil and table.find(copy, text) == nil then
					table.insert(copy, text)
				end
			end

			return copy
		end

		if selection == nil then
			return nil
		end

		if type(selection) ~= "string" and type(selection) ~= "number" then
			return nil
		end

		return tostring(selection)
	end

	local function isSelected(option: string): boolean
		if multi then
			return table.find(self.Value, option) ~= nil
		end

		return self.Value == option
	end

	local function formatSelection(selection: any): string
		if self.Display ~= nil then
			local ok, text = pcall(self.Display, selection, optionList)

			if ok and type(text) == "string" then
				return text
			end
		end

		if multi then
			if #selection == 0 then
				return self.Placeholder
			end

			if #selection <= 3 then
				return table.concat(selection, ", ")
			end

			return ("%s (+%d)"):format(table.concat(selection, ", ", 1, 3), #selection - 3)
		end

		if selection == nil then
			return self.Placeholder
		end

		return tostring(selection)
	end

	--// Visual refresh -------------------------------------------------
	function self.Refresh()
		local selection = self.Value
		local isEmpty = (multi and #selection == 0) or (not multi and selection == nil)
		local disabled = self:IsDisabled()

		valueText.Text = formatSelection(selection)
		valueText.TextColor3 = if disabled
			then theme.Colors.TextDisabled
			elseif isEmpty then theme.Colors.TextMuted
			elseif self.Dim == true then theme.Colors.TextDim
			else theme.Colors.Text

		local dim = self.Dim == true
		local baseColor = if dim then theme.Colors.ElementDim else theme.Colors.Element

		box.BackgroundColor3 = if disabled
			then baseColor
			elseif self._open then theme.Colors.ElementActive
			elseif self._hovering then (if dim then theme.Colors.ElementDimBorder else theme.Colors.ElementHover)
			else baseColor

		boxStroke.Color = if self._open or self._hovering
			then theme.Colors.Accent
			else (if dim then theme.Colors.ElementDimBorder else theme.Colors.ElementBorder)
		boxStroke.Transparency = if disabled then 0.5 else 0

		label.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text

		if arrow ~= nil then
			Icon.setColor(arrow, if self._open then theme.Colors.Accent else theme.Colors.TextMuted)
		end
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false
		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(valueText, theme.Fonts.Text)
		self:Refresh()
	end

	--// Content --------------------------------------------------------
	local function buildList(parent: Frame): number
		if self._list ~= nil then
			self._list:Destroy()
			self._list = nil
		end

		local itemHeight = popupMetrics.ItemHeight
		local visible: { string } = {}

		for _, option in optionList do
			if self._query == "" or option:lower():find(self._query:lower(), 1, true) then
				table.insert(visible, option)
			end
		end

		local totalHeight = #visible * itemHeight
		local listHeight = math.min(math.max(totalHeight, itemHeight), self.MaxHeight)

		local list = Instance.new("ScrollingFrame")

		list.Name = "Options"
		list.BackgroundTransparency = 1
		list.BorderSizePixel = 0
		list.CanvasSize = UDim2.fromOffset(0, totalHeight)
		list.ScrollBarImageColor3 = theme.Colors.Scrollbar
		list.ScrollBarThickness = theme.Metrics.Scrollbar.Thickness
		list.ScrollingDirection = Enum.ScrollingDirection.Y
		list.Size = UDim2.new(1, 0, 0, listHeight)
		list.ZIndex = 22
		list.Parent = parent

		Util.addList(list, {
			Padding = 0,
			Direction = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
		})

		for index, option in visible do
			local selectedNow = isSelected(option)

			local item = Instance.new("TextButton")

			item.Name = option
			item.AutoButtonColor = false
			item.BackgroundTransparency = 1
			item.BorderSizePixel = 0
			item.LayoutOrder = index
			item.Size = UDim2.new(1, 0, 0, itemHeight)
			item.Text = ""
			item.ZIndex = 23
			item.Parent = list

			Util.addCorner(item, 4)

			local itemLabel = Instance.new("TextLabel")

			itemLabel.Name = "Label"
			itemLabel.BackgroundTransparency = 1
			itemLabel.Position = UDim2.fromOffset(8, 0)
			itemLabel.Size = UDim2.new(1, -30, 1, 0)
			itemLabel.Text = option
			itemLabel.TextColor3 = if selectedNow then theme.Colors.Accent else theme.Colors.Text
			itemLabel.TextSize = popupMetrics.ItemTextSize
			itemLabel.TextXAlignment = Enum.TextXAlignment.Left
			itemLabel.TextYAlignment = Enum.TextYAlignment.Center
			itemLabel.TextTruncate = Enum.TextTruncate.AtEnd
			itemLabel.ZIndex = 24
			itemLabel.Parent = item

			Util.setFont(itemLabel, if selectedNow then theme.Fonts.Bold else theme.Fonts.Text)

			if selectedNow then
				Icon.create("check", {
					Size = 12,
					Color = theme.Colors.Accent,
					Parent = item,
					Position = UDim2.new(1, -18, 0.5, -6),
					Name = "Check",
					ZIndex = 24,
				})
			end

			item.MouseEnter:Connect(function()
				item.BackgroundColor3 = theme.Colors.PopupHover
				item.BackgroundTransparency = 0
			end)

			item.MouseLeave:Connect(function()
				item.BackgroundTransparency = 1
			end)

			item.MouseButton1Click:Connect(function()
				local chosen = option

				if multi then
					local selection = table.clone(self.Value)
					local position = table.find(selection, chosen)

					if position ~= nil then
						table.remove(selection, position)
					else
						table.insert(selection, chosen)
					end

					self:SetValue(selection)

					if self._popup ~= nil then
						self._popup:Refresh()
					end
				else
					self:SetValue(chosen)
					self:Close()
				end
			end)
		end

		if #visible == 0 then
			local empty = Instance.new("TextLabel")

			empty.Name = "Empty"
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, itemHeight)
			empty.Text = "Nothing found"
			empty.TextColor3 = theme.Colors.TextMuted
			empty.TextSize = popupMetrics.ItemTextSize
			empty.TextXAlignment = Enum.TextXAlignment.Center
			empty.ZIndex = 24
			empty.Parent = list

			Util.setFont(empty, theme.Fonts.Small)
		end

		self._list = list

		return listHeight
	end

	local function buildContent(parent: Frame): number
		local height = 0

		if self.Search and self._searchBox == nil then
			local search = Instance.new("TextBox")

			search.Name = "Search"
			search.BackgroundColor3 = theme.Colors.Element
			search.BorderSizePixel = 0
			search.ClearTextOnFocus = false
			search.PlaceholderText = "Search…"
			search.PlaceholderColor3 = theme.Colors.TextMuted
			search.Position = UDim2.fromOffset(0, 0)
			search.Size = UDim2.new(1, 0, 0, popupMetrics.SearchHeight)
			search.Text = self._query
			search.TextColor3 = theme.Colors.Text
			search.TextSize = popupMetrics.ItemTextSize
			search.TextXAlignment = Enum.TextXAlignment.Left
			search.ZIndex = 22
			search.Parent = parent

			Util.addCorner(search, 4)
			Util.addPadding(search, 8, 8, 0, 0)
			Util.addStroke(search, theme.Colors.ElementBorder, 1)
			Util.setFont(search, theme.Fonts.Text)

			search:GetPropertyChangedSignal("Text"):Connect(function()
				if search.Text == self._query then
					return
				end

				self._query = search.Text

				if self._popup ~= nil then
					self._popup:Refresh()
				end
			end)

			self._searchBox = search

			task.defer(function()
				if search.Parent ~= nil then
					search:CaptureFocus()
				end
			end)
		elseif self._searchBox ~= nil and self._searchBox.Parent ~= parent then
			self._searchBox.Parent = parent
		end

		if self.Search and self._searchBox ~= nil then
			self._searchBox.Size = UDim2.new(1, 0, 0, popupMetrics.SearchHeight)

			height += popupMetrics.SearchHeight + 6
		end

		if self._holder ~= nil then
			self._holder:Destroy()
			self._holder = nil
		end

		local holder = Instance.new("Frame")

		holder.Name = "ListHolder"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Position = UDim2.fromOffset(0, height)
		holder.Size = UDim2.new(1, 0, 0, 0)
		holder.ZIndex = 22
		holder.Parent = parent

		local listHeight = buildList(holder)

		holder.Size = UDim2.new(1, 0, 0, listHeight)
		self._holder = holder

		return height + listHeight
	end

	--// Open / close ----------------------------------------------------
	function self.Open()
		if self._open or self:IsDisabled() then
			return
		end

		self._open = true
		self._query = ""
		self._searchBox = nil
		self._list = nil

		self:Refresh()

		self._popup = self.Window:_createPopup({
			Name = "Dropdown",
			Anchor = box,
			Width = box.AbsoluteSize.X,
			Rebuild = false,
			Content = buildContent,
			OnClose = function()
				self._open = false
				self._popup = nil
				self._query = ""
				self._searchBox = nil
				self._list = nil
				self:Refresh()
			end,
		})
	end

	function self.Close()
		if self._popup ~= nil then
			self._popup:Close()
		end
	end

	--// Public API -------------------------------------------------------
	function self.SetOptions(newOptions: { string })
		optionList = table.clone(newOptions)
		self.Options = optionList

		self:SetValue(normalize(self.Value))
		self:Refresh()
	end

	function self.GetOptions(): { string }
		return table.clone(optionList)
	end

	function self.SetValue(value: any, fireCallback: boolean?)
		Element.SetValue(self, normalize(value), fireCallback)
	end

	--// Interaction ------------------------------------------------------
	self:Connect(box.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		if self._open then
			self:Close()
		else
			self:Open()
		end
	end)

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Dropdown
end

__modules["src/Elements/Keybind"] = function()
--!strict
--[[
	MidnightUI · Keybind
	------------------------------------------------------------------
	`Label ........................ ( E )` — a circular badge on the
	right that shows the bound key (see the "Type ●" row on the
	screenshots).

	Click the badge to start listening: the badge pulses until a key
	(or a mouse button) is pressed. Escape cancels the capture.
]]

local UserInputService = game:GetService("UserInputService")

local Util = __req("src/Util")

local Element = __req("src/Element")

local Keybind = setmetatable({}, { __index = Element })
Keybind.__index = Keybind
Keybind.Name = "Keybind"

export type Props = {
	Title: string?,
	Default: (string | EnumItem)?,
	Mode: ("Press" | "Hold")?,
	Flag: string?,
	Callback: ((key: string?) -> ())?,
	OnPress: ((pressed: boolean) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

--- Compact labels so keys fit inside the 20px badge.
local SHORT_NAMES: { [string]: string } = {
	Space = "SPC",
	LeftControl = "LCT",
	RightControl = "RCT",
	LeftShift = "LSH",
	RightShift = "RSH",
	LeftAlt = "LAL",
	RightAlt = "RAL",
	Backspace = "BKS",
	Return = "ENT",
	Escape = "ESC",
	Tab = "TAB",
	CapsLock = "CAP",
	Delete = "DEL",
	Insert = "INS",
	PageUp = "PGU",
	PageDown = "PGD",
	Home = "HOM",
	["End"] = "END",
	MouseButton1 = "M1",
	MouseButton2 = "M2",
	MouseButton3 = "M3",
	MouseWheel = "M4",
	Up = "UP",
	Down = "DN",
	Left = "LF",
	Right = "RT",
}

local function toKeyName(value: any): string?
	if value == nil then
		return nil
	end

	if typeof(value) == "EnumItem" then
		return value.Name
	end

	if type(value) == "string" then
		if value == "" then
			return nil
		end

		return value
	end

	return nil
end

local function shortLabel(key: string?): string
	if key == nil then
		return ""
	end

	local mapped = SHORT_NAMES[key]

	if mapped ~= nil then
		return mapped
	end

	if #key <= 3 then
		return key:upper()
	end

	return key:sub(1, 3):upper()
end

local function inputToKeyName(input: InputObject): string?
	if input.KeyCode ~= Enum.KeyCode.Unknown then
		return input.KeyCode.Name
	end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseButton1 then
		return "MouseButton1"
	elseif inputType == Enum.UserInputType.MouseButton2 then
		return "MouseButton2"
	elseif inputType == Enum.UserInputType.MouseButton3 then
		return "MouseButton3"
	elseif inputType == Enum.UserInputType.MouseWheel then
		return "MouseWheel"
	end

	return nil
end

function Keybind.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Keybind,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = toKeyName(options.Default),
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Mode = options.Mode or "Press"
	self.Height = math.max(metrics.KeybindHeight, metrics.KeybindBadge)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	self._capturing = false
	self._pressed = false
	self._hovering = false

	local badgeSize = metrics.KeybindBadge

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, -(badgeSize + metrics.Gap), 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Badge ---------------------------------------------------------
	local badge = Instance.new("Frame")

	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.BackgroundColor3 = theme.Colors.Element
	badge.BorderSizePixel = 0
	badge.Position = UDim2.new(1, 0, 0.5, 0)
	badge.Size = UDim2.fromOffset(badgeSize, badgeSize)
	badge.ZIndex = 2
	badge.Parent = self.Instance

	Util.addCorner(badge, badgeSize / 2)

	local badgeStroke = Util.addStroke(badge, theme.Colors.ElementBorder, 1)

	local badgeText = Instance.new("TextLabel")

	badgeText.Name = "Key"
	badgeText.BackgroundTransparency = 1
	badgeText.Size = UDim2.new(1, -4, 1, 0)
	badgeText.Position = UDim2.fromOffset(2, 0)
	badgeText.Text = ""
	badgeText.TextColor3 = theme.Colors.Text
	badgeText.TextScaled = true
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	badgeText.TextYAlignment = Enum.TextYAlignment.Center
	badgeText.ZIndex = 3
	badgeText.Parent = badge

	Util.setFont(badgeText, theme.Fonts.Mono)

	local badgeScale = Instance.new("UIScale")

	badgeScale.Parent = badge

	self.Badge = badge
	self.BadgeText = badgeText
	self.Label = label
	self._badgeScale = badgeScale

	--// Visual state ----------------------------------------------------
	function self.Refresh()
		local key = self.Value
		local disabled = self:IsDisabled()

		badgeText.Text = if self._capturing then "…" else shortLabel(key)

		if disabled then
			badge.BackgroundColor3 = theme.Colors.Element
			badgeStroke.Color = theme.Colors.ElementBorder
			badgeStroke.Transparency = 0.5
			badgeText.TextColor3 = theme.Colors.TextDisabled
			label.TextColor3 = theme.Colors.TextDisabled

			return
		end

		local active = self._capturing or self._pressed or self._hovering

		badge.BackgroundColor3 = if active then theme.Colors.ElementActive else theme.Colors.Element
		badgeStroke.Color = if active then theme.Colors.Accent else theme.Colors.ElementBorder
		badgeStroke.Transparency = if self._pressed then 0 else 0.15
		badgeText.TextColor3 = if active and key ~= nil or self._capturing
			then theme.Colors.Accent
			else theme.Colors.TextDim
		label.TextColor3 = theme.Colors.Text
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		Util.tween(badgeScale, { Scale = 1.1 }, theme, { Duration = theme.Animation.Fast })
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false

		Util.tween(badgeScale, { Scale = 1 }, theme, { Duration = theme.Animation.Fast })
		self:Refresh()
	end

	function self.DisabledChanged()
		if self:IsDisabled() then
			self:CancelCapture()
		end

		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(badgeText, theme.Fonts.Mono)
		self:Refresh()
	end

	--// Capture --------------------------------------------------------
	local captureConnection = nil

	local function stopCaptureTween()
		Util.tween(badgeStroke, { Transparency = 0.15 }, theme, { Duration = theme.Animation.Instant })
	end

	function self.CancelCapture()
		if not self._capturing then
			return
		end

		self._capturing = false

		if captureConnection ~= nil then
			captureConnection:Disconnect()
			captureConnection = nil
		end

		stopCaptureTween()
		self:Refresh()
	end

	function self.StartCapture()
		if self._capturing or self:IsDisabled() then
			return
		end

		self._capturing = true

		Util.tween(badgeStroke, { Transparency = 0.7 }, theme, {
			Duration = 0.45,
			Reverses = true,
			RepeatCount = -1,
		})

		self:Refresh()

		captureConnection = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
			if gameProcessed then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseMovement then
				return
			end

			if input.KeyCode == Enum.KeyCode.Escape then
				self:CancelCapture()

				return
			end

			local key = inputToKeyName(input)

			if key == nil then
				return
			end

			self:CancelCapture()
			self:SetValue(key)
		end)
	end

	--// Press handling ---------------------------------------------------
	self:Connect(UserInputService.InputBegan, function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or self:IsDisabled() or self._capturing or self.Value == nil then
			return
		end

		if inputToKeyName(input) ~= self.Value then
			return
		end

		self._pressed = true
		self:Refresh()

		Util.tween(badgeScale, { Scale = 0.9 }, theme, {
			Duration = theme.Animation.Instant,
			Reverses = true,
		})

		if options.OnPress ~= nil then
			local ok, err = pcall(options.OnPress, true)

			if not ok then
				warn(("[MidnightUI] Keybind OnPress errored: %s"):format(tostring(err)))
			end
		end
	end)

	self:Connect(UserInputService.InputEnded, function(input: InputObject)
		if not self._pressed or self:IsDisabled() then
			return
		end

		if inputToKeyName(input) ~= self.Value then
			return
		end

		self._pressed = false
		self:Refresh()

		if self.Mode == "Hold" and options.OnPress ~= nil then
			local ok, err = pcall(options.OnPress, false)

			if not ok then
				warn(("[MidnightUI] Keybind OnPress errored: %s"):format(tostring(err)))
			end
		end
	end)

	--// Interaction -------------------------------------------------------
	self:Connect(badge.InputBegan, function(input: InputObject)
		if self:IsDisabled() or self._capturing then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		self:StartCapture()
	end)

	self:Connect(self.Instance.InputBegan, function(input: InputObject)
		if self:IsDisabled() or self._capturing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			self:SetValue(nil)
		end
	end)

	--// Public API ---------------------------------------------------------
	function self.IsPressed(): boolean
		return self._pressed
	end

	function self.IsCapturing(): boolean
		return self._capturing
	end

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Keybind
end

__modules["src/Elements/Label"] = function()
--!strict
--[[
	MidnightUI · Label
	------------------------------------------------------------------
	Non-interactive text row. Use it for hints, section captions and
	paragraphs (`Wrapped = true`).

	Wrapped labels need an explicit `Height` because the library uses
	deterministic height accounting instead of reading back layout.
]]

local Util = __req("src/Util")

local Element = __req("src/Element")

local Label = setmetatable({}, { __index = Element })
Label.__index = Label
Label.Name = "Label"

export type Props = {
	Text: string?,
	Title: string?,
	Height: number?,
	TextSize: number?,
	Color: string?,
	Align: ("Left" | "Center" | "Right")?,
	Wrapped: boolean?,
	Bold: boolean?,
	Indent: number?,
	Dim: boolean?,
	Visible: boolean?,
	Order: number?,
}

function Label.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element
	local text = options.Text or options.Title or ""
	local wrapped = options.Wrapped == true

	local self: any = Element.new({
		Class = Label,
		Title = options.Title,
		Default = text,
		Visible = options.Visible,
		Order = options.Order,
	})

	self.Height = options.Height or (wrapped and 36 or metrics.LabelHeight)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local label = Instance.new("TextLabel")

	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(options.Indent or 0, 0)
	label.Size = UDim2.new(1, -(options.Indent or 0), 1, 0)
	label.Text = text
	label.TextColor3 = theme.Colors.TextDim
	label.TextSize = options.TextSize or metrics.TextSize
	label.TextWrapped = wrapped
	label.TextYAlignment = if wrapped then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center
	label.TextXAlignment = if options.Align == "Center"
		then Enum.TextXAlignment.Center
		elseif options.Align == "Right" then Enum.TextXAlignment.Right
		else Enum.TextXAlignment.Left

	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, if options.Bold == true then theme.Fonts.Bold else theme.Fonts.Small)

	self.Label = label
	self.ColorKey = options.Color or (if options.Dim == true then "TextMuted" else "TextDim")

	function self.Refresh()
		local color = theme.Colors[self.ColorKey] or theme.Colors.TextDim
		local disabled = self:IsDisabled()

		label.TextColor3 = if disabled then theme.Colors.TextDisabled else color
	end

	function self.OnThemeChanged()
		Util.setFont(label, if options.Bold == true then theme.Fonts.Bold else theme.Fonts.Small)
		label.TextSize = options.TextSize or metrics.TextSize

		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	--// Public API -------------------------------------------------------
	function self.SetText(value: string)
		self.Value = value
		label.Text = value
	end

	function self.GetText(): string
		return label.Text
	end

	function self.SetColor(colorKey: string)
		self.ColorKey = colorKey

		self:Refresh()
	end

	self:Refresh()

	return self
end

return Label
end

__modules["src/Elements/Slider"] = function()
--!strict
--[[
	MidnightUI · Slider
	------------------------------------------------------------------
	`Label .................... value` on one row with a 4px track below
	and a 12px knob — exactly the layout used on the screenshots.

	Interaction
		· click anywhere on the track to jump to that value
		· drag the knob (delta based, so it stays smooth while the page
		  is scrolling)
		· mouse wheel over the element to nudge the value
		· hold Left Shift while dragging for fine control (0.1x)
]]

local UserInputService = game:GetService("UserInputService")

local Util = __req("src/Util")

local Element = __req("src/Element")

local Slider = setmetatable({}, { __index = Element })
Slider.__index = Slider
Slider.Name = "Slider"

export type Props = {
	Title: string?,
	Min: number?,
	Max: number?,
	Default: number?,
	Decimals: number?,
	Step: number?,
	Prefix: string?,
	Suffix: string?,
	ShowValue: boolean?,
	Flag: string?,
	Callback: ((value: number) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

function Slider.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local minimum = options.Min or 0
	local maximum = options.Max or 100

	if maximum < minimum then
		maximum = minimum
	end

	local decimals = options.Decimals

	if decimals == nil then
		if options.Step ~= nil and options.Step > 0 and options.Step < 1 then
			decimals = #tostring(options.Step):match("%.(%d+)") or 0
		else
			decimals = 0
		end
	end

	local defaultValue = Util.clamp(options.Default or minimum, minimum, maximum)

	local self: any = Element.new({
		Class = Slider,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = defaultValue,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Min = minimum
	self.Max = maximum
	self.Decimals = decimals
	self.Step = options.Step
	self.Prefix = options.Prefix or ""
	self.Suffix = options.Suffix or ""
	self.ShowValue = options.ShowValue ~= false
	self.Height = metrics.SliderHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local labelHeight = 15
	local trackHeight = metrics.SliderTrackHeight
	local knobSize = metrics.SliderKnobSize

	--// Row: label + value --------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, -70, 0, labelHeight)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	local valueLabel = Instance.new("TextLabel")

	valueLabel.Name = "Value"
	valueLabel.BackgroundTransparency = 1
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 0)
	valueLabel.Size = UDim2.new(1, -70, 0, labelHeight)
	valueLabel.Text = ""
	valueLabel.TextColor3 = theme.Colors.Text
	valueLabel.TextSize = metrics.TextSize
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.TextYAlignment = Enum.TextYAlignment.Center
	valueLabel.ZIndex = 2
	valueLabel.Parent = self.Instance

	Util.setFont(valueLabel, theme.Fonts.Text)

	--// Track ---------------------------------------------------------
	local trackArea = Instance.new("Frame")

	trackArea.Name = "TrackArea"
	trackArea.BackgroundTransparency = 1
	trackArea.BorderSizePixel = 0
	trackArea.Position = UDim2.fromOffset(0, self.Height - knobSize)
	trackArea.Size = UDim2.new(1, 0, 0, knobSize)
	trackArea.ZIndex = 2
	trackArea.Parent = self.Instance

	local track = Instance.new("Frame")

	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.BackgroundColor3 = theme.Colors.Track
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 0, 0.5, 0)
	track.Size = UDim2.new(1, 0, 0, trackHeight)
	track.ZIndex = 2
	track.Parent = trackArea

	Util.addCorner(track, trackHeight / 2)

	local fill = Instance.new("Frame")

	fill.Name = "Fill"
	fill.AnchorPoint = Vector2.new(0, 0.5)
	fill.BackgroundColor3 = theme.Colors.TrackFill
	fill.BorderSizePixel = 0
	fill.Position = UDim2.new(0, 0, 0.5, 0)
	fill.Size = UDim2.new(0, 0, 0, trackHeight)
	fill.ZIndex = 3
	fill.Parent = trackArea

	Util.addCorner(fill, trackHeight / 2)

	local knob = Instance.new("Frame")

	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = theme.Colors.Knob
	knob.BorderSizePixel = 0
	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.Size = UDim2.fromOffset(knobSize, knobSize)
	knob.ZIndex = 4
	knob.Parent = trackArea

	Util.addCorner(knob, knobSize / 2)

	local knobStroke = Util.addStroke(knob, theme.Colors.ElementBorder, 1)

	local knobScale = Instance.new("UIScale")

	knobScale.Parent = knob

	self.Track = track
	self.Fill = fill
	self.Knob = knob
	self.ValueLabel = valueLabel
	self.Label = label
	self._trackArea = trackArea
	self._knobScale = knobScale
	self._hovering = false
	self._dragging = false
	self._dragConnections = {}

	--// Helpers -------------------------------------------------------
	local function getAlpha(): number
		if maximum == minimum then
			return 0
		end

		return Util.clamp((self.Value - minimum) / (maximum - minimum), 0, 1)
	end

	local function commit(rawValue: number, fireCallback: boolean?)
		local value = Util.clamp(rawValue, minimum, maximum)
		value = Util.snap(value, options.Step, minimum)
		value = Util.clamp(Util.round(value, decimals), minimum, maximum)

		if value == self.Value and fireCallback ~= false then
			return
		end

		self:SetValue(value, fireCallback)
	end

	function self.Refresh()
		local alpha = getAlpha()
		local disabled = self:IsDisabled()

		fill.Size = UDim2.new(alpha, 0, 0, trackHeight)
		knob.Position = UDim2.new(alpha, knobSize / 2 - alpha * knobSize, 0.5, 0)

		valueLabel.Text = self.ShowValue
			and Util.formatValue(self.Value, decimals, self.Prefix, self.Suffix)
			or ""

		fill.BackgroundColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.TrackFill
		knob.BackgroundColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Knob
		knobStroke.Color = self._dragging and theme.Colors.Accent or theme.Colors.ElementBorder
		knobStroke.Transparency = self._dragging and 0 or 0.35

		label.TextColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Text
		valueLabel.TextColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Text
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		if not self:IsDisabled() then
			Util.tween(knobScale, { Scale = 1.15 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end
	end

	function self.OnHoverLeave()
		self._hovering = false

		if not self._dragging then
			Util.tween(knobScale, { Scale = 1 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(valueLabel, theme.Fonts.Text)
		track.BackgroundColor3 = theme.Colors.Track

		self:Refresh()
	end

	--// Interaction ---------------------------------------------------
	local function valueFromInputX(inputX: number): number
		local trackWidth = math.max(self._trackArea.AbsoluteSize.X, 1)
		local relative = (inputX - self.Track.AbsolutePosition.X) / trackWidth

		relative = Util.clamp(relative, 0, 1)

		return minimum + relative * (maximum - minimum)
	end

	local function modifierMultiplier(): number
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			return 0.1
		elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			return 0.01
		end

		return 1
	end

	local function stopDragging()
		for _, connection in self._dragConnections do
			connection:Disconnect()
		end

		table.clear(self._dragConnections)

		self._dragging = false

		Util.tween(knobScale, { Scale = self._hovering and 1.15 or 1 }, theme, {
			Duration = theme.Animation.Fast,
		})

		self:Refresh()
	end

	local function startDragging(input: InputObject)
		self._dragging = true

		Util.tween(knobScale, { Scale = 1.28 }, theme, {
			Duration = theme.Animation.Fast,
			Style = theme.Animation.Easing,
		})

		commit(valueFromInputX(input.Position.X))

		table.insert(
			self._dragConnections,
			UserInputService.InputChanged:Connect(function(changed: InputObject)
				if changed.UserInputType ~= Enum.UserInputType.MouseMovement
					and changed.UserInputType ~= Enum.UserInputType.Touch
				then
					return
				end

				local width = math.max(self._trackArea.AbsoluteSize.X, 1)
				local delta = (maximum - minimum) * (changed.Delta.X / width)

				commit(self.Value + delta * modifierMultiplier())
			end)
		)

		table.insert(
			self._dragConnections,
			UserInputService.InputEnded:Connect(function(ended: InputObject)
				if ended.UserInputType == Enum.UserInputType.MouseButton1
					or ended.UserInputType == Enum.UserInputType.Touch
				then
					stopDragging()
				end
			end)
		)
	end

	self:Connect(trackArea.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			startDragging(input)
		end
	end)

	--// Mouse wheel ---------------------------------------------------
	self:Connect(trackArea.InputChanged, function(input: InputObject)
		if self:IsDisabled() or input.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end

		local increment = options.Step

		if increment == nil or increment <= 0 then
			increment = (maximum - minimum) / 100
		end

		commit(self.Value + increment * input.Position.Z)
	end)

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Slider
end

__modules["src/Elements/Textbox"] = function()
--!strict
--[[
	MidnightUI · Textbox
	------------------------------------------------------------------
	Label above + flat input box, identical to the dropdown's closed
	state. Focus is highlighted with an accent border.

	`Numeric = true` turns the value into a number clamped to
	[Min, Max] and formatted with `Decimals`.
]]

local Util = __req("src/Util")

local Element = __req("src/Element")

local Textbox = setmetatable({}, { __index = Element })
Textbox.__index = Textbox
Textbox.Name = "Textbox"

export type Props = {
	Title: string?,
	Default: (string | number)?,
	Placeholder: string?,
	Numeric: boolean?,
	Min: number?,
	Max: number?,
	Decimals: number?,
	MaxLength: number?,
	Live: boolean?,
	Flag: string?,
	Callback: ((value: any) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

function Textbox.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Textbox,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = options.Default,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Numeric = options.Numeric == true
	self.Min = options.Min or 0
	self.Max = options.Max or 100
	self.Decimals = options.Decimals or 0
	self.Height = metrics.FieldHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local labelHeight = 15
	local boxHeight = metrics.FieldBoxHeight

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, 0, 0, labelHeight)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Visible = options.Title ~= nil
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Box -----------------------------------------------------------
	local box = Instance.new("Frame")

	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0, 1)
	box.BackgroundColor3 = theme.Colors.Element
	box.BorderSizePixel = 0
	box.Position = UDim2.new(0, 0, 1, 0)
	box.Size = UDim2.new(1, 0, 0, boxHeight)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, metrics.FieldRadius)

	local boxStroke = Util.addStroke(box, theme.Colors.ElementBorder, 1)

	local input = Instance.new("TextBox")

	input.Name = "Input"
	input.BackgroundTransparency = 1
	input.ClearTextOnFocus = options.ClearOnFocus == true
	input.MultiLine = false
	input.PlaceholderText = options.Placeholder or ""
	input.PlaceholderColor3 = theme.Colors.TextMuted
	input.Position = UDim2.fromOffset(metrics.FieldPadding, 0)
	input.Size = UDim2.new(1, -metrics.FieldPadding * 2, 1, 0)
	input.Text = options.Default ~= nil and tostring(options.Default) or ""
	input.TextColor3 = theme.Colors.Text
	input.TextSize = metrics.FieldTextSize
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.TextYAlignment = Enum.TextYAlignment.Center
	input.TextEditable = true
	input.ZIndex = 3
	input.Parent = box

	if options.MaxLength ~= nil then
		input.MaxVisibleGraphemes = options.MaxLength
	else
		input.MaxVisibleGraphemes = -1
	end

	Util.setFont(input, theme.Fonts.Text)

	self.Box = box
	self.Input = input
	self.Label = label
	self._focused = false
	self._hovering = false

	--// Helpers --------------------------------------------------------
	local function sanitize(text: string): any
		if not self.Numeric then
			return text
		end

		if text == "" or text == "-" then
			return nil
		end

		local filtered = text:gsub("[^%d%.%-]", "")

		if options.Decimals == 0 or options.Decimals == nil then
			filtered = filtered:gsub("%.", "")
		end

		local number = tonumber(filtered)

		if number == nil then
			return nil
		end

		number = Util.clamp(number, self.Min, self.Max)

		return Util.round(number, self.Decimals)
	end

	local function displayValue(): string
		if self.Value == nil then
			return ""
		end

		if self.Numeric then
			return Util.formatValue(self.Value, self.Decimals, "", "")
		end

		return tostring(self.Value)
	end

	local function commit(fireCallback: boolean?)
		local parsed = sanitize(input.Text)

		if self.Numeric and parsed == nil then
			input.Text = displayValue()

			return
		end

		self:SetValue(self.Numeric and parsed or input.Text, fireCallback)
	end

	-- Make sure numeric defaults are shown with the right precision.
	input.Text = displayValue()

	--// Visual refresh -------------------------------------------------
	function self.Refresh()
		local disabled = self:IsDisabled()

		box.BackgroundColor3 = if disabled
			then theme.Colors.Element
			elseif self._focused then theme.Colors.ElementActive
			elseif self._hovering then theme.Colors.ElementHover
			else theme.Colors.Element

		boxStroke.Color = if self._focused or self._hovering then theme.Colors.Accent else theme.Colors.ElementBorder
		boxStroke.Transparency = if disabled then 0.5 else 0

		input.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text
		input.TextEditable = not disabled
		label.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text
	end

	function self.ValueChanged()
		if not self._focused then
			input.Text = displayValue()
		end

		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false
		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(input, theme.Fonts.Text)
		self:Refresh()
	end

	--// Interaction ----------------------------------------------------
	self:Connect(input.Focused, function()
		self._focused = true
		self:Refresh()
	end)

	self:Connect(input.FocusLost, function()
		self._focused = false

		commit(true)
		self:Refresh()
	end)

	if options.Live == true then
		self:Connect(input:GetPropertyChangedSignal("Text"), function()
			if not self._focused then
				return
			end

			local parsed = sanitize(input.Text)

			if parsed == nil then
				return
			end

			self.Value = parsed
			self:SetValue(parsed, false)
		end)
	end

	self:Connect(box.InputBegan, function(input2: InputObject)
		if self:IsDisabled() then
			return
		end

		if input2.UserInputType ~= Enum.UserInputType.MouseButton1
			and input2.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		if not self._focused then
			input:CaptureFocus()
		end
	end)

	self:AddHover(self.Instance)

	--// Public API ------------------------------------------------------
	function self.GetValue(): any
		return self.Value
	end

	function self.SetValue(value: any, fireCallback: boolean?)
		if self.Numeric then
			local number = tonumber(value)

			if number == nil then
				number = self.Min
			end

			number = Util.clamp(Util.round(number, self.Decimals), self.Min, self.Max)

			Element.SetValue(self, number, fireCallback)
		else
			Element.SetValue(self, value ~= nil and tostring(value) or "", fireCallback)
		end

		if not self._focused then
			input.Text = displayValue()
		end
	end

	function self.Reset()
		self:SetValue(self._defaultValue)
	end

	self:Refresh()

	return self
end

return Textbox
end

__modules["src/Elements/Toggle"] = function()
--!strict
--[[
	MidnightUI · Toggle
	------------------------------------------------------------------
	The square checkbox used for every "Enable" row on the screenshots.

	Visual anatomy
		· 16x16 rounded square (radius 3) with a hairline border
		· check glyph that pops in with a Back ease when turned on
		· label vertically centred on the right of the box
]]

local Icon = __req("src/Icon")
local Signal = __req("src/Signal")
local Util = __req("src/Util")

local Element = __req("src/Element")

local Toggle = setmetatable({}, { __index = Element })
Toggle.__index = Toggle
Toggle.Name = "Toggle"

export type Props = {
	Circle: boolean?,
	Color: Color3?,
	ColorFlag: string?,
	OnColorChanged: ((value: Color3) -> ())?,
	Title: string?,
	Default: boolean?,
	Flag: string?,
	Callback: ((value: boolean) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	BoxSize: number?,
	Ripple: boolean?,
	Order: number?,
}

function Toggle.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Toggle,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = options.Default == true,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	local circle = options.Circle == true
	local boxSize = options.BoxSize or metrics.ToggleSize

	self.Height = math.max(metrics.ToggleHeight, boxSize)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	--// Checkbox ------------------------------------------------------
	local box = Instance.new("Frame")

	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0, 0.5)
	box.BackgroundColor3 = theme.Colors.ToggleOff
	box.BorderSizePixel = 0
	box.Position = UDim2.new(0, 0, 0.5, 0)
	box.Size = UDim2.fromOffset(boxSize, boxSize)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, circle and boxSize / 2 or metrics.ToggleRadius)

	local boxStroke = Util.addStroke(box, theme.Colors.ToggleOffBorder, 1)

	local boxScale = Instance.new("UIScale")

	boxScale.Parent = box

	--// Check glyph ---------------------------------------------------
	local check = Icon.create("check", {
		Size = math.floor(boxSize * 0.66),
		Color = theme.Colors.ToggleCheck,
		Parent = box,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Name = "Check",
		ZIndex = 3,
	})

	local checkScale = Instance.new("UIScale")

	checkScale.Scale = self.Value and 1 or 0
	checkScale.Parent = check

	-- Circle style: a solid dot instead of the tick glyph.
	local dot = nil

	if circle then
		check.Visible = false

		dot = Instance.new("Frame")

		dot.Name = "Dot"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BackgroundColor3 = theme.Colors.ToggleCheck
		dot.BorderSizePixel = 0
		dot.Position = UDim2.fromScale(0.5, 0.5)
		dot.Size = UDim2.fromOffset(math.max(4, math.floor(boxSize * 0.42)), math.max(4, math.floor(boxSize * 0.42)))
		dot.ZIndex = 3
		dot.Parent = box

		Util.addCorner(dot, math.huge)

		local dotScale = Instance.new("UIScale")

		dotScale.Scale = self.Value and 1 or 0
		dotScale.Parent = dot

		self._dotScale = dotScale
		self.Dot = dot
	end

	--// Label ---------------------------------------------------------
	local labelOffset = boxSize + metrics.Gap

	--// Optional colour swatch (checkbox + colour rows from the reference) --
	local swatch = nil
	local swatchSize = 15

	if options.Color ~= nil then
		swatch = Instance.new("Frame")

		swatch.Name = "Swatch"
		swatch.AnchorPoint = Vector2.new(1, 0.5)
		swatch.BackgroundColor3 = options.Color
		swatch.BorderSizePixel = 0
		swatch.Position = UDim2.new(1, 0, 0.5, 0)
		swatch.Size = UDim2.fromOffset(swatchSize, swatchSize)
		swatch.ZIndex = 3
		swatch.Parent = self.Instance

		Util.addCorner(swatch, 4)
		Util.addStroke(swatch, theme.Colors.ElementBorder, 1, 0.25)
	end

	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(labelOffset, 0)
	label.Size = UDim2.new(1, -labelOffset - (swatch ~= nil and (swatchSize + 8) or 0), 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	self.Box = box
	self.Check = check
	self.Label = label
	self.Swatch = swatch
	self.Color = options.Color
	self._open = false
	self._popup = nil

	if swatch ~= nil then
		self.ColorChanged = Signal.new()
	end
	self._boxScale = boxScale
	self._checkScale = checkScale
	self._hovering = false

	--// State painting ------------------------------------------------
	function self.Refresh()
		local value = self.Value == true
		local disabled = self:IsDisabled()

		if disabled then
			box.BackgroundColor3 = theme.Colors.Element
			boxStroke.Color = theme.Colors.ElementBorder
			boxStroke.Transparency = 0.4
			label.TextColor3 = theme.Colors.TextDisabled
			Icon.setColor(check, theme.Colors.TextDisabled)

			return
		end

		if value then
			box.BackgroundColor3 = theme.Colors.ToggleOn
			boxStroke.Color = theme.Colors.ToggleOnBorder
			boxStroke.Transparency = 0
			Icon.setColor(check, theme.Colors.ToggleCheck)
		else
			box.BackgroundColor3 = self._hovering and theme.Colors.ElementActive or theme.Colors.ToggleOff
			boxStroke.Color = self._hovering and theme.Colors.Accent or theme.Colors.ToggleOffBorder
			boxStroke.Transparency = 0
			Icon.setColor(check, theme.Colors.ToggleCheck)
		end

		label.TextColor3 = theme.Colors.Text
	end

	function self.ValueChanged(value: any, animated: boolean?)
		local on = value == true
		local dotScale = self._dotScale

		if animated == false then
			checkScale.Scale = on and 1 or 0

			if dotScale ~= nil then
				dotScale.Scale = on and 1 or 0
			end
		else
			Util.tween(checkScale, { Scale = on and 1 or 0 }, theme, {
				Duration = theme.Animation.Normal,
				Style = on and theme.Animation.EasingBounce or theme.Animation.EasingIn,
			})

			if dotScale ~= nil then
				Util.tween(dotScale, { Scale = on and 1 or 0 }, theme, {
					Duration = theme.Animation.Fast,
				})
			end
		end

		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		if not self:IsDisabled() then
			Util.tween(boxScale, { Scale = 1.08 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end

		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false

		Util.tween(boxScale, { Scale = 1 }, theme, {
			Duration = theme.Animation.Fast,
		})

		self:Refresh()
	end

	function self.DisabledChanged(disabled: boolean)
		if disabled then
			self._hovering = false
		end

		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		label.TextSize = metrics.TitleTextSize
		self:Refresh()
	end

	--// Interaction ---------------------------------------------------
	self:Connect(self.Instance.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		Util.tween(boxScale, { Scale = 0.92 }, theme, {
			Duration = theme.Animation.Instant,
			Reverses = true,
		})

		self:SetValue(not self.Value)
	end)

	--// Colour popup --------------------------------------------------
	local function commitColor(color: Color3)
		self.Color = color
		swatch.BackgroundColor3 = color

		if self.ColorChanged ~= nil then
			self.ColorChanged:Fire(color)
		end

		if options.OnColorChanged ~= nil then
			local ok, err = pcall(options.OnColorChanged, color)

			if not ok then
				warn(("[MidnightUI] OnColorChanged errored: %s"):format(tostring(err)))
			end
		end

		if self.Window ~= nil and options.ColorFlag ~= nil then
			self.Window:_setFlag(options.ColorFlag, color)
		end
	end

	local PALETTE = {
		Color3.fromRGB(255, 255, 255),
		Color3.fromRGB(233, 70, 70),
		Color3.fromRGB(255, 176, 32),
		Color3.fromRGB(255, 235, 59),
		Color3.fromRGB(76, 217, 100),
		Color3.fromRGB(0, 199, 190),
		Color3.fromRGB(47, 128, 237),
		Color3.fromRGB(155, 89, 240),
		Color3.fromRGB(255, 80, 190),
		Color3.fromRGB(120, 128, 140),
		Color3.fromRGB(60, 62, 68),
		Color3.fromRGB(16, 16, 18),
	}

	if swatch ~= nil then
		self._maid:Add(swatch.InputBegan:Connect(function(input: InputObject)
			if self:IsDisabled() then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			if self._open then
				if self._popup ~= nil then
					self._popup:Close()
				end

				return
			end

			self._open = true

			local columns = 6
			local cell = 22
			local gap = 6
			local width = columns * cell + (columns - 1) * gap

			self._popup = self.Window:_createPopup({
				Name = "ColorSwatch",
				Anchor = swatch,
				Width = width,
				Padding = 10,
				OnClose = function()
					self._open = false
					self._popup = nil
				end,
				Content = function(parent: Frame): number
					local grid = Instance.new("Frame")

					grid.Name = "Palette"
					grid.BackgroundTransparency = 1
					grid.BorderSizePixel = 0
					grid.Size = UDim2.new(1, 0, 0, 0)
					grid.ZIndex = 21
					grid.Parent = parent

					Util.addList(grid, {
						Padding = gap,
						Direction = Enum.FillDirection.Horizontal,
						SortOrder = Enum.SortOrder.LayoutOrder,
						Wraps = true,
					})

					local rows = math.ceil(#PALETTE / columns)
					local height = rows * cell + (rows - 1) * gap

					grid.Size = UDim2.new(1, 0, 0, height)

					for index, color in PALETTE do
						local cellButton = Instance.new("TextButton")

						cellButton.Name = "Color" .. tostring(index)
						cellButton.AutoButtonColor = false
						cellButton.BackgroundColor3 = color
						cellButton.BorderSizePixel = 0
						cellButton.LayoutOrder = index
						cellButton.Size = UDim2.fromOffset(cell, cell)
						cellButton.Text = ""
						cellButton.ZIndex = 22
						cellButton.Parent = grid

						Util.addCorner(cellButton, 5)

						cellButton.MouseEnter:Connect(function()
							cellButton.Size = UDim2.fromOffset(cell + 2, cell + 2)
						end)

						cellButton.MouseLeave:Connect(function()
							cellButton.Size = UDim2.fromOffset(cell, cell)
						end)

						cellButton.MouseButton1Click:Connect(function()
							commitColor(color)
						end)
					end

					local hex = Instance.new("TextBox")

					hex.Name = "Hex"
					hex.BackgroundColor3 = self.Theme.Colors.Element
					hex.BorderSizePixel = 0
					hex.ClearTextOnFocus = false
					hex.Position = UDim2.fromOffset(0, height + 10)
					hex.Size = UDim2.new(1, 0, 0, 26)
					hex.Text = Util.colorToHex(self.Color)
					hex.TextColor3 = self.Theme.Colors.Text
					hex.TextSize = self.Theme.Metrics.Element.TextSize
					hex.TextXAlignment = Enum.TextXAlignment.Center
					hex.ZIndex = 22
					hex.Parent = parent

					Util.addCorner(hex, 5)

					hex.FocusLost:Connect(function()
						local parsed = Util.hexToColor(hex.Text)

						if parsed == nil then
							hex.Text = Util.colorToHex(self.Color)

							return
						end

						commitColor(parsed)
					end)

					return height + 10 + 26
				end,
			})
		end))
	end

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

--- Sets the swatch colour (no-op when the toggle has no swatch).
function Toggle.SetColor(self: any, color: Color3)
	if self.Swatch == nil then
		return
	end

	self.Color = color
	self.Swatch.BackgroundColor3 = color

	if self.ColorChanged ~= nil then
		self.ColorChanged:Fire(color)
	end
end

function Toggle.GetColor(self: any): Color3?
	return self.Color
end

return Toggle
end

__modules["src/Hud"] = function()
--!strict
--[[
	MidnightUI · Hud
	------------------------------------------------------------------
	The small floating panel from the reference: a rounded dark card with
	an icon and an uppercase title, sitting in a corner of the screen
