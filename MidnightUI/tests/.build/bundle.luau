	self.Title.TextColor3 = theme.Colors.Text
	Util.setFont(self.Title, theme.Fonts.Panel)

	self:_render()
end

function Hud.Destroy(self: Hud)
	if self._destroyed then
		return
	end

	self._destroyed = true

	self._maid:Clean()
	self._maid:Destroy()

	if self.Root ~= nil then
		self.Root:Destroy()
	end
end

return Hud
end

