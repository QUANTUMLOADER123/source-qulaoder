--// Renderer ---------------------------------------------------------

export type IconOptions = {
	Size: number?,
	Color: Color3?,
	Transparency: number?,
	Parent: Instance?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Name: string?,
	ZIndex: number?,
}

local function isImage(value: string): boolean
	return value:match("^rbxassetid://") ~= nil
		or value:match("^rbxasset://") ~= nil
		or value:match("^http") ~= nil
		or value:match("^rbxthumb://") ~= nil
end

local function resolveName(name: string): string
	local alias = ALIASES[name]

	return alias or name
end

--- Applies a color to an icon built by `Icon.create`.
function Icon.setColor(icon: GuiObject, color: Color3, transparency: number?)
	local alpha = transparency or 0
	local target = icon :: any

	if target:IsA("ImageLabel") then
		target.ImageColor3 = color
		target.ImageTransparency = alpha

		return
	end

	for _, child in icon:GetChildren() do
		local shape = child :: any

		if shape:IsA("Frame") or shape:IsA("ImageLabel") then
			local stroke = Util.findClass(shape, "UIStroke")

			if stroke ~= nil then
				stroke.Color = color
				stroke.Transparency = alpha
			end

			if shape:IsA("Frame") and shape.BackgroundTransparency < 1 then
				shape.BackgroundColor3 = color
				shape.BackgroundTransparency = alpha
			end
		end
	end
end

--- Creates an icon. Returns the container (Frame or ImageLabel).
function Icon.create(name: string, options: IconOptions?): any
	local opts = options or {}
	local size = opts.Size or 16
	local color = opts.Color or Color3.fromRGB(255, 255, 255)
	local transparency = opts.Transparency or 0
	local scale = size / GRID

	if isImage(name) then
		local image = Instance.new("ImageLabel")

		image.Name = opts.Name or "Icon"
		image:SetAttribute("MidnightIcon", name)
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.Image = name
		image.ImageColor3 = color
		image.ImageTransparency = transparency
		image.ScaleType = Enum.ScaleType.Fit
		image.Size = UDim2.fromOffset(size, size)
		image.Position = opts.Position or UDim2.fromOffset(0, 0)
		image.AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0)
		image.ZIndex = opts.ZIndex or 1

		if opts.Parent then
			image.Parent = opts.Parent
		end

		return image
	end

	local container = Instance.new("Frame")

	container.Name = opts.Name or "Icon"
	container:SetAttribute("MidnightIcon", resolveName(name))
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.fromOffset(size, size)
	container.Position = opts.Position or UDim2.fromOffset(0, 0)
	container.AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0)
	container.ZIndex = opts.ZIndex or 1

	local shapes = ICONS[resolveName(name)]

	if shapes == nil then
		warn(("[MidnightUI] Unknown icon %q — rendering a placeholder"):format(name))

		shapes = {
			{ "circle", 5, 5, 10, 10 },
		}
	end

	for _, shape in shapes do
		local kind = shape[1]

		if kind == "line" then
			local x1, y1, x2, y2 = shape[2], shape[3], shape[4], shape[5]
			local thickness = math.max(1, Util.round((shape[6] or 1.4) * scale))
			local dx, dy = x2 - x1, y2 - y1
			local length = math.sqrt(dx * dx + dy * dy) * scale

			local line = Instance.new("Frame")
			line.Name = "Line"
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BackgroundColor3 = color
			line.BackgroundTransparency = transparency
			line.BorderSizePixel = 0
			line.Position = UDim2.fromOffset(Util.round((x1 + x2) / 2 * scale), Util.round((y1 + y2) / 2 * scale))
			line.Rotation = math.deg(math.atan2(dy, dx))
			line.Size = UDim2.fromOffset(math.max(1, Util.round(length)), thickness)
			line.ZIndex = container.ZIndex + 1
			line.Parent = container

			Util.addCorner(line, math.floor(thickness / 2))
		else
			local x, y, width, height = shape[2], shape[3], shape[4], shape[5]
			local thickness = shape[6]
			local radius = shape[7]

			local shapeFrame = Instance.new("Frame")
			shapeFrame.Name = kind
			shapeFrame.BorderSizePixel = 0
			shapeFrame.Position = UDim2.fromOffset(Util.round(x * scale), Util.round(y * scale))
			shapeFrame.Size = UDim2.fromOffset(math.max(1, Util.round(width * scale)), math.max(1, Util.round(height * scale)))
			shapeFrame.ZIndex = container.ZIndex + 1
			shapeFrame.Parent = container

			local cornerRadius = 0

			if radius ~= nil then
				cornerRadius = radius * scale
			elseif kind == "ring" then
				cornerRadius = math.min(shapeFrame.Size.X.Offset, shapeFrame.Size.Y.Offset) / 2
			end

			if kind == "outline" or kind == "ring" then
				shapeFrame.BackgroundTransparency = 1
				Util.addStroke(
					shapeFrame,
					color,
					math.max(1, Util.round((thickness or 1.4) * scale)),
					transparency
				)
				Util.addCorner(shapeFrame, cornerRadius)
			else
				shapeFrame.BackgroundColor3 = color
				shapeFrame.BackgroundTransparency = transparency
				Util.addCorner(shapeFrame, cornerRadius)
			end
		end
	end

	if opts.Parent then
		container.Parent = opts.Parent
	end

	return container
end

--- Returns true when the icon name exists (images always count).
function Icon.exists(name: string): boolean
	return isImage(name) or ICONS[resolveName(name)] ~= nil
end

--- List of every vector icon name (aliases excluded).
function Icon.list(): { string }
	local names: { string } = {}

	for name in ICONS do
		table.insert(names, name)
	end

	table.sort(names)

	return names
end

return Icon
end

__modules["src/Maid"] = function()
--!strict
--[[
	MidnightUI · Maid
	------------------------------------------------------------------
	Lifecycle helper. Anything added to a Maid is cleaned up when the
	Maid is cleaned, which makes `:Destroy()` on windows/elements
	trivially leak-free.

	Supported tasks:
		· Instance            -> :Destroy()
		· RBXScriptConnection -> :Disconnect()
		· Signal connection   -> :Disconnect()
		· function            -> called
		· table with Destroy  -> :Destroy()
		· thread              -> coroutine.close() (task.cancel fallback)
]]

local Maid = {}
Maid.__index = Maid

export type Task = any

export type Maid = typeof(setmetatable(
	{} :: {
		_tasks: { [number]: Task },
		_destroyed: boolean,
	},
	Maid
))

local function isConnection(task: any): boolean
	return type(task) == "table"
		and task.Connected ~= nil
		and type(task.Disconnect) == "function"
end

--// Public API -------------------------------------------------------

function Maid.new(): Maid
	return setmetatable({
		_tasks = {},
		_destroyed = false,
	}, Maid) :: Maid
end

--- Registers a task to be cleaned up later.
function Maid.Add(self: Maid, task: Task): Task
	assert(task ~= nil, "[MidnightUI] Maid:Add received nil")

	if self._destroyed then
		Maid._clean(task)

		return task
	end

	table.insert(self._tasks, task)

	return task
end

--- Registers several tasks at once.
function Maid.AddAll(self: Maid, ...: Task)
	for index = 1, select("#", ...) do
		self:Add((select(index, ...)))
	end
end

--- Registers a task and returns a proxy whose :Destroy() removes it.
function Maid.AddProxy(self: Maid, task: Task): Task
	self:Add(task)

	return task
end

--- Internal single-task cleanup.
function Maid._clean(task: Task)
	local taskType = type(task)

	if taskType == "function" then
		task()
	elseif taskType == "thread" then
		local ok = pcall(task.cancel, task)
		if not ok then
			pcall(coroutine.close, task)
		end
	elseif taskType == "table" then
		if isConnection(task) then
			task:Disconnect()
		elseif type(task.Destroy) == "function" then
			task:Destroy()
		elseif type(task.Disconnect) == "function" then
			task:Disconnect()
		end
	elseif typeof(task) == "Instance" then
		task:Destroy()
	elseif typeof(task) == "RBXScriptConnection" then
		task:Disconnect()
	end
end

--- Cleans every registered task (the Maid stays reusable).
function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}

	for index = #tasks, 1, -1 do
		local ok, err = pcall(Maid._clean, tasks[index])

		if not ok then
			warn(("[MidnightUI] Maid task errored while cleaning: %s"):format(tostring(err)))
		end
	end
end

--- Cleans and permanently disables the Maid.
function Maid.Destroy(self: Maid)
	if self._destroyed then
		return
	end

	self:Clean()
	self._destroyed = true
end

--- Returns how many tasks are still tracked.
function Maid.GetTaskCount(self: Maid): number
	return #self._tasks
end

--- Wraps a task so it can be used as a connection-like handle.
function Maid.Wrap(self: Maid, task: Task): { Destroy: (self: any) -> () }
	self:Add(task)

	local handle = {}

	function handle:Destroy()
		for index, stored in self._tasks do
			if stored == task then
				table.remove(self._tasks, index)
				break
			end
		end

		Maid._clean(task)
	end

	return handle
end

return Maid
end

__modules["src/Notification"] = function()
--!strict
--[[
	MidnightUI · Notification
	------------------------------------------------------------------
	Toast cards that slide in from the right with an accent strip, a
	title, a body and a progress bar. Up to `MaxVisible` cards are
	stacked; older ones are dismissed automatically.
]]

local TweenService = game:GetService("TweenService")

local Icon = __req("src/Icon")
local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Notification = {}
Notification.__index = Notification

export type Kind = "Info" | "Success" | "Warning" | "Error"

export type Props = {
	Title: string?,
	Text: string?,
	Duration: number?,
	Kind: Kind?,
	Icon: string?,
}

export type Notification = typeof(setmetatable(
	{} :: {
		Window: any,
		Theme: any,
		Root: Frame,
		Height: number,
		Duration: number,
		Closing: boolean,
		_maid: any,
		_layout: (() -> ())?,
		_onClosed: (() -> ())?,
	},
	Notification
))

local KIND_COLORS: { [string]: string } = {
	Info = "Info",
	Success = "Success",
	Warning = "Warning",
	Error = "Danger",
}

local KIND_ICONS: { [string]: string } = {
	Info = "info",
	Success = "check",
	Warning = "warning",
	Error = "warning",
}

--// Construction -----------------------------------------------------

function Notification.new(window: any, props: Props, layout: (() -> ())?, onClosed: (() -> ())?): Notification
	local theme = window.Theme
	local metrics = theme.Metrics.Notification

	local self: any = setmetatable({}, Notification)

	self.Window = window
	self.Theme = theme
	self.Closing = false
	self.Duration = props.Duration or metrics.Duration
	self._maid = window._maid:AddProxy(Maid.new())
	self._layout = layout
	self._onClosed = onClosed

	local kind = props.Kind or "Info"
	local accentKey = KIND_COLORS[kind] or "Info"
	local accent = theme.Colors[accentKey] or theme.Colors.Info
	local iconName = props.Icon or KIND_ICONS[kind] or "info"

	local root = Instance.new("Frame")

	root.Name = "Notification"
	root.AnchorPoint = Vector2.new(1, 1)
	root.BackgroundColor3 = theme.Colors.Popup
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.Position = UDim2.new(1, metrics.Margin + metrics.Width, 1, -metrics.Margin)
	root.Size = UDim2.fromOffset(metrics.Width, metrics.MinHeight)
	root.ZIndex = 60
	root.Parent = window.Root

	Util.addCorner(root, metrics.Radius)

	local stroke = Util.addStroke(root, theme.Colors.PopupBorder, 1, 1)

	--// Accent strip ----------------------------------------------------
	local strip = Instance.new("Frame")

	strip.Name = "Accent"
	strip.AnchorPoint = Vector2.new(0, 0.5)
	strip.BackgroundColor3 = accent
	strip.BorderSizePixel = 0
	strip.Position = UDim2.new(0, 0, 0.5, 0)
	strip.Size = UDim2.new(0, metrics.AccentWidth, 1, 0)
	strip.ZIndex = 61
	strip.Parent = root

	--// Icon --------------------------------------------------------------
	local icon = Icon.create(iconName, {
		Size = metrics.IconSize,
		Color = accent,
		Parent = root,
		Position = UDim2.fromOffset(metrics.Padding + 2, metrics.Padding + 1),
		Name = "Icon",
		ZIndex = 62,
	})

	--// Text ------------------------------------------------------------------
	local textLeft = metrics.Padding + metrics.IconSize + 10
	local hasTitle = props.Title ~= nil and props.Title ~= ""

	local title = Instance.new("TextLabel")

	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(textLeft, metrics.Padding - 2)
	title.Size = UDim2.new(1, -(textLeft + metrics.Padding), 0, 16)
	title.Text = props.Title or ""
	title.TextColor3 = theme.Colors.Text
	title.TextSize = metrics.TitleTextSize
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Visible = hasTitle
	title.ZIndex = 62
	title.Parent = root

	Util.setFont(title, theme.Fonts.Bold)

	local body = Instance.new("TextLabel")

	body.Name = "Text"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(textLeft, hasTitle and (metrics.Padding + 14) or (metrics.Padding - 2))
	body.Size = UDim2.new(1, -(textLeft + metrics.Padding), 0, 16)
	body.Text = props.Text or ""
	body.TextColor3 = theme.Colors.TextDim
	body.TextSize = metrics.TextSize
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Center
	body.TextTruncate = Enum.TextTruncate.AtEnd
	body.ZIndex = 62
	body.Parent = root

	Util.setFont(body, theme.Fonts.Small)

	--// Progress ------------------------------------------------------------
	local progress = Instance.new("Frame")

	progress.Name = "Progress"
	progress.AnchorPoint = Vector2.new(0, 1)
	progress.BackgroundColor3 = accent
	progress.BackgroundTransparency = 0.45
	progress.BorderSizePixel = 0
	progress.Position = UDim2.new(0, 0, 1, 0)
	progress.Size = UDim2.new(1, 0, 0, 2)
	progress.ZIndex = 62
	progress.Parent = root

	local height = math.max(metrics.MinHeight, (hasTitle and 34 or 24) + metrics.Padding * 2)

	root.Size = UDim2.fromOffset(metrics.Width, height)
	self.Height = height

	self.Root = root
	self._closed = false
	self.Accent = accent
	self.Title = title
	self.Text = body

	--// Animation ------------------------------------------------------------
	local targetPosition = UDim2.new(1, -metrics.Margin, 1, -metrics.Margin)

	Util.tween(root, { BackgroundTransparency = 0 }, theme, { Duration = theme.Animation.Normal })
	Util.tween(stroke, { Transparency = 0 }, theme, { Duration = theme.Animation.Normal })
	Util.tween(root, { Position = targetPosition }, theme, {
		Duration = theme.Animation.Slow,
		Style = theme.Animation.Easing,
	})

	local progressTween = TweenService:Create(
		progress,
		TweenInfo.new(self.Duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.new(0, 0, 0, 2) }
	)

	progressTween:Play()
	self._maid:Add(progressTween)

	if self.Duration > 0 then
		task.delay(self.Duration, function()
			if not self._closed then
				self:Close()
			end
		end)
	end

	--// Click to dismiss -------------------------------------------------------
	root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:Close()
		end
	end)

	return self :: Notification
end

--// Public API -------------------------------------------------------

function Notification.Close(self: Notification)
	if self.Closing then
		return
	end

	self.Closing = true
	self._closed = true

	local theme = self.Theme
	local metrics = theme.Metrics.Notification
	local root = self.Root

	Util.tween(root, { Position = UDim2.new(1, metrics.Margin + metrics.Width, 1, -metrics.Margin) }, theme, {
		Duration = theme.Animation.Normal,
		Style = theme.Animation.EasingIn,
	})
	Util.tween(root, { BackgroundTransparency = 1 }, theme, { Duration = theme.Animation.Normal })

	local stroke = Util.findClass(root, "UIStroke")

	if stroke ~= nil then
		Util.tween(stroke, { Transparency = 1 }, theme, { Duration = theme.Animation.Normal })
	end

	task.delay(theme.Animation.Normal + 0.02, function()
		self._maid:Destroy()

		if root.Parent ~= nil then
			root:Destroy()
		end

		if self._onClosed ~= nil then
			self._onClosed()
		end

		if self._layout ~= nil then
			self._layout()
		end
	end)
end

function Notification.IsClosed(self: Notification): boolean
	return self.Closing
end

return Notification
end

__modules["src/Page"] = function()
--!strict
--[[
	MidnightUI · Page
	------------------------------------------------------------------
	A page is one entry of the sidebar ("Self", "Players", "Aimbot"…)
	and owns the masonry grid of groupboxes.

	Layout is fully deterministic: the available width comes from the
	window's own metrics (never from layout read-back) and each section
	reports its height, so the page can lay everything out in one pass:

		· columns are filled like a masonry grid (the next groupbox goes
		  into the currently shortest column)
		· `Column = 1|2|"Left"|"Right"` pins a groupbox to a column
]]

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Section = __req("src/Section")

local Page = {}
Page.__index = Page

export type Options = {
	Group: string?,
	Icon: string?,
	Order: number?,
	Columns: number?,
}

export type Page = typeof(setmetatable(
	{} :: {
		Name: string,
		Tab: any,
		Window: any,
		Theme: any,
		Group: string?,
		Icon: string?,
		Root: CanvasGroup,
		Scrolling: ScrollingFrame,
		Sections: { any },
		Columns: number,
		Order: number,
		_maid: any,
		_visible: boolean,
		_destroyed: boolean,
		_layoutQueued: boolean,
	},
	Page
))

local SCROLLBAR_RESERVE = 10

--// Construction -----------------------------------------------------

function Page.new(window: any, tab: any, name: string, options: Options?): Page
	local opts = options or {}
	local theme = window.Theme

	local self: any = setmetatable({}, Page)

	self.Name = name
	self.Tab = tab
	self.Window = window
	self.Theme = theme
	self.Group = opts.Group
	self.Icon = opts.Icon
	self.Order = opts.Order or 1
	self.Columns = opts.Columns or window.Config.Columns or 2
	self.Sections = {}
	self._visible = false
	self._destroyed = false
	self._layoutQueued = false
	self._maid = window._maid:AddProxy(Maid.new())

	--// Root -----------------------------------------------------------
	local root = Instance.new("CanvasGroup")

	root.Name = name
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.GroupTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Visible = false
	root.Parent = window.Content

	self.Root = root

	--// Scrolling -------------------------------------------------------
	local scrolling = Instance.new("ScrollingFrame")

	scrolling.Name = "Scroll"
	scrolling.BackgroundTransparency = 1
	scrolling.BorderSizePixel = 0
	scrolling.CanvasSize = UDim2.fromOffset(0, 0)
	scrolling.ScrollBarImageColor3 = theme.Colors.Scrollbar
	scrolling.ScrollBarThickness = theme.Metrics.Scrollbar.Thickness
	scrolling.ScrollingDirection = Enum.ScrollingDirection.Y
	scrolling.Size = UDim2.fromScale(1, 1)
	scrolling.Parent = root

	self.Scrolling = scrolling

	return self :: Page
end

--// Layout -----------------------------------------------------------

--- Width available for a grid of groupboxes.
function Page.GetAreaWidth(self: Page): number
	return math.max(120, self.Window:GetSectionAreaWidth() - SCROLLBAR_RESERVE)
end

--- Returns the index of the shortest column (ties prefer the leftmost).
local function shortestColumn(bottoms: { number }): number
	local best = 1

	for index = 2, #bottoms do
		if bottoms[index] < bottoms[best] - 0.5 then
			best = index
		end
	end

	return best
end

--- Re-runs the masonry layout.
function Page.Relayout(self: Page)
	if self._destroyed then
		return
	end

	local metrics = self.Theme.Metrics
	local columns = math.max(1, math.floor(self.Columns))
	local gapX = metrics.Panel.ColumnGap
	local gapY = metrics.Panel.RowGap
	local areaWidth = self:GetAreaWidth()
	local sectionWidth = math.max(60, (areaWidth - gapX * (columns - 1)) / columns)

	local bottoms: { number } = {}

	for index = 1, columns do
		bottoms[index] = 0
	end

	local maxBottom = 0

	for _, section in self.Sections do
		if not section:IsDestroyed() and section.Instance.Visible then
			local column = section:GetColumn()

			if type(column) == "string" then
				local lowered = (column :: any):lower()

				column = (lowered == "left" or lowered == "first") and 1 or columns
			end

			if type(column) ~= "number" then
				column = shortestColumn(bottoms)
			end

			column = Util.clamp(math.floor(column :: number), 1, columns)

			local x = (column - 1) * (sectionWidth + gapX)
			local y = bottoms[column]

			section:SetWidth(sectionWidth)
			section:SetPosition(x, y)

			local height = section.Height

			bottoms[column] = y + height + gapY
			maxBottom = math.max(maxBottom, bottoms[column])
		end
	end

	local canvasHeight = math.max(0, maxBottom - (maxBottom > 0 and gapY or 0))

	self.Scrolling.CanvasSize = UDim2.fromOffset(0, canvasHeight)
end

--- Batches relayout requests into a single deferred call.
function Page._requestLayout(self: Page)
	if self._layoutQueued or self._destroyed then
		return
	end

	self._layoutQueued = true

	task.defer(function()
		self._layoutQueued = false

		if not self._destroyed then
			self:Relayout()
		end
	end)
end

--// Grid config ------------------------------------------------------

function Page.SetColumns(self: Page, columns: number)
	self.Columns = math.max(1, math.floor(columns))

	self:Relayout()
end

function Page.GetColumns(self: Page): number
	return self.Columns
end

--// Sections ---------------------------------------------------------

export type GroupboxOptions = {
	Side: (string | number)?,
	Column: number?,
	Icon: string?,
	Collapsed: boolean?,
	Collapsible: boolean?,
	Description: string?,
	Order: number?,
}

--- Creates a groupbox (panel) inside this page.
function Page.Groupbox(self: Page, title: string, options: GroupboxOptions?): any
	local opts = options or {}
	local sectionOptions = {
		Column = opts.Column or opts.Side,
		Icon = opts.Icon,
		Collapsed = opts.Collapsed,
		Collapsible = opts.Collapsible,
		Description = opts.Description,
		Order = opts.Order or (#self.Sections + 1),
	}

	local section = Section.new(self, title, sectionOptions)

	section.Instance.Parent = self.Scrolling

	table.insert(self.Sections, section)

	self:Relayout()

	return section
end

--- Aliases keep the API discoverable for different naming tastes.
Page.Panel = Page.Groupbox
Page.Section = Page.Groupbox
Page.Card = Page.Groupbox

function Page._removeSection(self: Page, section: any)
	for index, stored in self.Sections do
		if stored == section then
			table.remove(self.Sections, index)
			break
		end
	end

	self:Relayout()
end

function Page.GetSections(self: Page): { any }
	return self.Sections
end

--- Every element of every section (used by the search palette).
function Page.GetElements(self: Page): { any }
	local elements: { any } = {}

	for _, section in self.Sections do
		for _, element in section:GetElements() do
			table.insert(elements, element)
		end
	end

	return elements
end

function Page.FindSection(self: Page, title: string): any
	for _, section in self.Sections do
		if section.Name == title then
			return section
		end
	end

	return nil
end

--// Visibility -------------------------------------------------------

function Page.IsVisible(self: Page): boolean
	return self._visible
end

function Page.Show(self: Page, animate: boolean?)
	self._visible = true
	self.Root.Visible = true

	local theme = self.Theme

	if animate == false or not theme.Animation.Enabled then
		self.Root.GroupTransparency = 0

		for _, section in self.Sections do
			section:Appear(0, true)
		end

		self:Relayout()

		return
	end

	self.Root.GroupTransparency = 1
	self:Relayout()

	local index = 0

	for _, section in self.Sections do
		section:Appear(index * 0.025, false)

		index += 1
	end

	Util.tween(self.Root, { GroupTransparency = 0 }, theme, {
		Duration = theme.Animation.Normal,
	})
end

function Page.Hide(self: Page, instant: boolean?)
	self._visible = false

	if instant == true or not self.Theme.Animation.Enabled then
		self.Root.Visible = false
		self.Root.GroupTransparency = 1

		return
	end

	Util.tween(self.Root, { GroupTransparency = 1 }, self.Theme, {
		Duration = self.Theme.Animation.Fast,
	})

	task.delay(self.Theme.Animation.Fast, function()
		if not self._visible then
			self.Root.Visible = false
		end
	end)
end

--- Scrolls the page so that a section becomes visible.
function Page.ScrollToSection(self: Page, section: any, animate: boolean?)
	local position = section.Instance.Position

	Util.tween(
		self.Scrolling,
		{ CanvasPosition = Vector2.new(0, math.max(0, position.Y.Offset - 12)) },
		self.Theme,
		{ Duration = animate == false and 0 or 0.35 }
	)
end

--// Destructor -------------------------------------------------------

function Page.Destroy(self: Page)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Sections, 1, -1 do
		local section = self.Sections[index]
		self.Sections[index] = nil

		section:Destroy()
	end

	self._maid:Destroy()
	self.Root:Destroy()

	if self.Tab ~= nil then
		self.Tab:_removePage(self)
	end

	self.Tab = nil
	self.Window = nil
end

function Page.IsDestroyed(self: Page): boolean
	return self._destroyed
end

return Page
end

__modules["src/Popup"] = function()
--!strict
--[[
	MidnightUI · Popup
	------------------------------------------------------------------
	Floating surface used by Dropdown, ColorPicker, the search bar, the
	settings panel and tooltips.

	Popups live in the window's overlay layer (never inside a
	ScrollingFrame), so they are never clipped. While a popup is open
	its position is refreshed every frame, which keeps it glued to its
	anchor even when the page underneath is being scrolled.

	Behaviour included out of the box:
		· auto flip when there is not enough space below the anchor
		· click-outside / Escape to close
		· scale + fade opening animation
		· one popup at a time per window
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Popup = {}
Popup.__index = Popup

export type ContentCallback = (parent: Frame) -> number

export type Config = {
	Anchor: GuiObject,
	Width: number?,
	Content: ContentCallback,
	Direction: ("Down" | "Up" | "Auto")?,
	Offset: number?,
	Padding: number?,
	Radius: number?,
	OnClose: (() -> ())?,
	Name: string?,
	--- `false` lets the caller manage its own children (used by the
	--- dropdown so that its search box keeps focus while filtering).
	Rebuild: boolean?,
}

export type Popup = typeof(setmetatable(
	{} :: {
		Window: any,
		Theme: any,
		Anchor: GuiObject,
		Root: Frame,
		Inner: Frame,
		Scale: UIScale,
		Width: number,
		Height: number,
		Direction: string,
		Offset: number,
		Padding: number,
		Open: boolean,
		Closing: boolean,
		_content: ContentCallback,
		_rebuild: boolean,
		_onClose: (() -> ())?,
		_maid: any,
	},
	Popup
))

--// Positioning ------------------------------------------------------

function Popup._computePosition(self: Popup)
	local window = self.Window
	local overlay = window.Overlay
	local anchor = self.Anchor

	if anchor == nil or anchor.Parent == nil or overlay == nil or overlay.Parent == nil then
		Popup.Close(self)

		return
	end

	local scale = math.max(window:GetScale(), 0.01)
	local anchorPosition = anchor.AbsolutePosition - overlay.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize
	local overlaySize = overlay.AbsoluteSize

	local width = self.Width * scale
	local height = self.Height * scale

	local direction = self.Direction

	if direction == "Auto" then
		local spaceBelow = overlaySize.Y - (anchorPosition.Y + anchorSize.Y)
		local spaceAbove = anchorPosition.Y

		direction = (spaceBelow >= height + self.Offset * scale or spaceBelow >= spaceAbove) and "Down" or "Up"
	end

	local y: number

	if direction == "Down" then
		y = anchorPosition.Y + anchorSize.Y + self.Offset * scale
	else
		y = anchorPosition.Y - height - self.Offset * scale
	end

	local x = anchorPosition.X

	if x + width > overlaySize.X then
		x = overlaySize.X - width
	end

	x = math.max(0, math.min(x, math.max(0, overlaySize.X - width)))
	y = math.max(0, math.min(y, math.max(0, overlaySize.Y - height)))

	self.Root.Position = UDim2.fromOffset(math.floor(x / scale), math.floor(y / scale))
end

--// Input ------------------------------------------------------------

local function isInside(position: Vector2, objectPosition: Vector2, objectSize: Vector2): boolean
	return position.X >= objectPosition.X
		and position.X <= objectPosition.X + objectSize.X
		and position.Y >= objectPosition.Y
		and position.Y <= objectPosition.Y + objectSize.Y
end

function Popup._bindInput(self: Popup)
	self._maid:Add(UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or not self:IsOpen() then
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			Popup.Close(self)

			return
		end

		local inputType = input.UserInputType

		if inputType ~= Enum.UserInputType.MouseButton1
			and inputType ~= Enum.UserInputType.MouseButton2
			and inputType ~= Enum.UserInputType.Touch
		then
			return
		end

		local position = Vector2.new(input.Position.X, input.Position.Y)

		if isInside(position, self.Root.AbsolutePosition, self.Root.AbsoluteSize) then
			return
		end

		if isInside(position, self.Anchor.AbsolutePosition, self.Anchor.AbsoluteSize) then
			return
		end

		Popup.Close(self)
	end))

	self._maid:Add(RunService.RenderStepped:Connect(function()
		if self:IsOpen() then
			Popup._computePosition(self)
		end
	end))

	self._maid:Add(self.Window.VisibilityChanged:Connect(function(visible: boolean)
		if not visible then
			Popup.Close(self)
		end
	end))

	self._maid:Add(self.Window.ThemeChanged:Connect(function()
		Popup.Close(self)
	end))
end

--// Construction -----------------------------------------------------

function Popup.new(window: any, config: Config): Popup
	local theme = window.Theme
	local metrics = theme.Metrics

	local self: any = setmetatable({}, Popup)

	self.Window = window
	self.Theme = theme
	self.Anchor = config.Anchor
	self.Direction = config.Direction or "Auto"
	self.Offset = config.Offset or metrics.Popup.Offset
	self.Padding = config.Padding or metrics.Popup.Padding
	self.Open = true
	self.Closing = false
	self._content = config.Content
	self._onClose = config.OnClose
	self._rebuild = config.Rebuild ~= false
	self._maid = Maid.new()

	local radius = config.Radius or metrics.Popup.Radius
	local width = config.Width or config.Anchor.AbsoluteSize.X

	if width == nil or width <= 0 then
		width = 160
	end

	self.Width = width

	local root = Instance.new("Frame")

	root.Name = config.Name or "Popup"
	root.BackgroundColor3 = theme.Colors.Popup
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = false
	root.Size = UDim2.fromOffset(width, 0)
	root.ZIndex = 20
	root.Parent = window.Overlay

	Util.addCorner(root, radius)

	local stroke = Util.addStroke(root, theme.Colors.PopupBorder, 1, 1)

	local scale = Instance.new("UIScale")

	scale.Scale = 0.97
	scale.Parent = root

	local inner = Instance.new("Frame")

	inner.Name = "Content"
	inner.BackgroundTransparency = 1
	inner.BorderSizePixel = 0
	inner.Position = UDim2.fromOffset(self.Padding, self.Padding)
	inner.Size = UDim2.new(1, -self.Padding * 2, 1, -self.Padding * 2)
	inner.ClipsDescendants = false
	inner.ZIndex = 21
	inner.Parent = root

	self.Root = root
	self.Inner = inner
	self.Scale = scale

	local contentHeight = self._content(inner) or 0

	self.Height = math.max(0, contentHeight) + self.Padding * 2
	root.Size = UDim2.fromOffset(width, self.Height)

	Popup._computePosition(self)
	Popup._bindInput(self)

	Util.tween(root, { BackgroundTransparency = 0 }, theme, {
		Duration = theme.Animation.Fast,
	})
	Util.tween(stroke, { Transparency = 0 }, theme, {
		Duration = theme.Animation.Fast,
	})
	Util.tween(scale, { Scale = 1 }, theme, {
		Duration = theme.Animation.Normal,
		Style = theme.Animation.EasingBounce,
	})

	return self :: Popup
end

--// Public API -------------------------------------------------------

--- Rebuilds the popup content and resizes it (dropdowns use this while
--- filtering, colour pickers when switching to the advanced view, …).
function Popup.Refresh(self: Popup)
	if not self:IsOpen() then
		return
	end

	if self._rebuild then
		Util.clearChildren(self.Inner)
	end

	local contentHeight = self._content(self.Inner) or 0

	self.Height = math.max(0, contentHeight) + self.Padding * 2
	self.Root.Size = UDim2.fromOffset(self.Width, self.Height)

	Popup._computePosition(self)
end

--- Changes the popup width (e.g. when the anchor resized).
function Popup.SetWidth(self: Popup, width: number)
	if width <= 0 or width == self.Width then
		return
	end

	self.Width = width
	self.Root.Size = UDim2.fromOffset(width, self.Height)

	Popup._computePosition(self)
end

function Popup.Close(self: Popup)
	if self.Closing or not self.Open then
		return
	end

	self.Closing = true

	local theme = self.Theme
	local root = self.Root
	local stroke = Util.findClass(root, "UIStroke")
	local duration = theme.Animation.Enabled and theme.Animation.Fast or 0

	Util.tween(root, { BackgroundTransparency = 1 }, theme, { Duration = duration })
	Util.tween(self.Scale, { Scale = 0.97 }, theme, { Duration = duration })

	if stroke ~= nil then
		Util.tween(stroke, { Transparency = 1 }, theme, { Duration = duration })
	end

	task.delay(duration, function()
		self.Open = false
		self._maid:Destroy()

		if root.Parent ~= nil then
			root:Destroy()
		end

		if self._onClose ~= nil then
			local ok, err = pcall(self._onClose)

			if not ok then
				warn(("[MidnightUI] Popup close handler errored: %s"):format(tostring(err)))
			end
		end
	end)
end

function Popup.IsOpen(self: Popup): boolean
	return self.Open and not self.Closing
end

return Popup
end

__modules["src/Section"] = function()
--!strict
--[[
	MidnightUI · Section
	------------------------------------------------------------------
	A Section is the "groupbox" panel seen on the screenshots: a
	rounded card with a bold header, a hairline divider, an optional
	collapse chevron and a vertical stack of elements.

	Sections participate in the masonry layout of their page: they
	report their own height (computed from the elements they contain,
	never from layout read-back, which keeps everything deterministic)
	and are placed by `Page:_relayout()`.
]]

local Icon = __req("src/Icon")
local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Element = __req("src/Element")
local Button = __req("src/Elements/Button")
local ColorPicker = __req("src/Elements/ColorPicker")
local Divider = __req("src/Elements/Divider")
local Dropdown = __req("src/Elements/Dropdown")
local Keybind = __req("src/Elements/Keybind")
local Label = __req("src/Elements/Label")
local Slider = __req("src/Elements/Slider")
local Textbox = __req("src/Elements/Textbox")
local Toggle = __req("src/Elements/Toggle")

local Section = {}
Section.__index = Section

export type Options = {
	Side: (string | number)?,
	Column: number?,
	Width: number?,
	Icon: string?,
	Collapsed: boolean?,
	Description: string?,
	Collapsible: boolean?,
	Chevron: boolean?,
	Divider: boolean?,
	Order: number?,
}

export type Section = typeof(setmetatable(
	{} :: {
		Name: string,
		Page: any,
		Window: any,
		Theme: any,
		Instance: Frame,
		Header: Frame,
		Title: TextLabel,
		Content: CanvasGroup,
		Elements: { any },
		Options: Options,
		Collapsed: boolean,
		Height: number,
		_maid: any,
		_order: number,
		_column: number?,
		_destroyed: boolean,
		_animating: boolean,
	},
	Section
))

--// Construction -----------------------------------------------------

function Section.new(page: any, name: string, options: Options?): Section
	local self: any = setmetatable({}, Section)
	local opts: Options = options or {}
	local theme = page.Theme
	local metrics = theme.Metrics

	self.Name = name
	self.Page = page
	self.Window = page.Window
	self.Theme = theme
	self.Options = opts
	self.Elements = {}
	self.Collapsed = opts.Collapsed == true
	self.Height = metrics.Panel.HeaderHeight
	self._maid = Maid.new()
	self._order = opts.Order or 1
	self._column = opts.Column
	self._destroyed = false
	self._animating = false
	self._elementOrder = 0
	self._appearOffset = 0
	self._width = nil

	--// Panel ---------------------------------------------------------
	local panel = Instance.new("Frame")

	panel.Name = "Section"
	panel.BackgroundColor3 = theme.Colors.Panel
	panel.BackgroundTransparency = 1
	panel.BorderSizePixel = 0
	panel.Size = UDim2.new(1, 0, 0, self.Height)
	panel.LayoutOrder = self._order

	Util.addCorner(panel, metrics.Panel.Radius)
	Util.addStroke(panel, theme.Colors.PanelBorder, 1, 1)

	self.Instance = panel

	--// Header --------------------------------------------------------
	local header = Instance.new("Frame")

	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, metrics.Panel.HeaderHeight)
	header.ZIndex = 3
	header.Parent = panel

	local headerPadding = metrics.Panel.Padding
	local titleX = headerPadding

	if opts.Icon ~= nil then
		Icon.create(opts.Icon, {
			Size = 15,
			Color = theme.Colors.PanelHeader,
			Parent = header,
			Position = UDim2.fromOffset(headerPadding, (metrics.Panel.HeaderHeight - 15) / 2),
			Name = "SectionIcon",
			ZIndex = 4,
		})

		titleX = headerPadding + 15 + 8
	end

	local title = Instance.new("TextLabel")

	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(titleX, 0)
	title.Size = UDim2.new(1, -(titleX + headerPadding + 18), 1, 0)
	title.Text = name
	title.TextColor3 = theme.Colors.PanelHeader
	title.TextSize = metrics.Panel.HeaderTextSize
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.ZIndex = 4
	title.Parent = header

	Util.setFont(title, theme.Fonts.Panel)

	self.Header = header
	self.Title = title

	-- Chevron is opt-in: the reference groupbox headers are plain text.
	local chevron = nil

	if opts.Chevron == true then
		chevron = Icon.create("chevronDown", {
			Size = 14,
			Color = theme.Colors.TextMuted,
			Parent = header,
			Position = UDim2.new(1, -(headerPadding + 14), 0, (metrics.Panel.HeaderHeight - 14) / 2),
			AnchorPoint = Vector2.new(0, 0),
			Name = "Chevron",
			ZIndex = 4,
		})

		chevron.Rotation = self.Collapsed and -90 or 0
	end

	--// Divider (opt-in, the reference header is plain text) -----------
	if opts.Divider == true then
		local divider = Instance.new("Frame")

		divider.Name = "Divider"
		divider.AnchorPoint = Vector2.new(0.5, 0)
		divider.BackgroundColor3 = theme.Colors.PanelDivider
		divider.BorderSizePixel = 0
		divider.Position = UDim2.new(0.5, 0, 0, metrics.Panel.HeaderHeight - 1)
		divider.Size = UDim2.new(1, -headerPadding * 2, 0, 1)
		divider.ZIndex = 3
		divider.Parent = panel
	end

	--// Content -------------------------------------------------------
	local content = Instance.new("CanvasGroup")

	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ClipsDescendants = true
	content.Position = UDim2.fromOffset(headerPadding, metrics.Panel.HeaderHeight + metrics.Panel.TopPadding)
	content.Size = UDim2.new(1, -headerPadding * 2, 0, 0)
	content.ZIndex = 2
	content.Parent = panel

	Util.addList(content, {
		Padding = metrics.Panel.Gap,
		Direction = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})

	self.Content = content

	--// Behaviour -----------------------------------------------------
	if opts.Collapsible ~= false then
		self:Connect(header.MouseButton1Click, function()
			self:ToggleCollapse()
		end)
	end

	self:_applyVisualState(true)
	self:_updateHeight()

	return self :: Section
end

--// Internals --------------------------------------------------------

function Section.Connect(self: Section, signal: any, callback: (...any) -> ()): any
	local connection = signal:Connect(callback)

	self._maid:Add(connection)

	return connection
end

--- Reveals the panel by sliding it up; the page fades the whole
--- content in one go, sections only need to stagger their offset.
function Section.Appear(self: Section, delay: number?, instant: boolean?)
	local theme = self.Theme

	if instant == true then
		self._appearOffset = 0
		self:_updatePosition()

		return
	end

	self._appearOffset = 16

	self:_updatePosition()

	Util.tween(self.Instance, { Position = UDim2.fromOffset(self._layoutX or 0, self._layoutY or 0) }, theme, {
		Duration = theme.Animation.Slow,
		DelayTime = delay or 0,
	})
end

--- Applies the panel size, preserving an explicitly assigned column width.
function Section._applySize(self: Section)
	if self._width ~= nil then
		self.Instance.Size = UDim2.new(0, self._width, 0, self.Height)
	else
		self.Instance.Size = UDim2.new(1, 0, 0, self.Height)
	end
end

--- Keeps the content frame's height in sync with the elements it holds.
--- The content clips its children, so a stale height would hide them.
function Section._syncContentSize(self: Section, targetHeight: number?)
	local content = self.Content
	local height = targetHeight or self:_getContentHeight()

	if self.Collapsed then
		height = 0
	end

	content.Size = UDim2.new(content.Size.X.Scale, content.Size.X.Offset, 0, height)
end

--- Snaps the collapsed/expanded state without animating.
function Section._applyVisualState(self: Section)
	local content = self.Content
	local targetHeight = self:_getContentHeight()
	local panelHeight = self:_getPanelHeight(targetHeight)

	self:_syncContentSize(targetHeight)

	content.GroupTransparency = self.Collapsed and 1 or 0
	content.Visible = not self.Collapsed

	self.Height = panelHeight
	self:_applySize()
end

--- Content height = sum of element heights + gaps.
function Section._getContentHeight(self: Section): number
	local visibleCount = 0
	local total = 0

	for _, element in self.Elements do
		if not element:IsDestroyed() and element:IsVisible() then
			visibleCount += 1
			total += element:GetHeight()
		end
	end

	if visibleCount > 1 then
		total += self.Theme.Metrics.Panel.Gap * (visibleCount - 1)
	end

	return math.max(0, total)
end

function Section._getPanelHeight(self: Section, contentHeight: number?): number
	local metrics = self.Theme.Metrics

	if self.Collapsed then
		return metrics.Panel.HeaderHeight + 4
	end

	local height = contentHeight or self:_getContentHeight()

	return metrics.Panel.HeaderHeight + metrics.Panel.TopPadding + height + metrics.Panel.BottomPadding
end

--- Recomputes the height and asks the window to re-run the layout.
function Section._updateHeight(self: Section)
	local contentHeight = self:_getContentHeight()
	local panelHeight = self:_getPanelHeight(contentHeight)

	self.Height = panelHeight
	self:_applySize()

	if not self._animating then
		self:_syncContentSize(contentHeight)
	end
end

function Section._notifyLayoutChanged(self: Section)
	self:_updateHeight()

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--- Positions the panel (called by the page's masonry layout).
function Section.SetPosition(self: Section, x: number, y: number)
	self._layoutX = x
	self._layoutY = y

	self.Instance.Position = UDim2.fromOffset(x, y + (self._appearOffset or 0))
end

function Section._updatePosition(self: Section)
	if self._layoutX == nil then
		return
	end

	self.Instance.Position = UDim2.fromOffset(self._layoutX, self._layoutY + (self._appearOffset or 0))
end

function Section.SetWidth(self: Section, width: number)
	self._width = width

	self:_updateHeight()
end

function Section.GetColumn(self: Section): number?
	return self._column
end

function Section.SetColumn(self: Section, column: number?)
	self._column = column

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--// Public API -------------------------------------------------------

function Section.SetTitle(self: Section, title: string)
	self.Name = title
	self.Title.Text = title
end

function Section.SetCollapsed(self: Section, collapsed: boolean)
	if self.Collapsed == collapsed or self._destroyed then
		return
	end

	local theme = self.Theme
	local content = self.Content
	local targetHeight = self:_getContentHeight()
	local chevron = self.Header:FindFirstChild("Chevron")

	self.Collapsed = collapsed
	self._animating = true

	if not collapsed then
		content.Visible = true
	end

	local heightTween = Util.tween(
		content,
		{ Size = UDim2.new(content.Size.X.Scale, content.Size.X.Offset, 0, collapsed and 0 or targetHeight) },
		theme,
		{ Duration = theme.Animation.Normal }
	)

	Util.tween(content, { GroupTransparency = collapsed and 1 or 0 }, theme, {
		Duration = theme.Animation.Normal,
	})

	if chevron ~= nil then
		Util.tween(chevron, { Rotation = collapsed and -90 or 0 }, theme, {
			Duration = theme.Animation.Normal,
		})
	end

	local panelHeight = self:_getPanelHeight(targetHeight)

	self.Height = panelHeight

	local panelSize = if self._width ~= nil
		then UDim2.new(0, self._width, 0, panelHeight)
		else UDim2.new(1, 0, 0, panelHeight)

	Util.tween(self.Instance, { Size = panelSize }, theme, {
		Duration = theme.Animation.Normal,
	})

	heightTween.Completed:Once(function()
		self._animating = false

		if collapsed then
			content.Visible = false
		else
			self:_syncContentSize(self:_getContentHeight())
		end

		if self.Page ~= nil then
			self.Page:_requestLayout()
		end
	end)

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

function Section.ToggleCollapse(self: Section)
	self:SetCollapsed(not self.Collapsed)
end

function Section.SetVisible(self: Section, visible: boolean)
	self.Instance.Visible = visible

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--// Element helpers --------------------------------------------------

--- Shared element finalisation: parenting, registration, animation.
function Section._addElement(self: Section, element: any): any
	self._elementOrder += 1
	element.Container.LayoutOrder = self._elementOrder
	element.Container.Parent = self.Content

	table.insert(self.Elements, element)
	element:SetSection(self)

	if self.Window ~= nil then
		self.Window:_registerElement(element)
	end

	self:_notifyLayoutChanged()

	return element
end

function Section.Toggle(self: Section, props: any): any
	return self:_addElement(Toggle.new(self, props))
end

function Section.Slider(self: Section, props: any): any
	return self:_addElement(Slider.new(self, props))
end

function Section.Dropdown(self: Section, props: any): any
	return self:_addElement(Dropdown.new(self, props))
end

function Section.Textbox(self: Section, props: any): any
	return self:_addElement(Textbox.new(self, props))
end

function Section.Button(self: Section, props: any): any
	return self:_addElement(Button.new(self, props))
end

function Section.Keybind(self: Section, props: any): any
	return self:_addElement(Keybind.new(self, props))
end

function Section.ColorPicker(self: Section, props: any): any
	return self:_addElement(ColorPicker.new(self, props))
end

function Section.Label(self: Section, props: any): any
	return self:_addElement(Label.new(self, props))
end

function Section.Paragraph(self: Section, props: any): any
	return self:_addElement(Label.new(self, {
		Text = props and props.Text or props,
		Wrapped = true,
		Title = props and props.Title or nil,
		Flag = props and props.Flag or nil,
		Callback = props and props.Callback or nil,
	}))
end

function Section.Divider(self: Section, props: any?): any
	return self:_addElement(Divider.new(self, props or {}))
end

--- Adds empty vertical space of `size` pixels (layout sugar).
function Section.Gap(self: Section, size: number?): any
	return self:_addElement(Divider.new(self, { Height = size or 6, Invisible = true }))
end

--- Removes an element.
function Section.RemoveElement(self: Section, element: any)
	for index, stored in self.Elements do
		if stored == element then
			table.remove(self.Elements, index)
			break
		end
	end

	element:Destroy()

	self:_notifyLayoutChanged()
end

function Section.GetElements(self: Section): { any }
	return self.Elements
end

--// Destructor -------------------------------------------------------

function Section.Destroy(self: Section)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Elements, 1, -1 do
		local element = self.Elements[index]
		self.Elements[index] = nil
		element:Destroy()
	end

	self._maid:Destroy()
	self.Instance:Destroy()

	if self.Page ~= nil then
		self.Page:_removeSection(self)
	end

	self.Page = nil
	self.Window = nil
end

function Section.IsDestroyed(self: Section): boolean
	return self._destroyed
end

return Section
end

__modules["src/Signal"] = function()
--!strict
--[[
	MidnightUI · Signal
	------------------------------------------------------------------
	A tiny, allocation-friendly event implementation used everywhere
	inside the library. It intentionally mirrors the RBXScriptSignal
	API (:Connect / :Once / :Wait / :Disconnect) so that library code
	and user code can treat internal and Roblox signals the same way.
]]

local Signal = {}
Signal.__index = Signal

export type Callback<T...> = (T...) -> ()
export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
	Destroy: (self: Connection) -> (),
}

export type Signal<T...> = typeof(setmetatable(
	{} :: {
		_handlers: { [number]: Callback<T...> },
		_nextId: number,
	},
	Signal
))

--// Internal ---------------------------------------------------------

local function newConnection(owner: any, id: number): Connection
	local connection = {
		Connected = true,
	}

	function connection.Disconnect(_self: Connection)
		if not connection.Connected then
			return
		end

		connection.Connected = false
		owner._handlers[id] = nil
	end

	connection.Destroy = connection.Disconnect

	return connection
end

--// Public API -------------------------------------------------------

--- Creates a brand new signal.
function Signal.new<T...>(): Signal<T...>
	return setmetatable({
		_handlers = {} :: { [number]: Callback<T...> },
		_nextId = 0,
	}, Signal :: any) :: Signal<T...>
end

--- Connects `callback` to the signal.
function Signal.Connect<T...>(self: Signal<T...>, callback: Callback<T...>): Connection
	assert(type(callback) == "function", "[MidnightUI] Signal:Connect expects a function")

	self._nextId += 1

	local id = self._nextId
	self._handlers[id] = callback

	return newConnection(self, id)
end

--- Connects `callback` and disconnects it right after the first fire.
function Signal.Once<T...>(self: Signal<T...>, callback: Callback<T...>): Connection
	local connection: Connection

	connection = self:Connect(function(...)
		connection:Disconnect()
		callback(...)
	end)

	return connection
end

--- Fires the signal with the given arguments.
function Signal.Fire<T...>(self: Signal<T...>, ...: T...)
	-- Snapshot: handlers may disconnect (or connect) while we iterate.
	local snapshot = table.clone(self._handlers)

	for _, handler in snapshot do
		local ok, err = pcall(handler, ...)

		if not ok then
			warn(("[MidnightUI] Signal handler errored: %s"):format(tostring(err)))
		end
	end
end

--- Yields the current thread until the signal fires.
function Signal.Wait<T...>(self: Signal<T...>): T...
	local thread = coroutine.running()
	local connection: Connection

	connection = self:Connect(function(...)
		connection:Disconnect()

		task.spawn(thread, ...)
	end)

	return coroutine.yield()
end

--- Removes every connected handler.
function Signal.DisconnectAll<T...>(self: Signal<T...>)
	table.clear(self._handlers)
end

--- Returns the amount of connected handlers.
function Signal.GetHandlerCount<T...>(self: Signal<T...>): number
	return #table.clone(self._handlers)
end

--- Roblox-like alias, mostly for API symmetry.
Signal.Destroy = Signal.DisconnectAll

return Signal
end

__modules["src/Tab"] = function()
--!strict
--[[
	MidnightUI · Tab
	------------------------------------------------------------------
	A top bar tab ("MAIN", "FEATURES", "APPEARANCE"…).

	Each tab owns a list of pages (the sidebar entries) and a lazily
	created default page, so simple menus can skip pages entirely:

		local tab = Window:Tab("Features")
		local box = tab:Groupbox("Aimbot")   -- goes to the default page
]]

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Page = __req("src/Page")

local Tab = {}
Tab.__index = Tab

export type Options = {
	Icon: string?,
	Order: number?,
}

export type PageOptions = {
	Group: string?,
	Icon: string?,
	Order: number?,
	Columns: number?,
}

export type Tab = typeof(setmetatable(
	{} :: {
		Name: string,
		Window: any,
		Theme: any,
		Instance: TextButton,
		Label: TextLabel,
		Underline: Frame,
		Pages: { any },
		Active: boolean,
		Order: number,
		_maid: any,
		_hovering: boolean,
		_destroyed: boolean,
	},
	Tab
))

--// Construction -----------------------------------------------------

function Tab.new(window: any, title: string, options: Options?): Tab
	local opts = options or {}
	local theme = window.Theme

	local self: any = setmetatable({}, Tab)

	self.Name = title
	self.Window = window
	self.Theme = theme
	self.Pages = {}
	self.Active = false
	self.Order = opts.Order or (#window.Tabs + 1)
	self._maid = window._maid:AddProxy(Maid.new())
	self._hovering = false
	self._destroyed = false
	self._defaultPage = nil

	--// Button ---------------------------------------------------------
	local button = Instance.new("TextButton")

	button.Name = "Tab_" .. title
	button.AutoButtonColor = false
	button.AutomaticSize = Enum.AutomaticSize.X
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.LayoutOrder = self.Order
	button.Size = UDim2.new(0, 0, 1, 0)
	button.Text = ""
	button.ZIndex = 4
	button.Parent = window.TabBar

	self.Instance = button

	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.AutomaticSize = Enum.AutomaticSize.X
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0, 0, 1, 0)
	label.Text = title:upper()
	label.TextColor3 = theme.Colors.TabInactive
	label.TextSize = theme.Metrics.Tabs.TextSize
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 5
	label.Parent = button

	Util.setFont(label, theme.Fonts.Tab)

	local underline = Instance.new("Frame")

	underline.Name = "Underline"
	underline.AnchorPoint = Vector2.new(0.5, 1)
	underline.BackgroundColor3 = theme.Colors.Accent
	underline.BackgroundTransparency = 1
	underline.BorderSizePixel = 0
	underline.Position = UDim2.new(0.5, 0, 1, 0)
	underline.Size = UDim2.new(0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)
	underline.ZIndex = 5
	underline.Parent = button

	Util.addCorner(underline, theme.Metrics.Tabs.UnderlineHeight / 2)

	self.Label = label
	self.Underline = underline

	--// Behaviour --------------------------------------------------------
	function self.Refresh()
		local color = if self.Active
			then theme.Colors.TabActive
			elseif self._hovering then theme.Colors.TabHover
			else theme.Colors.TabInactive

		label.TextColor3 = color
		underline.BackgroundColor3 = theme.Colors.Accent
	end

	function self.SetActive(active: boolean, animate: boolean?)
		if self.Active == active then
			return
		end

		self.Active = active

		if not theme.Animation.Enabled then
			animate = false
		end

		if animate == false then
			underline.BackgroundTransparency = active and 0 or 1
			underline.Size = UDim2.new(active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)
			self:Refresh()

			return
		end

		Util.tween(underline, {
			BackgroundTransparency = active and 0 or 1,
			Size = UDim2.new(active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight),
		}, theme, {
			Duration = theme.Animation.Normal,
		})

		self:Refresh()
	end

	function self.OnThemeChanged()
		label.TextSize = theme.Metrics.Tabs.TextSize
		underline.Size = UDim2.new(self.Active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)

		Util.setFont(label, theme.Fonts.Tab)
		self:Refresh()
	end

	self:Connect(button.MouseEnter, function()
		self._hovering = true
		self:Refresh()
	end)

	self:Connect(button.MouseLeave, function()
		self._hovering = false
		self:Refresh()
	end)

	button.MouseButton1Click:Connect(function()
		window:_selectTab(self)
	end)

	self:Refresh()

	return self :: Tab
end

--// Internals --------------------------------------------------------

function Tab.Connect(self: Tab, signal: any, callback: (...any) -> ()): any
	local connection = signal:Connect(callback)

	self._maid:Add(connection)

	return connection
end

function Tab._removePage(self: Tab, page: any)
	for index, stored in self.Pages do
		if stored == page then
			table.remove(self.Pages, index)
			break
		end
	end

	if self._defaultPage == page then
		self._defaultPage = nil
	end

	self.Window:_onPagesChanged()
end

--- The page used when elements are added straight to the tab.
function Tab._getDefaultPage(self: Tab): any
	if self._defaultPage ~= nil and not self._defaultPage:IsDestroyed() then
		return self._defaultPage
	end

	for _, page in self.Pages do
		if not page:IsDestroyed() and page.Group == nil then
			self._defaultPage = page

			return page
		end
	end

	self._defaultPage = self:Page("Main")

	return self._defaultPage
end

--// Public API -------------------------------------------------------

--- Creates a sidebar page inside this tab.
function Tab.Page(self: Tab, title: string, options: PageOptions?): any
	local page = Page.new(self.Window, self, title, options)

	table.insert(self.Pages, page)
	self.Window:_onPagesChanged()

	return page
end

--- Lazily created page for tabs that do not need a sidebar.
function Tab.Groupbox(self: Tab, title: string, options: any?): any
	return self:_getDefaultPage():Groupbox(title, options)
end

Tab.Panel = Tab.Groupbox
Tab.Section = Tab.Groupbox
Tab.Card = Tab.Groupbox

function Tab.GetPages(self: Tab): { any }
	return self.Pages
end

function Tab.FindPage(self: Tab, title: string): any
	for _, page in self.Pages do
		if page.Name == title then
			return page
		end
	end

	return nil
end

function Tab.Select(self: Tab)
	self.Window:_selectTab(self)
end

function Tab.SetTitle(self: Tab, title: string)
	self.Name = title
	self.Label.Text = title:upper()
end

function Tab.IsDestroyed(self: Tab): boolean
	return self._destroyed
end

function Tab.Destroy(self: Tab)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Pages, 1, -1 do
		local page = self.Pages[index]
		self.Pages[index] = nil

		page:Destroy()
	end

	self._maid:Destroy()
	self.Instance:Destroy()

	if self.Window ~= nil then
		self.Window:_removeTab(self)
	end

	self.Window = nil
end

return Tab
end

