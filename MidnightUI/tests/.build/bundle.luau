--// 4. Numeric textbox, multi dropdown, paragraph --------------------------------

step("extra element variants", function()
	boxes.health:Toggle({ Title = "Enable", Flag = "health_enabled" })
	local numeric = boxes.health:Textbox({
		Title = "Amount",
		Numeric = true,
		Min = 0,
		Max = 100,
		Default = 25,
		Flag = "health_amount",
	})
