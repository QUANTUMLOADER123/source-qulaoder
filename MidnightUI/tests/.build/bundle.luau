	},
	warning = {
		{ "line", 10, 2.6, 18.4, 17.4, 1.5 },
		{ "line", 18.4, 17.4, 1.6, 17.4, 1.5 },
		{ "line", 1.6, 17.4, 10, 2.6, 1.5 },
