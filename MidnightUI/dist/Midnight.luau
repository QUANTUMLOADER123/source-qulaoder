end

__modules["src/Elements/Keybind"] = function()
--!strict
--[[
	MidnightUI · Keybind
	------------------------------------------------------------------
	`Label ........................ ( E )` — a circular badge on the
	right that shows the bound key (see the "Type ●" row on the
	screenshots).

	Click the badge to start listening: the badge pulses until a key
	(or a mouse button) is pressed. Escape cancels the capture.
]]

local UserInputService = game:GetService("UserInputService")

local Util = __req("src/Util")

local Element = __req("src/Element")

local Keybind = setmetatable({}, { __index = Element })
Keybind.__index = Keybind
Keybind.Name = "Keybind"

export type Props = {
	Title: string?,
	Default: (string | EnumItem)?,
	Mode: ("Press" | "Hold")?,
	Flag: string?,
	Callback: ((key: string?) -> ())?,
	OnPress: ((pressed: boolean) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

--- Compact labels so keys fit inside the 20px badge.
local SHORT_NAMES: { [string]: string } = {
	Space = "SPC",
	LeftControl = "LCT",
	RightControl = "RCT",
	LeftShift = "LSH",
	RightShift = "RSH",
	LeftAlt = "LAL",
	RightAlt = "RAL",
	Backspace = "BKS",
	Return = "ENT",
	Escape = "ESC",
	Tab = "TAB",
	CapsLock = "CAP",
	Delete = "DEL",
	Insert = "INS",
	PageUp = "PGU",
	PageDown = "PGD",
	Home = "HOM",
	["End"] = "END",
	MouseButton1 = "M1",
	MouseButton2 = "M2",
	MouseButton3 = "M3",
	MouseWheel = "M4",
	Up = "UP",
	Down = "DN",
	Left = "LF",
	Right = "RT",
}

local function toKeyName(value: any): string?
	if value == nil then
		return nil
	end

	if typeof(value) == "EnumItem" then
		return value.Name
	end

	if type(value) == "string" then
		if value == "" then
			return nil
		end

		return value
	end

	return nil
end

local function shortLabel(key: string?): string
	if key == nil then
		return ""
	end

	local mapped = SHORT_NAMES[key]

	if mapped ~= nil then
		return mapped
	end

	if #key <= 3 then
		return key:upper()
	end

	return key:sub(1, 3):upper()
end

local function inputToKeyName(input: InputObject): string?
	if input.KeyCode ~= Enum.KeyCode.Unknown then
		return input.KeyCode.Name
	end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseButton1 then
		return "MouseButton1"
	elseif inputType == Enum.UserInputType.MouseButton2 then
		return "MouseButton2"
	elseif inputType == Enum.UserInputType.MouseButton3 then
		return "MouseButton3"
	elseif inputType == Enum.UserInputType.MouseWheel then
		return "MouseWheel"
	end

	return nil
end

function Keybind.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Keybind,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = toKeyName(options.Default),
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Mode = options.Mode or "Press"
	self.Height = math.max(metrics.KeybindHeight, metrics.KeybindBadge)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	self._capturing = false
	self._pressed = false
	self._hovering = false

	local badgeSize = metrics.KeybindBadge

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, -(badgeSize + metrics.Gap), 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Badge ---------------------------------------------------------
	local badge = Instance.new("Frame")

	badge.Name = "Badge"
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.BackgroundColor3 = theme.Colors.Element
	badge.BorderSizePixel = 0
	badge.Position = UDim2.new(1, 0, 0.5, 0)
	badge.Size = UDim2.fromOffset(badgeSize, badgeSize)
	badge.ZIndex = 2
	badge.Parent = self.Instance

	Util.addCorner(badge, badgeSize / 2)

	local badgeStroke = Util.addStroke(badge, theme.Colors.ElementBorder, 1)

	local badgeText = Instance.new("TextLabel")

	badgeText.Name = "Key"
	badgeText.BackgroundTransparency = 1
	badgeText.Size = UDim2.new(1, -4, 1, 0)
	badgeText.Position = UDim2.fromOffset(2, 0)
	badgeText.Text = ""
	badgeText.TextColor3 = theme.Colors.Text
	badgeText.TextScaled = true
	badgeText.TextXAlignment = Enum.TextXAlignment.Center
	badgeText.TextYAlignment = Enum.TextYAlignment.Center
	badgeText.ZIndex = 3
	badgeText.Parent = badge

	Util.setFont(badgeText, theme.Fonts.Mono)

	local badgeScale = Instance.new("UIScale")

	badgeScale.Parent = badge

	self.Badge = badge
	self.BadgeText = badgeText
	self.Label = label
	self._badgeScale = badgeScale

	--// Visual state ----------------------------------------------------
	function self.Refresh()
		local key = self.Value
		local disabled = self:IsDisabled()

		badgeText.Text = if self._capturing then "…" else shortLabel(key)

		if disabled then
			badge.BackgroundColor3 = theme.Colors.Element
			badgeStroke.Color = theme.Colors.ElementBorder
			badgeStroke.Transparency = 0.5
			badgeText.TextColor3 = theme.Colors.TextDisabled
			label.TextColor3 = theme.Colors.TextDisabled

			return
		end

		local active = self._capturing or self._pressed or self._hovering

		badge.BackgroundColor3 = if active then theme.Colors.ElementActive else theme.Colors.Element
		badgeStroke.Color = if active then theme.Colors.Accent else theme.Colors.ElementBorder
		badgeStroke.Transparency = if self._pressed then 0 else 0.15
		badgeText.TextColor3 = if active and key ~= nil or self._capturing
			then theme.Colors.Accent
			else theme.Colors.TextDim
		label.TextColor3 = theme.Colors.Text
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		Util.tween(badgeScale, { Scale = 1.1 }, theme, { Duration = theme.Animation.Fast })
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false

		Util.tween(badgeScale, { Scale = 1 }, theme, { Duration = theme.Animation.Fast })
		self:Refresh()
	end

	function self.DisabledChanged()
		if self:IsDisabled() then
			self:CancelCapture()
		end

		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(badgeText, theme.Fonts.Mono)
		self:Refresh()
	end

	--// Capture --------------------------------------------------------
	local captureConnection = nil

	local function stopCaptureTween()
		Util.tween(badgeStroke, { Transparency = 0.15 }, theme, { Duration = theme.Animation.Instant })
	end

	function self.CancelCapture()
		if not self._capturing then
			return
		end

		self._capturing = false

		if captureConnection ~= nil then
			captureConnection:Disconnect()
			captureConnection = nil
		end

		stopCaptureTween()
		self:Refresh()
	end

	function self.StartCapture()
		if self._capturing or self:IsDisabled() then
			return
		end

		self._capturing = true

		Util.tween(badgeStroke, { Transparency = 0.7 }, theme, {
			Duration = 0.45,
			Reverses = true,
			RepeatCount = -1,
		})

		self:Refresh()

		captureConnection = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
			if gameProcessed then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseMovement then
				return
			end

			if input.KeyCode == Enum.KeyCode.Escape then
				self:CancelCapture()

				return
			end

			local key = inputToKeyName(input)

			if key == nil then
				return
			end

			self:CancelCapture()
			self:SetValue(key)
		end)
	end

	--// Press handling ---------------------------------------------------
	self:Connect(UserInputService.InputBegan, function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or self:IsDisabled() or self._capturing or self.Value == nil then
			return
		end

		if inputToKeyName(input) ~= self.Value then
			return
		end

		self._pressed = true
		self:Refresh()

		Util.tween(badgeScale, { Scale = 0.9 }, theme, {
			Duration = theme.Animation.Instant,
			Reverses = true,
		})

		if options.OnPress ~= nil then
			local ok, err = pcall(options.OnPress, true)

			if not ok then
				warn(("[MidnightUI] Keybind OnPress errored: %s"):format(tostring(err)))
			end
		end
	end)

	self:Connect(UserInputService.InputEnded, function(input: InputObject)
		if not self._pressed or self:IsDisabled() then
			return
		end

		if inputToKeyName(input) ~= self.Value then
			return
		end

		self._pressed = false
		self:Refresh()

		if self.Mode == "Hold" and options.OnPress ~= nil then
			local ok, err = pcall(options.OnPress, false)

			if not ok then
				warn(("[MidnightUI] Keybind OnPress errored: %s"):format(tostring(err)))
			end
		end
	end)

	--// Interaction -------------------------------------------------------
	self:Connect(badge.InputBegan, function(input: InputObject)
		if self:IsDisabled() or self._capturing then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		self:StartCapture()
	end)

	self:Connect(self.Instance.InputBegan, function(input: InputObject)
		if self:IsDisabled() or self._capturing then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			self:SetValue(nil)
		end
	end)

	--// Public API ---------------------------------------------------------
	function self.IsPressed(): boolean
		return self._pressed
	end

	function self.IsCapturing(): boolean
		return self._capturing
	end

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Keybind
end

__modules["src/Elements/Label"] = function()
--!strict
--[[
	MidnightUI · Label
	------------------------------------------------------------------
	Non-interactive text row. Use it for hints, section captions and
	paragraphs (`Wrapped = true`).

	Wrapped labels need an explicit `Height` because the library uses
	deterministic height accounting instead of reading back layout.
]]

local Util = __req("src/Util")

local Element = __req("src/Element")

local Label = setmetatable({}, { __index = Element })
Label.__index = Label
Label.Name = "Label"

export type Props = {
	Text: string?,
	Title: string?,
	Height: number?,
	TextSize: number?,
	Color: string?,
	Align: ("Left" | "Center" | "Right")?,
	Wrapped: boolean?,
	Bold: boolean?,
	Visible: boolean?,
	Order: number?,
}

function Label.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element
	local text = options.Text or options.Title or ""
	local wrapped = options.Wrapped == true

	local self: any = Element.new({
		Class = Label,
		Title = options.Title,
		Default = text,
		Visible = options.Visible,
		Order = options.Order,
	})

	self.Height = options.Height or (wrapped and 36 or metrics.LabelHeight)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local label = Instance.new("TextLabel")

	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = theme.Colors.TextDim
	label.TextSize = options.TextSize or metrics.TextSize
	label.TextWrapped = wrapped
	label.TextYAlignment = if wrapped then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center
	label.TextXAlignment = if options.Align == "Center"
		then Enum.TextXAlignment.Center
		elseif options.Align == "Right" then Enum.TextXAlignment.Right
		else Enum.TextXAlignment.Left

	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, if options.Bold == true then theme.Fonts.Bold else theme.Fonts.Small)

	self.Label = label
	self.ColorKey = options.Color or "TextDim"

	function self.Refresh()
		local color = theme.Colors[self.ColorKey] or theme.Colors.TextDim
		local disabled = self:IsDisabled()

		label.TextColor3 = if disabled then theme.Colors.TextDisabled else color
	end

	function self.OnThemeChanged()
		Util.setFont(label, if options.Bold == true then theme.Fonts.Bold else theme.Fonts.Small)
		label.TextSize = options.TextSize or metrics.TextSize

		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	--// Public API -------------------------------------------------------
	function self.SetText(value: string)
		self.Value = value
		label.Text = value
	end

	function self.GetText(): string
		return label.Text
	end

	function self.SetColor(colorKey: string)
		self.ColorKey = colorKey

		self:Refresh()
	end

	self:Refresh()

	return self
end

return Label
end

__modules["src/Elements/Slider"] = function()
--!strict
--[[
	MidnightUI · Slider
	------------------------------------------------------------------
	`Label .................... value` on one row with a 4px track below
	and a 12px knob — exactly the layout used on the screenshots.

	Interaction
		· click anywhere on the track to jump to that value
		· drag the knob (delta based, so it stays smooth while the page
		  is scrolling)
		· mouse wheel over the element to nudge the value
		· hold Left Shift while dragging for fine control (0.1x)
]]

local UserInputService = game:GetService("UserInputService")

local Util = __req("src/Util")

local Element = __req("src/Element")

local Slider = setmetatable({}, { __index = Element })
Slider.__index = Slider
Slider.Name = "Slider"

export type Props = {
	Title: string?,
	Min: number?,
	Max: number?,
	Default: number?,
	Decimals: number?,
	Step: number?,
	Prefix: string?,
	Suffix: string?,
	ShowValue: boolean?,
	Flag: string?,
	Callback: ((value: number) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

function Slider.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local minimum = options.Min or 0
	local maximum = options.Max or 100

	if maximum < minimum then
		maximum = minimum
	end

	local decimals = options.Decimals

	if decimals == nil then
		if options.Step ~= nil and options.Step > 0 and options.Step < 1 then
			decimals = #tostring(options.Step):match("%.(%d+)") or 0
		else
			decimals = 0
		end
	end

	local defaultValue = Util.clamp(options.Default or minimum, minimum, maximum)

	local self: any = Element.new({
		Class = Slider,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = defaultValue,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Min = minimum
	self.Max = maximum
	self.Decimals = decimals
	self.Step = options.Step
	self.Prefix = options.Prefix or ""
	self.Suffix = options.Suffix or ""
	self.ShowValue = options.ShowValue ~= false
	self.Height = metrics.SliderHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local labelHeight = 15
	local trackHeight = metrics.SliderTrackHeight
	local knobSize = metrics.SliderKnobSize

	--// Row: label + value --------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, -70, 0, labelHeight)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	local valueLabel = Instance.new("TextLabel")

	valueLabel.Name = "Value"
	valueLabel.BackgroundTransparency = 1
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 0)
	valueLabel.Size = UDim2.new(1, -70, 0, labelHeight)
	valueLabel.Text = ""
	valueLabel.TextColor3 = theme.Colors.Text
	valueLabel.TextSize = metrics.TextSize
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.TextYAlignment = Enum.TextYAlignment.Center
	valueLabel.ZIndex = 2
	valueLabel.Parent = self.Instance

	Util.setFont(valueLabel, theme.Fonts.Text)

	--// Track ---------------------------------------------------------
	local trackArea = Instance.new("Frame")

	trackArea.Name = "TrackArea"
	trackArea.BackgroundTransparency = 1
	trackArea.BorderSizePixel = 0
	trackArea.Position = UDim2.fromOffset(0, self.Height - knobSize)
	trackArea.Size = UDim2.new(1, 0, 0, knobSize)
	trackArea.ZIndex = 2
	trackArea.Parent = self.Instance

	local track = Instance.new("Frame")

	track.Name = "Track"
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.BackgroundColor3 = theme.Colors.Track
	track.BorderSizePixel = 0
	track.Position = UDim2.new(0, 0, 0.5, 0)
	track.Size = UDim2.new(1, 0, 0, trackHeight)
	track.ZIndex = 2
	track.Parent = trackArea

	Util.addCorner(track, trackHeight / 2)

	local fill = Instance.new("Frame")

	fill.Name = "Fill"
	fill.AnchorPoint = Vector2.new(0, 0.5)
	fill.BackgroundColor3 = theme.Colors.TrackFill
	fill.BorderSizePixel = 0
	fill.Position = UDim2.new(0, 0, 0.5, 0)
	fill.Size = UDim2.new(0, 0, 0, trackHeight)
	fill.ZIndex = 3
	fill.Parent = trackArea

	Util.addCorner(fill, trackHeight / 2)

	local knob = Instance.new("Frame")

	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = theme.Colors.Knob
	knob.BorderSizePixel = 0
	knob.Position = UDim2.new(0, 0, 0.5, 0)
	knob.Size = UDim2.fromOffset(knobSize, knobSize)
	knob.ZIndex = 4
	knob.Parent = trackArea

	Util.addCorner(knob, knobSize / 2)

	local knobStroke = Util.addStroke(knob, theme.Colors.ElementBorder, 1)

	local knobScale = Instance.new("UIScale")

	knobScale.Parent = knob

	self.Track = track
	self.Fill = fill
	self.Knob = knob
	self.ValueLabel = valueLabel
	self.Label = label
	self._trackArea = trackArea
	self._knobScale = knobScale
	self._hovering = false
	self._dragging = false
	self._dragConnections = {}

	--// Helpers -------------------------------------------------------
	local function getAlpha(): number
		if maximum == minimum then
			return 0
		end

		return Util.clamp((self.Value - minimum) / (maximum - minimum), 0, 1)
	end

	local function commit(rawValue: number, fireCallback: boolean?)
		local value = Util.clamp(rawValue, minimum, maximum)
		value = Util.snap(value, options.Step, minimum)
		value = Util.clamp(Util.round(value, decimals), minimum, maximum)

		if value == self.Value and fireCallback ~= false then
			return
		end

		self:SetValue(value, fireCallback)
	end

	function self.Refresh()
		local alpha = getAlpha()
		local disabled = self:IsDisabled()

		fill.Size = UDim2.new(alpha, 0, 0, trackHeight)
		knob.Position = UDim2.new(alpha, knobSize / 2 - alpha * knobSize, 0.5, 0)

		valueLabel.Text = self.ShowValue
			and Util.formatValue(self.Value, decimals, self.Prefix, self.Suffix)
			or ""

		fill.BackgroundColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.TrackFill
		knob.BackgroundColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Knob
		knobStroke.Color = self._dragging and theme.Colors.Accent or theme.Colors.ElementBorder
		knobStroke.Transparency = self._dragging and 0 or 0.35

		label.TextColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Text
		valueLabel.TextColor3 = disabled and theme.Colors.TextDisabled or theme.Colors.Text
	end

	function self.ValueChanged()
		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		if not self:IsDisabled() then
			Util.tween(knobScale, { Scale = 1.15 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end
	end

	function self.OnHoverLeave()
		self._hovering = false

		if not self._dragging then
			Util.tween(knobScale, { Scale = 1 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(valueLabel, theme.Fonts.Text)
		track.BackgroundColor3 = theme.Colors.Track

		self:Refresh()
	end

	--// Interaction ---------------------------------------------------
	local function valueFromInputX(inputX: number): number
		local trackWidth = math.max(self._trackArea.AbsoluteSize.X, 1)
		local relative = (inputX - self.Track.AbsolutePosition.X) / trackWidth

		relative = Util.clamp(relative, 0, 1)

		return minimum + relative * (maximum - minimum)
	end

	local function modifierMultiplier(): number
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			return 0.1
		elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			return 0.01
		end

		return 1
	end

	local function stopDragging()
		for _, connection in self._dragConnections do
			connection:Disconnect()
		end

		table.clear(self._dragConnections)

		self._dragging = false

		Util.tween(knobScale, { Scale = self._hovering and 1.15 or 1 }, theme, {
			Duration = theme.Animation.Fast,
		})

		self:Refresh()
	end

	local function startDragging(input: InputObject)
		self._dragging = true

		Util.tween(knobScale, { Scale = 1.28 }, theme, {
			Duration = theme.Animation.Fast,
			Style = theme.Animation.Easing,
		})

		commit(valueFromInputX(input.Position.X))

		table.insert(
			self._dragConnections,
			UserInputService.InputChanged:Connect(function(changed: InputObject)
				if changed.UserInputType ~= Enum.UserInputType.MouseMovement
					and changed.UserInputType ~= Enum.UserInputType.Touch
				then
					return
				end

				local width = math.max(self._trackArea.AbsoluteSize.X, 1)
				local delta = (maximum - minimum) * (changed.Delta.X / width)

				commit(self.Value + delta * modifierMultiplier())
			end)
		)

		table.insert(
			self._dragConnections,
			UserInputService.InputEnded:Connect(function(ended: InputObject)
				if ended.UserInputType == Enum.UserInputType.MouseButton1
					or ended.UserInputType == Enum.UserInputType.Touch
				then
					stopDragging()
				end
			end)
		)
	end

	self:Connect(trackArea.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			startDragging(input)
		end
	end)

	--// Mouse wheel ---------------------------------------------------
	self:Connect(trackArea.InputChanged, function(input: InputObject)
		if self:IsDisabled() or input.UserInputType ~= Enum.UserInputType.MouseWheel then
			return
		end

		local increment = options.Step

		if increment == nil or increment <= 0 then
			increment = (maximum - minimum) / 100
		end

		commit(self.Value + increment * input.Position.Z)
	end)

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Slider
end

__modules["src/Elements/Textbox"] = function()
--!strict
--[[
	MidnightUI · Textbox
	------------------------------------------------------------------
	Label above + flat input box, identical to the dropdown's closed
	state. Focus is highlighted with an accent border.

	`Numeric = true` turns the value into a number clamped to
	[Min, Max] and formatted with `Decimals`.
]]

local Util = __req("src/Util")

local Element = __req("src/Element")

local Textbox = setmetatable({}, { __index = Element })
Textbox.__index = Textbox
Textbox.Name = "Textbox"

export type Props = {
	Title: string?,
	Default: (string | number)?,
	Placeholder: string?,
	Numeric: boolean?,
	Min: number?,
	Max: number?,
	Decimals: number?,
	MaxLength: number?,
	Live: boolean?,
	Flag: string?,
	Callback: ((value: any) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	Order: number?,
}

function Textbox.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Textbox,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = options.Default,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	self.Numeric = options.Numeric == true
	self.Min = options.Min or 0
	self.Max = options.Max or 100
	self.Decimals = options.Decimals or 0
	self.Height = metrics.FieldHeight
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	local labelHeight = 15
	local boxHeight = metrics.FieldBoxHeight

	--// Label ---------------------------------------------------------
	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, 0, 0, labelHeight)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Visible = options.Title ~= nil
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	--// Box -----------------------------------------------------------
	local box = Instance.new("Frame")

	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0, 1)
	box.BackgroundColor3 = theme.Colors.Element
	box.BorderSizePixel = 0
	box.Position = UDim2.new(0, 0, 1, 0)
	box.Size = UDim2.new(1, 0, 0, boxHeight)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, metrics.FieldRadius)

	local boxStroke = Util.addStroke(box, theme.Colors.ElementBorder, 1)

	local input = Instance.new("TextBox")

	input.Name = "Input"
	input.BackgroundTransparency = 1
	input.ClearTextOnFocus = options.ClearOnFocus == true
	input.MultiLine = false
	input.PlaceholderText = options.Placeholder or ""
	input.PlaceholderColor3 = theme.Colors.TextMuted
	input.Position = UDim2.fromOffset(metrics.FieldPadding, 0)
	input.Size = UDim2.new(1, -metrics.FieldPadding * 2, 1, 0)
	input.Text = options.Default ~= nil and tostring(options.Default) or ""
	input.TextColor3 = theme.Colors.Text
	input.TextSize = metrics.FieldTextSize
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.TextYAlignment = Enum.TextYAlignment.Center
	input.TextEditable = true
	input.ZIndex = 3
	input.Parent = box

	if options.MaxLength ~= nil then
		input.MaxVisibleGraphemes = options.MaxLength
	else
		input.MaxVisibleGraphemes = -1
	end

	Util.setFont(input, theme.Fonts.Text)

	self.Box = box
	self.Input = input
	self.Label = label
	self._focused = false
	self._hovering = false

	--// Helpers --------------------------------------------------------
	local function sanitize(text: string): any
		if not self.Numeric then
			return text
		end

		if text == "" or text == "-" then
			return nil
		end

		local filtered = text:gsub("[^%d%.%-]", "")

		if options.Decimals == 0 or options.Decimals == nil then
			filtered = filtered:gsub("%.", "")
		end

		local number = tonumber(filtered)

		if number == nil then
			return nil
		end

		number = Util.clamp(number, self.Min, self.Max)

		return Util.round(number, self.Decimals)
	end

	local function displayValue(): string
		if self.Value == nil then
			return ""
		end

		if self.Numeric then
			return Util.formatValue(self.Value, self.Decimals, "", "")
		end

		return tostring(self.Value)
	end

	local function commit(fireCallback: boolean?)
		local parsed = sanitize(input.Text)

		if self.Numeric and parsed == nil then
			input.Text = displayValue()

			return
		end

		self:SetValue(self.Numeric and parsed or input.Text, fireCallback)
	end

	-- Make sure numeric defaults are shown with the right precision.
	input.Text = displayValue()

	--// Visual refresh -------------------------------------------------
	function self.Refresh()
		local disabled = self:IsDisabled()

		box.BackgroundColor3 = if disabled
			then theme.Colors.Element
			elseif self._focused then theme.Colors.ElementActive
			elseif self._hovering then theme.Colors.ElementHover
			else theme.Colors.Element

		boxStroke.Color = if self._focused or self._hovering then theme.Colors.Accent else theme.Colors.ElementBorder
		boxStroke.Transparency = if disabled then 0.5 else 0

		input.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text
		input.TextEditable = not disabled
		label.TextColor3 = if disabled then theme.Colors.TextDisabled else theme.Colors.Text
	end

	function self.ValueChanged()
		if not self._focused then
			input.Text = displayValue()
		end

		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true
		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false
		self:Refresh()
	end

	function self.DisabledChanged()
		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		Util.setFont(input, theme.Fonts.Text)
		self:Refresh()
	end

	--// Interaction ----------------------------------------------------
	self:Connect(input.Focused, function()
		self._focused = true
		self:Refresh()
	end)

	self:Connect(input.FocusLost, function()
		self._focused = false

		commit(true)
		self:Refresh()
	end)

	if options.Live == true then
		self:Connect(input:GetPropertyChangedSignal("Text"), function()
			if not self._focused then
				return
			end

			local parsed = sanitize(input.Text)

			if parsed == nil then
				return
			end

			self.Value = parsed
			self:SetValue(parsed, false)
		end)
	end

	self:Connect(box.InputBegan, function(input2: InputObject)
		if self:IsDisabled() then
			return
		end

		if input2.UserInputType ~= Enum.UserInputType.MouseButton1
			and input2.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		if not self._focused then
			input:CaptureFocus()
		end
	end)

	self:AddHover(self.Instance)

	--// Public API ------------------------------------------------------
	function self.GetValue(): any
		return self.Value
	end

	function self.SetValue(value: any, fireCallback: boolean?)
		if self.Numeric then
			local number = tonumber(value)

			if number == nil then
				number = self.Min
			end

			number = Util.clamp(Util.round(number, self.Decimals), self.Min, self.Max)

			Element.SetValue(self, number, fireCallback)
		else
			Element.SetValue(self, value ~= nil and tostring(value) or "", fireCallback)
		end

		if not self._focused then
			input.Text = displayValue()
		end
	end

	function self.Reset()
		self:SetValue(self._defaultValue)
	end

	self:Refresh()

	return self
end

return Textbox
end

__modules["src/Elements/Toggle"] = function()
--!strict
--[[
	MidnightUI · Toggle
	------------------------------------------------------------------
	The square checkbox used for every "Enable" row on the screenshots.

	Visual anatomy
		· 16x16 rounded square (radius 3) with a hairline border
		· check glyph that pops in with a Back ease when turned on
		· label vertically centred on the right of the box
]]

local Icon = __req("src/Icon")
local Util = __req("src/Util")

local Element = __req("src/Element")

local Toggle = setmetatable({}, { __index = Element })
Toggle.__index = Toggle
Toggle.Name = "Toggle"

export type Props = {
	Title: string?,
	Default: boolean?,
	Flag: string?,
	Callback: ((value: boolean) -> ())?,
	Tooltip: string?,
	Visible: boolean?,
	Disabled: boolean?,
	BoxSize: number?,
	Ripple: boolean?,
	Order: number?,
}

function Toggle.new(section: any, props: Props?): any
	local options = props or {}
	local theme = section.Theme
	local metrics = theme.Metrics.Element

	local self: any = Element.new({
		Class = Toggle,
		Title = options.Title,
		Tooltip = options.Tooltip,
		Flag = options.Flag,
		Default = options.Default == true,
		Callback = options.Callback,
		Visible = options.Visible,
		Disabled = options.Disabled,
		Order = options.Order,
	})

	local boxSize = options.BoxSize or metrics.ToggleSize

	self.Height = math.max(metrics.ToggleHeight, boxSize)
	self.Instance.Size = UDim2.new(1, 0, 0, self.Height)

	--// Checkbox ------------------------------------------------------
	local box = Instance.new("Frame")

	box.Name = "Box"
	box.AnchorPoint = Vector2.new(0, 0.5)
	box.BackgroundColor3 = theme.Colors.ToggleOff
	box.BorderSizePixel = 0
	box.Position = UDim2.new(0, 0, 0.5, 0)
	box.Size = UDim2.fromOffset(boxSize, boxSize)
	box.ZIndex = 2
	box.Parent = self.Instance

	Util.addCorner(box, metrics.ToggleRadius)

	local boxStroke = Util.addStroke(box, theme.Colors.ToggleOffBorder, 1)

	local boxScale = Instance.new("UIScale")

	boxScale.Parent = box

	--// Check glyph ---------------------------------------------------
	local check = Icon.create("check", {
		Size = math.floor(boxSize * 0.66),
		Color = theme.Colors.ToggleCheck,
		Parent = box,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Name = "Check",
		ZIndex = 3,
	})

	local checkScale = Instance.new("UIScale")

	checkScale.Scale = self.Value and 1 or 0
	checkScale.Parent = check

	--// Label ---------------------------------------------------------
	local labelOffset = boxSize + metrics.Gap

	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(labelOffset, 0)
	label.Size = UDim2.new(1, -labelOffset, 1, 0)
	label.Text = options.Title or ""
	label.TextColor3 = theme.Colors.Text
	label.TextSize = metrics.TitleTextSize
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 2
	label.Parent = self.Instance

	Util.setFont(label, theme.Fonts.Text)

	self.Box = box
	self.Check = check
	self.Label = label
	self._boxScale = boxScale
	self._checkScale = checkScale
	self._hovering = false

	--// State painting ------------------------------------------------
	function self.Refresh()
		local value = self.Value == true
		local disabled = self:IsDisabled()

		if disabled then
			box.BackgroundColor3 = theme.Colors.Element
			boxStroke.Color = theme.Colors.ElementBorder
			boxStroke.Transparency = 0.4
			label.TextColor3 = theme.Colors.TextDisabled
			Icon.setColor(check, theme.Colors.TextDisabled)

			return
		end

		if value then
			box.BackgroundColor3 = theme.Colors.ToggleOn
			boxStroke.Color = theme.Colors.ToggleOnBorder
			boxStroke.Transparency = 0
			Icon.setColor(check, theme.Colors.ToggleCheck)
		else
			box.BackgroundColor3 = self._hovering and theme.Colors.ElementActive or theme.Colors.ToggleOff
			boxStroke.Color = self._hovering and theme.Colors.Accent or theme.Colors.ToggleOffBorder
			boxStroke.Transparency = 0
			Icon.setColor(check, theme.Colors.ToggleCheck)
		end

		label.TextColor3 = theme.Colors.Text
	end

	function self.ValueChanged(value: any, animated: boolean?)
		local on = value == true

		if animated == false then
			checkScale.Scale = on and 1 or 0
		else
			Util.tween(checkScale, { Scale = on and 1 or 0 }, theme, {
				Duration = theme.Animation.Normal,
				Style = on and theme.Animation.EasingBounce or theme.Animation.EasingIn,
			})
		end

		self:Refresh()
	end

	function self.OnHoverEnter()
		self._hovering = true

		if not self:IsDisabled() then
			Util.tween(boxScale, { Scale = 1.08 }, theme, {
				Duration = theme.Animation.Fast,
			})
		end

		self:Refresh()
	end

	function self.OnHoverLeave()
		self._hovering = false

		Util.tween(boxScale, { Scale = 1 }, theme, {
			Duration = theme.Animation.Fast,
		})

		self:Refresh()
	end

	function self.DisabledChanged(disabled: boolean)
		if disabled then
			self._hovering = false
		end

		self:Refresh()
	end

	function self.OnThemeChanged()
		Util.setFont(label, theme.Fonts.Text)
		label.TextSize = metrics.TitleTextSize
		self:Refresh()
	end

	--// Interaction ---------------------------------------------------
	self:Connect(self.Instance.InputBegan, function(input: InputObject)
		if self:IsDisabled() then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		Util.tween(boxScale, { Scale = 0.92 }, theme, {
			Duration = theme.Animation.Instant,
			Reverses = true,
		})

		self:SetValue(not self.Value)
	end)

	self:AddHover(self.Instance)
	self:Refresh()

	return self
end

return Toggle
end

