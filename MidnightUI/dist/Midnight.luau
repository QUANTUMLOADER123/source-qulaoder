--// Renderer ---------------------------------------------------------

export type IconOptions = {
	Size: number?,
	Color: Color3?,
	Transparency: number?,
	Parent: Instance?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Name: string?,
	ZIndex: number?,
}

local function isImage(value: string): boolean
	return value:match("^rbxassetid://") ~= nil
		or value:match("^rbxasset://") ~= nil
		or value:match("^http") ~= nil
		or value:match("^rbxthumb://") ~= nil
end

local function resolveName(name: string): string
	local alias = ALIASES[name]

	return alias or name
end

--- Applies a color to an icon built by `Icon.create`.
function Icon.setColor(icon: GuiObject, color: Color3, transparency: number?)
	local alpha = transparency or 0
	local target = icon :: any

	if target:IsA("ImageLabel") then
		target.ImageColor3 = color
		target.ImageTransparency = alpha

		return
	end

	for _, child in icon:GetChildren() do
		local shape = child :: any

		if shape:IsA("Frame") or shape:IsA("ImageLabel") then
			local stroke = Util.findClass(shape, "UIStroke")

			if stroke ~= nil then
				stroke.Color = color
				stroke.Transparency = alpha
			end

			if shape:IsA("Frame") and shape.BackgroundTransparency < 1 then
				shape.BackgroundColor3 = color
				shape.BackgroundTransparency = alpha
			end
		end
	end
end

--- Creates an icon. Returns the container (Frame or ImageLabel).
function Icon.create(name: string, options: IconOptions?): any
	local opts = options or {}
	local size = opts.Size or 16
	local color = opts.Color or Color3.fromRGB(255, 255, 255)
	local transparency = opts.Transparency or 0
	local scale = size / GRID

	if isImage(name) then
		local image = Instance.new("ImageLabel")

		image.Name = opts.Name or "Icon"
		image:SetAttribute("MidnightIcon", name)
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.Image = name
		image.ImageColor3 = color
		image.ImageTransparency = transparency
		image.ScaleType = Enum.ScaleType.Fit
		image.Size = UDim2.fromOffset(size, size)
		image.Position = opts.Position or UDim2.fromOffset(0, 0)
		image.AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0)
		image.ZIndex = opts.ZIndex or 1

		if opts.Parent then
			image.Parent = opts.Parent
		end

		return image
	end

	local container = Instance.new("Frame")

	container.Name = opts.Name or "Icon"
	container:SetAttribute("MidnightIcon", resolveName(name))
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.fromOffset(size, size)
	container.Position = opts.Position or UDim2.fromOffset(0, 0)
	container.AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0)
	container.ZIndex = opts.ZIndex or 1

	local shapes = ICONS[resolveName(name)]

	if shapes == nil then
		warn(("[MidnightUI] Unknown icon %q — rendering a placeholder"):format(name))

		shapes = {
			{ "circle", 5, 5, 10, 10 },
		}
	end

	for _, shape in shapes do
		local kind = shape[1]

		if kind == "line" then
			local x1, y1, x2, y2 = shape[2], shape[3], shape[4], shape[5]
			local thickness = math.max(1, Util.round((shape[6] or 1.4) * scale))
			local dx, dy = x2 - x1, y2 - y1
			local length = math.sqrt(dx * dx + dy * dy) * scale

			local line = Instance.new("Frame")
			line.Name = "Line"
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BackgroundColor3 = color
			line.BackgroundTransparency = transparency
			line.BorderSizePixel = 0
			line.Position = UDim2.fromOffset(Util.round((x1 + x2) / 2 * scale), Util.round((y1 + y2) / 2 * scale))
			line.Rotation = math.deg(math.atan2(dy, dx))
			line.Size = UDim2.fromOffset(math.max(1, Util.round(length)), thickness)
			line.ZIndex = container.ZIndex + 1
			line.Parent = container

			Util.addCorner(line, math.floor(thickness / 2))
		else
			local x, y, width, height = shape[2], shape[3], shape[4], shape[5]
			local thickness = shape[6]
			local radius = shape[7]

			local shapeFrame = Instance.new("Frame")
			shapeFrame.Name = kind
			shapeFrame.BorderSizePixel = 0
			shapeFrame.Position = UDim2.fromOffset(Util.round(x * scale), Util.round(y * scale))
			shapeFrame.Size = UDim2.fromOffset(math.max(1, Util.round(width * scale)), math.max(1, Util.round(height * scale)))
			shapeFrame.ZIndex = container.ZIndex + 1
			shapeFrame.Parent = container

			local cornerRadius = 0

			if radius ~= nil then
				cornerRadius = radius * scale
			elseif kind == "ring" then
				cornerRadius = math.min(shapeFrame.Size.X.Offset, shapeFrame.Size.Y.Offset) / 2
			end

			if kind == "outline" or kind == "ring" then
				shapeFrame.BackgroundTransparency = 1
				Util.addStroke(
					shapeFrame,
					color,
					math.max(1, Util.round((thickness or 1.4) * scale)),
					transparency
				)
				Util.addCorner(shapeFrame, cornerRadius)
			else
				shapeFrame.BackgroundColor3 = color
				shapeFrame.BackgroundTransparency = transparency
				Util.addCorner(shapeFrame, cornerRadius)
			end
		end
	end

	if opts.Parent then
		container.Parent = opts.Parent
	end

	return container
end

--- Returns true when the icon name exists (images always count).
function Icon.exists(name: string): boolean
	return isImage(name) or ICONS[resolveName(name)] ~= nil
end

--- List of every vector icon name (aliases excluded).
function Icon.list(): { string }
	local names: { string } = {}

	for name in ICONS do
		table.insert(names, name)
	end

	table.sort(names)

	return names
end

return Icon
end

__modules["src/Maid"] = function()
--!strict
--[[
	MidnightUI · Maid
	------------------------------------------------------------------
	Lifecycle helper. Anything added to a Maid is cleaned up when the
	Maid is cleaned, which makes `:Destroy()` on windows/elements
	trivially leak-free.

	Supported tasks:
		· Instance            -> :Destroy()
		· RBXScriptConnection -> :Disconnect()
		· Signal connection   -> :Disconnect()
		· function            -> called
		· table with Destroy  -> :Destroy()
		· thread              -> coroutine.close() (task.cancel fallback)
]]

local Maid = {}
Maid.__index = Maid

export type Task = any

export type Maid = typeof(setmetatable(
	{} :: {
		_tasks: { [number]: Task },
		_destroyed: boolean,
	},
	Maid
))

local function isConnection(task: any): boolean
	return type(task) == "table"
		and task.Connected ~= nil
		and type(task.Disconnect) == "function"
end

--// Public API -------------------------------------------------------

function Maid.new(): Maid
	return setmetatable({
		_tasks = {},
		_destroyed = false,
	}, Maid) :: Maid
end

--- Registers a task to be cleaned up later.
function Maid.Add(self: Maid, task: Task): Task
	assert(task ~= nil, "[MidnightUI] Maid:Add received nil")

	if self._destroyed then
		Maid._clean(task)

		return task
	end

	table.insert(self._tasks, task)

	return task
end

--- Registers several tasks at once.
function Maid.AddAll(self: Maid, ...: Task)
	for index = 1, select("#", ...) do
		self:Add((select(index, ...)))
	end
end

--- Registers a task and returns a proxy whose :Destroy() removes it.
function Maid.AddProxy(self: Maid, task: Task): Task
	self:Add(task)

	return task
end

--- Internal single-task cleanup.
function Maid._clean(task: Task)
	local taskType = type(task)

	if taskType == "function" then
		task()
	elseif taskType == "thread" then
		local ok = pcall(task.cancel, task)
		if not ok then
			pcall(coroutine.close, task)
		end
	elseif taskType == "table" then
		if isConnection(task) then
			task:Disconnect()
		elseif type(task.Destroy) == "function" then
			task:Destroy()
		elseif type(task.Disconnect) == "function" then
			task:Disconnect()
		end
	elseif typeof(task) == "Instance" then
		task:Destroy()
	elseif typeof(task) == "RBXScriptConnection" then
		task:Disconnect()
	end
end

--- Cleans every registered task (the Maid stays reusable).
function Maid.Clean(self: Maid)
	local tasks = self._tasks
	self._tasks = {}

	for index = #tasks, 1, -1 do
		local ok, err = pcall(Maid._clean, tasks[index])

		if not ok then
			warn(("[MidnightUI] Maid task errored while cleaning: %s"):format(tostring(err)))
		end
	end
end

--- Cleans and permanently disables the Maid.
function Maid.Destroy(self: Maid)
	if self._destroyed then
		return
	end

	self:Clean()
	self._destroyed = true
end

--- Returns how many tasks are still tracked.
function Maid.GetTaskCount(self: Maid): number
	return #self._tasks
end

--- Wraps a task so it can be used as a connection-like handle.
function Maid.Wrap(self: Maid, task: Task): { Destroy: (self: any) -> () }
	self:Add(task)

	local handle = {}

	function handle:Destroy()
		for index, stored in self._tasks do
			if stored == task then
				table.remove(self._tasks, index)
				break
			end
		end

		Maid._clean(task)
	end

	return handle
end

return Maid
end

__modules["src/Notification"] = function()
--!strict
--[[
	MidnightUI · Notification
	------------------------------------------------------------------
	Toast cards that slide in from the right with an accent strip, a
	title, a body and a progress bar. Up to `MaxVisible` cards are
	stacked; older ones are dismissed automatically.
]]

local TweenService = game:GetService("TweenService")

local Icon = __req("src/Icon")
local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Notification = {}
Notification.__index = Notification

export type Kind = "Info" | "Success" | "Warning" | "Error"

export type Props = {
	Title: string?,
	Text: string?,
	Duration: number?,
	Kind: Kind?,
	Icon: string?,
}

export type Notification = typeof(setmetatable(
	{} :: {
		Window: any,
		Theme: any,
		Root: Frame,
		Height: number,
		Duration: number,
		Closing: boolean,
		_maid: any,
		_layout: (() -> ())?,
		_onClosed: (() -> ())?,
	},
	Notification
))

local KIND_COLORS: { [string]: string } = {
	Info = "Info",
	Success = "Success",
	Warning = "Warning",
	Error = "Danger",
}

local KIND_ICONS: { [string]: string } = {
	Info = "info",
	Success = "check",
	Warning = "warning",
	Error = "warning",
}

--// Construction -----------------------------------------------------

function Notification.new(window: any, props: Props, layout: (() -> ())?, onClosed: (() -> ())?): Notification
	local theme = window.Theme
	local metrics = theme.Metrics.Notification

	local self: any = setmetatable({}, Notification)

	self.Window = window
	self.Theme = theme
	self.Closing = false
	self.Duration = props.Duration or metrics.Duration
	self._maid = window._maid:AddProxy(Maid.new())
	self._layout = layout
	self._onClosed = onClosed

	local kind = props.Kind or "Info"
	local accentKey = KIND_COLORS[kind] or "Info"
	local accent = theme.Colors[accentKey] or theme.Colors.Info
	local iconName = props.Icon or KIND_ICONS[kind] or "info"

	local root = Instance.new("Frame")

	root.Name = "Notification"
	root.AnchorPoint = Vector2.new(1, 1)
	root.BackgroundColor3 = theme.Colors.Popup
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.Position = UDim2.new(1, metrics.Margin + metrics.Width, 1, -metrics.Margin)
	root.Size = UDim2.fromOffset(metrics.Width, metrics.MinHeight)
	root.ZIndex = 60
	root.Parent = window.Root

	Util.addCorner(root, metrics.Radius)

	local stroke = Util.addStroke(root, theme.Colors.PopupBorder, 1, 1)

	--// Accent strip ----------------------------------------------------
	local strip = Instance.new("Frame")

	strip.Name = "Accent"
	strip.AnchorPoint = Vector2.new(0, 0.5)
	strip.BackgroundColor3 = accent
	strip.BorderSizePixel = 0
	strip.Position = UDim2.new(0, 0, 0.5, 0)
	strip.Size = UDim2.new(0, metrics.AccentWidth, 1, 0)
	strip.ZIndex = 61
	strip.Parent = root

	--// Icon --------------------------------------------------------------
	local icon = Icon.create(iconName, {
		Size = metrics.IconSize,
		Color = accent,
		Parent = root,
		Position = UDim2.fromOffset(metrics.Padding + 2, metrics.Padding + 1),
		Name = "Icon",
		ZIndex = 62,
	})

	--// Text ------------------------------------------------------------------
	local textLeft = metrics.Padding + metrics.IconSize + 10
	local hasTitle = props.Title ~= nil and props.Title ~= ""

	local title = Instance.new("TextLabel")

	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(textLeft, metrics.Padding - 2)
	title.Size = UDim2.new(1, -(textLeft + metrics.Padding), 0, 16)
	title.Text = props.Title or ""
	title.TextColor3 = theme.Colors.Text
	title.TextSize = metrics.TitleTextSize
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Visible = hasTitle
	title.ZIndex = 62
	title.Parent = root

	Util.setFont(title, theme.Fonts.Bold)

	local body = Instance.new("TextLabel")

	body.Name = "Text"
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(textLeft, hasTitle and (metrics.Padding + 14) or (metrics.Padding - 2))
	body.Size = UDim2.new(1, -(textLeft + metrics.Padding), 0, 16)
	body.Text = props.Text or ""
	body.TextColor3 = theme.Colors.TextDim
	body.TextSize = metrics.TextSize
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Center
	body.TextTruncate = Enum.TextTruncate.AtEnd
	body.ZIndex = 62
	body.Parent = root

	Util.setFont(body, theme.Fonts.Small)

	--// Progress ------------------------------------------------------------
	local progress = Instance.new("Frame")

	progress.Name = "Progress"
	progress.AnchorPoint = Vector2.new(0, 1)
	progress.BackgroundColor3 = accent
	progress.BackgroundTransparency = 0.45
	progress.BorderSizePixel = 0
	progress.Position = UDim2.new(0, 0, 1, 0)
	progress.Size = UDim2.new(1, 0, 0, 2)
	progress.ZIndex = 62
	progress.Parent = root

	local height = math.max(metrics.MinHeight, (hasTitle and 34 or 24) + metrics.Padding * 2)

	root.Size = UDim2.fromOffset(metrics.Width, height)
	self.Height = height

	self.Root = root
	self.Accent = accent
	self.Title = title
	self.Text = body

	--// Animation ------------------------------------------------------------
	local targetPosition = UDim2.new(1, -metrics.Margin, 1, -metrics.Margin)

	Util.tween(root, { BackgroundTransparency = 0 }, theme, { Duration = theme.Animation.Normal })
	Util.tween(stroke, { Transparency = 0 }, theme, { Duration = theme.Animation.Normal })
	Util.tween(root, { Position = targetPosition }, theme, {
		Duration = theme.Animation.Slow,
		Style = theme.Animation.Easing,
	})

	local progressTween = TweenService:Create(
		progress,
		TweenInfo.new(self.Duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.new(0, 0, 0, 2) }
	)

	progressTween:Play()
	self._maid:Add(progressTween)

	if self.Duration > 0 then
		self._maid:Add(task.delay(self.Duration, function()
			self:Close()
		end))
	end

	--// Click to dismiss -------------------------------------------------------
	root.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:Close()
		end
	end)

	return self :: Notification
end

--// Public API -------------------------------------------------------

function Notification.Close(self: Notification)
	if self.Closing then
		return
	end

	self.Closing = true

	local theme = self.Theme
	local metrics = theme.Metrics.Notification
	local root = self.Root

	Util.tween(root, { Position = UDim2.new(1, metrics.Margin + metrics.Width, 1, -metrics.Margin) }, theme, {
		Duration = theme.Animation.Normal,
		Style = theme.Animation.EasingIn,
	})
	Util.tween(root, { BackgroundTransparency = 1 }, theme, { Duration = theme.Animation.Normal })

	local stroke = Util.findClass(root, "UIStroke")

	if stroke ~= nil then
