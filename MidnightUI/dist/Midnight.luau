	content.BorderSizePixel = 0
	content.ClipsDescendants = true
	content.Position = UDim2.fromOffset(headerPadding, metrics.Panel.HeaderHeight + metrics.Panel.TopPadding)
	content.Size = UDim2.new(1, -headerPadding * 2, 0, 0)
	content.ZIndex = 2
	content.Parent = panel

	Util.addList(content, {
		Padding = metrics.Panel.Gap,
		Direction = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})

	self.Content = content

	--// Behaviour -----------------------------------------------------
	if opts.Collapsible ~= false then
		self:Connect(header.MouseButton1Click, function()
			self:ToggleCollapse()
		end)
	end

	self:_applyVisualState(true)
	self:_updateHeight()

	return self :: Section
end

--// Internals --------------------------------------------------------

function Section.Connect(self: Section, signal: any, callback: (...any) -> ()): any
	local connection = signal:Connect(callback)

	self._maid:Add(connection)

	return connection
end

--- Reveals the panel by sliding it up; the page fades the whole
--- content in one go, sections only need to stagger their offset.
function Section.Appear(self: Section, delay: number?, instant: boolean?)
	local theme = self.Theme

	if instant == true then
		self._appearOffset = 0
		self:_updatePosition()

		return
	end

	self._appearOffset = 16

	self:_updatePosition()

	Util.tween(self.Instance, { Position = UDim2.fromOffset(self._layoutX or 0, self._layoutY or 0) }, theme, {
		Duration = theme.Animation.Slow,
		DelayTime = delay or 0,
	})
end

--- Snaps the collapsed/expanded state without animating.
function Section._applyVisualState(self: Section)
	local content = self.Content
	local targetHeight = self:_getContentHeight()
	local panelHeight = self:_getPanelHeight(targetHeight)

	content.Size = UDim2.new(content.Size.X.Scale, content.Size.X.Offset, 0, self.Collapsed and 0 or targetHeight)
	content.GroupTransparency = self.Collapsed and 1 or 0
	content.Visible = not self.Collapsed

	self.Height = panelHeight
	self.Instance.Size = UDim2.new(1, 0, 0, panelHeight)
end

--- Content height = sum of element heights + gaps.
function Section._getContentHeight(self: Section): number
	local visibleCount = 0
	local total = 0

	for _, element in self.Elements do
		if not element:IsDestroyed() and element:IsVisible() then
			visibleCount += 1
			total += element:GetHeight()
		end
	end

	if visibleCount > 1 then
		total += self.Theme.Metrics.Panel.Gap * (visibleCount - 1)
	end

	return math.max(0, total)
end

function Section._getPanelHeight(self: Section, contentHeight: number?): number
	local metrics = self.Theme.Metrics

	if self.Collapsed then
		return metrics.Panel.HeaderHeight + 4
	end

	local height = contentHeight or self:_getContentHeight()

	return metrics.Panel.HeaderHeight + metrics.Panel.TopPadding + height + metrics.Panel.BottomPadding
end

--- Recomputes the height and asks the window to re-run the layout.
function Section._updateHeight(self: Section)
	local panelHeight = self:_getPanelHeight()

	self.Height = panelHeight
	self.Instance.Size = UDim2.new(1, 0, 0, panelHeight)
end

function Section._notifyLayoutChanged(self: Section)
	self:_updateHeight()

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--- Positions the panel (called by the page's masonry layout).
function Section.SetPosition(self: Section, x: number, y: number)
	self._layoutX = x
	self._layoutY = y

	self.Instance.Position = UDim2.fromOffset(x, y + (self._appearOffset or 0))
end

function Section._updatePosition(self: Section)
	if self._layoutX == nil then
		return
	end

	self.Instance.Position = UDim2.fromOffset(self._layoutX, self._layoutY + (self._appearOffset or 0))
end

function Section.SetWidth(self: Section, width: number)
	self.Instance.Size = UDim2.new(0, width, 0, self.Height)

	self:_updateHeight()
end

function Section.GetColumn(self: Section): number?
	return self._column
end

function Section.SetColumn(self: Section, column: number?)
	self._column = column

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--// Public API -------------------------------------------------------

function Section.SetTitle(self: Section, title: string)
	self.Name = title
	self.Title.Text = title
end

function Section.SetCollapsed(self: Section, collapsed: boolean)
	if self.Collapsed == collapsed or self._destroyed then
		return
	end

	local theme = self.Theme
	local content = self.Content
	local targetHeight = self:_getContentHeight()
	local chevron = self.Header:FindFirstChild("Chevron")

	self.Collapsed = collapsed
	self._animating = true

	if not collapsed then
		content.Visible = true
	end

	local heightTween = Util.tween(
		content,
		{ Size = UDim2.new(content.Size.X.Scale, content.Size.X.Offset, 0, collapsed and 0 or targetHeight) },
		theme,
		{ Duration = theme.Animation.Normal }
	)

	Util.tween(content, { GroupTransparency = collapsed and 1 or 0 }, theme, {
		Duration = theme.Animation.Normal,
	})

	if chevron ~= nil then
		Util.tween(chevron, { Rotation = collapsed and -90 or 0 }, theme, {
			Duration = theme.Animation.Normal,
		})
	end

	local panelHeight = self:_getPanelHeight(targetHeight)

	self.Height = panelHeight

	Util.tween(self.Instance, { Size = UDim2.new(1, 0, 0, panelHeight) }, theme, {
		Duration = theme.Animation.Normal,
	})

	heightTween.Completed:Once(function()
		self._animating = false

		if collapsed then
			content.Visible = false
		end

		if self.Page ~= nil then
			self.Page:_requestLayout()
		end
	end)

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

function Section.ToggleCollapse(self: Section)
	self:SetCollapsed(not self.Collapsed)
end

function Section.SetVisible(self: Section, visible: boolean)
	self.Instance.Visible = visible

	if self.Page ~= nil then
		self.Page:_requestLayout()
	end
end

--// Element helpers --------------------------------------------------

--- Shared element finalisation: parenting, registration, animation.
function Section._addElement(self: Section, element: any): any
	self._elementOrder += 1
	element.Container.LayoutOrder = self._elementOrder
	element.Container.Parent = self.Content

	table.insert(self.Elements, element)
	element:SetSection(self)

	if self.Window ~= nil then
		self.Window:_registerElement(element)
	end

	self:_notifyLayoutChanged()

	return element
end

function Section.Toggle(self: Section, props: any): any
	return self:_addElement(Toggle.new(self, props))
end

function Section.Slider(self: Section, props: any): any
	return self:_addElement(Slider.new(self, props))
end

function Section.Dropdown(self: Section, props: any): any
	return self:_addElement(Dropdown.new(self, props))
end

function Section.Textbox(self: Section, props: any): any
	return self:_addElement(Textbox.new(self, props))
end

function Section.Button(self: Section, props: any): any
	return self:_addElement(Button.new(self, props))
end

function Section.Keybind(self: Section, props: any): any
	return self:_addElement(Keybind.new(self, props))
end

function Section.ColorPicker(self: Section, props: any): any
	return self:_addElement(ColorPicker.new(self, props))
end

function Section.Label(self: Section, props: any): any
	return self:_addElement(Label.new(self, props))
end

function Section.Paragraph(self: Section, props: any): any
	return self:_addElement(Label.new(self, {
		Text = props and props.Text or props,
		Wrapped = true,
		Title = props and props.Title or nil,
		Flag = props and props.Flag or nil,
		Callback = props and props.Callback or nil,
	}))
end

function Section.Divider(self: Section, props: any?): any
	return self:_addElement(Divider.new(self, props or {}))
end

--- Adds empty vertical space of `size` pixels (layout sugar).
function Section.Gap(self: Section, size: number?): any
	return self:_addElement(Divider.new(self, { Height = size or 6, Invisible = true }))
end

--- Removes an element.
function Section.RemoveElement(self: Section, element: any)
	for index, stored in self.Elements do
		if stored == element then
			table.remove(self.Elements, index)
			break
		end
	end

	element:Destroy()

	self:_notifyLayoutChanged()
end

function Section.GetElements(self: Section): { any }
	return self.Elements
end

--// Destructor -------------------------------------------------------

function Section.Destroy(self: Section)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Elements, 1, -1 do
		local element = self.Elements[index]
		self.Elements[index] = nil
		element:Destroy()
	end

	self._maid:Destroy()
	self.Instance:Destroy()

	if self.Page ~= nil then
		self.Page:_removeSection(self)
	end

	self.Page = nil
	self.Window = nil
end

function Section.IsDestroyed(self: Section): boolean
	return self._destroyed
end

return Section
end

__modules["src/Signal"] = function()
--!strict
--[[
	MidnightUI · Signal
	------------------------------------------------------------------
	A tiny, allocation-friendly event implementation used everywhere
	inside the library. It intentionally mirrors the RBXScriptSignal
	API (:Connect / :Once / :Wait / :Disconnect) so that library code
	and user code can treat internal and Roblox signals the same way.
]]

local Signal = {}
Signal.__index = Signal

export type Callback<T...> = (T...) -> ()
export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
	Destroy: (self: Connection) -> (),
}

export type Signal<T...> = typeof(setmetatable(
	{} :: {
		_handlers: { [number]: Callback<T...> },
		_nextId: number,
	},
	Signal
))

--// Internal ---------------------------------------------------------

local function newConnection(owner: any, id: number): Connection
	local connection = {
		Connected = true,
	}

	function connection.Disconnect(_self: Connection)
		if not connection.Connected then
			return
		end

		connection.Connected = false
		owner._handlers[id] = nil
	end

	connection.Destroy = connection.Disconnect

	return connection
end

--// Public API -------------------------------------------------------

--- Creates a brand new signal.
function Signal.new<T...>(): Signal<T...>
	return setmetatable({
		_handlers = {} :: { [number]: Callback<T...> },
		_nextId = 0,
	}, Signal :: any) :: Signal<T...>
end

--- Connects `callback` to the signal.
function Signal.Connect<T...>(self: Signal<T...>, callback: Callback<T...>): Connection
	assert(type(callback) == "function", "[MidnightUI] Signal:Connect expects a function")

	self._nextId += 1

	local id = self._nextId
	self._handlers[id] = callback

	return newConnection(self, id)
end

--- Connects `callback` and disconnects it right after the first fire.
function Signal.Once<T...>(self: Signal<T...>, callback: Callback<T...>): Connection
	local connection: Connection

	connection = self:Connect(function(...)
		connection:Disconnect()
		callback(...)
	end)

	return connection
end

--- Fires the signal with the given arguments.
function Signal.Fire<T...>(self: Signal<T...>, ...: T...)
	-- Snapshot: handlers may disconnect (or connect) while we iterate.
	local snapshot = table.clone(self._handlers)

	for _, handler in snapshot do
		local ok, err = pcall(handler, ...)

		if not ok then
			warn(("[MidnightUI] Signal handler errored: %s"):format(tostring(err)))
		end
	end
end

--- Yields the current thread until the signal fires.
function Signal.Wait<T...>(self: Signal<T...>): T...
	local thread = coroutine.running()
	local connection: Connection

	connection = self:Connect(function(...)
		connection:Disconnect()

		task.spawn(thread, ...)
	end)

	return coroutine.yield()
end

--- Removes every connected handler.
function Signal.DisconnectAll<T...>(self: Signal<T...>)
	table.clear(self._handlers)
end

--- Returns the amount of connected handlers.
function Signal.GetHandlerCount<T...>(self: Signal<T...>): number
	return #table.clone(self._handlers)
end

--- Roblox-like alias, mostly for API symmetry.
Signal.Destroy = Signal.DisconnectAll

return Signal
end

__modules["src/Tab"] = function()
--!strict
--[[
	MidnightUI · Tab
	------------------------------------------------------------------
	A top bar tab ("MAIN", "FEATURES", "APPEARANCE"…).

	Each tab owns a list of pages (the sidebar entries) and a lazily
	created default page, so simple menus can skip pages entirely:

		local tab = Window:Tab("Features")
		local box = tab:Groupbox("Aimbot")   -- goes to the default page
]]

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Page = __req("src/Page")

local Tab = {}
Tab.__index = Tab

export type Options = {
	Icon: string?,
	Order: number?,
}

export type PageOptions = {
	Group: string?,
	Icon: string?,
	Order: number?,
	Columns: number?,
}

export type Tab = typeof(setmetatable(
	{} :: {
		Name: string,
		Window: any,
		Theme: any,
		Instance: TextButton,
		Label: TextLabel,
		Underline: Frame,
		Pages: { any },
		Active: boolean,
		Order: number,
		_maid: any,
		_hovering: boolean,
		_destroyed: boolean,
	},
	Tab
))

--// Construction -----------------------------------------------------

function Tab.new(window: any, title: string, options: Options?): Tab
	local opts = options or {}
	local theme = window.Theme

	local self: any = setmetatable({}, Tab)

	self.Name = title
	self.Window = window
	self.Theme = theme
	self.Pages = {}
	self.Active = false
	self.Order = opts.Order or (#window.Tabs + 1)
	self._maid = window._maid:AddProxy(Maid.new())
	self._hovering = false
	self._destroyed = false
	self._defaultPage = nil

	--// Button ---------------------------------------------------------
	local button = Instance.new("TextButton")

	button.Name = "Tab_" .. title
	button.AutoButtonColor = false
	button.AutomaticSize = Enum.AutomaticSize.X
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.LayoutOrder = self.Order
	button.Size = UDim2.new(0, 0, 1, 0)
	button.Text = ""
	button.ZIndex = 4
	button.Parent = window.TabBar

	self.Instance = button

	local label = Instance.new("TextLabel")

	label.Name = "Label"
	label.AutomaticSize = Enum.AutomaticSize.X
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0, 0, 1, 0)
	label.Text = title:upper()
	label.TextColor3 = theme.Colors.TabInactive
	label.TextSize = theme.Metrics.Tabs.TextSize
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 5
	label.Parent = button

	Util.setFont(label, theme.Fonts.Tab)

	local underline = Instance.new("Frame")

	underline.Name = "Underline"
	underline.AnchorPoint = Vector2.new(0.5, 1)
	underline.BackgroundColor3 = theme.Colors.Accent
	underline.BackgroundTransparency = 1
	underline.BorderSizePixel = 0
	underline.Position = UDim2.new(0.5, 0, 1, 0)
	underline.Size = UDim2.new(0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)
	underline.ZIndex = 5
	underline.Parent = button

	Util.addCorner(underline, theme.Metrics.Tabs.UnderlineHeight / 2)

	self.Label = label
	self.Underline = underline

	--// Behaviour --------------------------------------------------------
	function self.Refresh()
		local color = if self.Active
			then theme.Colors.TabActive
			elseif self._hovering then theme.Colors.TabHover
			else theme.Colors.TabInactive

		label.TextColor3 = color
		underline.BackgroundColor3 = theme.Colors.Accent
	end

	function self.SetActive(active: boolean, animate: boolean?)
		if self.Active == active then
			return
		end

		self.Active = active

		if not theme.Animation.Enabled then
			animate = false
		end

		if animate == false then
			underline.BackgroundTransparency = active and 0 or 1
			underline.Size = UDim2.new(active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)
			self:Refresh()

			return
		end

		Util.tween(underline, {
			BackgroundTransparency = active and 0 or 1,
			Size = UDim2.new(active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight),
		}, theme, {
			Duration = theme.Animation.Normal,
		})

		self:Refresh()
	end

	function self.OnThemeChanged()
		label.TextSize = theme.Metrics.Tabs.TextSize
		underline.Size = UDim2.new(self.Active and 1 or 0.35, 0, 0, theme.Metrics.Tabs.UnderlineHeight)

		Util.setFont(label, theme.Fonts.Tab)
		self:Refresh()
	end

	self:Connect(button.MouseEnter, function()
		self._hovering = true
		self:Refresh()
	end)

	self:Connect(button.MouseLeave, function()
		self._hovering = false
		self:Refresh()
	end)

	button.MouseButton1Click:Connect(function()
		window:_selectTab(self)
	end)

	self:Refresh()

	return self :: Tab
end

--// Internals --------------------------------------------------------

function Tab.Connect(self: Tab, signal: any, callback: (...any) -> ()): any
	local connection = signal:Connect(callback)

	self._maid:Add(connection)

	return connection
end

function Tab._removePage(self: Tab, page: any)
	for index, stored in self.Pages do
		if stored == page then
			table.remove(self.Pages, index)
			break
		end
	end

	if self._defaultPage == page then
		self._defaultPage = nil
	end

	self.Window:_onPagesChanged()
end

--- The page used when elements are added straight to the tab.
function Tab._getDefaultPage(self: Tab): any
	if self._defaultPage ~= nil and not self._defaultPage:IsDestroyed() then
		return self._defaultPage
	end

	for _, page in self.Pages do
		if not page:IsDestroyed() and page.Group == nil then
			self._defaultPage = page

			return page
		end
	end

	self._defaultPage = self:Page("Main")

	return self._defaultPage
end

--// Public API -------------------------------------------------------

--- Creates a sidebar page inside this tab.
function Tab.Page(self: Tab, title: string, options: PageOptions?): any
	local page = Page.new(self.Window, self, title, options)

	table.insert(self.Pages, page)
	self.Window:_onPagesChanged()

	return page
end

--- Lazily created page for tabs that do not need a sidebar.
function Tab.Groupbox(self: Tab, title: string, options: any?): any
	return self:_getDefaultPage():Groupbox(title, options)
end

Tab.Panel = Tab.Groupbox
Tab.Section = Tab.Groupbox
Tab.Card = Tab.Groupbox

function Tab.GetPages(self: Tab): { any }
	return self.Pages
end

function Tab.FindPage(self: Tab, title: string): any
	for _, page in self.Pages do
		if page.Name == title then
			return page
		end
	end

	return nil
end

function Tab.Select(self: Tab)
	self.Window:_selectTab(self)
end

function Tab.SetTitle(self: Tab, title: string)
	self.Name = title
	self.Label.Text = title:upper()
end

function Tab.IsDestroyed(self: Tab): boolean
	return self._destroyed
end

function Tab.Destroy(self: Tab)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Pages, 1, -1 do
		local page = self.Pages[index]
		self.Pages[index] = nil

		page:Destroy()
	end

	self._maid:Destroy()
	self.Instance:Destroy()

	if self.Window ~= nil then
		self.Window:_removeTab(self)
	end

	self.Window = nil
end

return Tab
end

