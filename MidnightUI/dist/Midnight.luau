__modules["src/Page"] = function()
--!strict
--[[
	MidnightUI · Page
	------------------------------------------------------------------
	A page is one entry of the sidebar ("Self", "Players", "Aimbot"…)
	and owns the masonry grid of groupboxes.

	Layout is fully deterministic: the available width comes from the
	window's own metrics (never from layout read-back) and each section
	reports its height, so the page can lay everything out in one pass:

		· columns are filled like a masonry grid (the next groupbox goes
		  into the currently shortest column)
		· `Column = 1|2|"Left"|"Right"` pins a groupbox to a column
]]

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Section = __req("src/Section")

local Page = {}
Page.__index = Page

export type Options = {
	Group: string?,
	Icon: string?,
	Order: number?,
	Columns: number?,
}

export type Page = typeof(setmetatable(
	{} :: {
		Name: string,
		Tab: any,
		Window: any,
		Theme: any,
		Group: string?,
		Icon: string?,
		Root: CanvasGroup,
		Scrolling: ScrollingFrame,
		Sections: { any },
		Columns: number,
		Order: number,
		_maid: any,
		_visible: boolean,
		_destroyed: boolean,
		_layoutQueued: boolean,
	},
	Page
))

local SCROLLBAR_RESERVE = 10

--// Construction -----------------------------------------------------

function Page.new(window: any, tab: any, name: string, options: Options?): Page
	local opts = options or {}
	local theme = window.Theme

	local self: any = setmetatable({}, Page)

	self.Name = name
	self.Tab = tab
	self.Window = window
	self.Theme = theme
	self.Group = opts.Group
	self.Icon = opts.Icon
	self.Order = opts.Order or 1
	self.Columns = opts.Columns or window.Config.Columns or 2
	self.Sections = {}
	self._visible = false
	self._destroyed = false
	self._layoutQueued = false
	self._maid = window._maid:AddProxy(Maid.new())

	--// Root -----------------------------------------------------------
	local root = Instance.new("CanvasGroup")

	root.Name = name
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.GroupTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Visible = false
	root.Parent = window.Content

	self.Root = root

	--// Scrolling -------------------------------------------------------
	local scrolling = Instance.new("ScrollingFrame")

	scrolling.Name = "Scroll"
	scrolling.BackgroundTransparency = 1
	scrolling.BorderSizePixel = 0
	scrolling.CanvasSize = UDim2.fromOffset(0, 0)
	scrolling.ScrollBarImageColor3 = theme.Colors.Scrollbar
	scrolling.ScrollBarThickness = theme.Metrics.Scrollbar.Thickness
	scrolling.ScrollingDirection = Enum.ScrollingDirection.Y
	scrolling.Size = UDim2.fromScale(1, 1)
	scrolling.Parent = root

	self.Scrolling = scrolling

	return self :: Page
end

--// Layout -----------------------------------------------------------

--- Width available for a grid of groupboxes.
function Page.GetAreaWidth(self: Page): number
	return math.max(120, self.Window:GetSectionAreaWidth() - SCROLLBAR_RESERVE)
end

--- Returns the index of the shortest column (ties prefer the leftmost).
local function shortestColumn(bottoms: { number }): number
	local best = 1

	for index = 2, #bottoms do
		if bottoms[index] < bottoms[best] - 0.5 then
			best = index
		end
	end

	return best
end

--- Re-runs the masonry layout.
function Page.Relayout(self: Page)
	if self._destroyed then
		return
	end

	local metrics = self.Theme.Metrics
	local columns = math.max(1, math.floor(self.Columns))
	local gapX = metrics.Panel.ColumnGap
	local gapY = metrics.Panel.RowGap
	local areaWidth = self:GetAreaWidth()
	local sectionWidth = math.max(60, (areaWidth - gapX * (columns - 1)) / columns)

	local bottoms: { number } = {}

	for index = 1, columns do
		bottoms[index] = 0
	end

	local maxBottom = 0

	for _, section in self.Sections do
		if not section:IsDestroyed() and section.Instance.Visible then
			local column = section:GetColumn()

			if type(column) == "string" then
				local lowered = (column :: any):lower()

				column = (lowered == "left" or lowered == "first") and 1 or columns
			end

			if type(column) ~= "number" then
				column = shortestColumn(bottoms)
			end

			column = Util.clamp(math.floor(column :: number), 1, columns)

			local x = (column - 1) * (sectionWidth + gapX)
			local y = bottoms[column]

			section:SetWidth(sectionWidth)
			section:SetPosition(x, y)

			local height = section.Height

			bottoms[column] = y + height + gapY
			maxBottom = math.max(maxBottom, bottoms[column])
		end
	end

	local canvasHeight = math.max(0, maxBottom - (maxBottom > 0 and gapY or 0))

	self.Scrolling.CanvasSize = UDim2.fromOffset(0, canvasHeight)
end

--- Batches relayout requests into a single deferred call.
function Page._requestLayout(self: Page)
	if self._layoutQueued or self._destroyed then
		return
	end

	self._layoutQueued = true

	task.defer(function()
		self._layoutQueued = false

		if not self._destroyed then
			self:Relayout()
		end
	end)
end

--// Grid config ------------------------------------------------------

function Page.SetColumns(self: Page, columns: number)
	self.Columns = math.max(1, math.floor(columns))

	self:Relayout()
end

function Page.GetColumns(self: Page): number
	return self.Columns
end

--// Sections ---------------------------------------------------------

export type GroupboxOptions = {
	Side: (string | number)?,
	Column: number?,
	Icon: string?,
	Collapsed: boolean?,
	Collapsible: boolean?,
	Description: string?,
	Order: number?,
}

--- Creates a groupbox (panel) inside this page.
function Page.Groupbox(self: Page, title: string, options: GroupboxOptions?): any
	local opts = options or {}
	local sectionOptions = {
		Column = opts.Column or opts.Side,
		Icon = opts.Icon,
		Collapsed = opts.Collapsed,
		Collapsible = opts.Collapsible,
		Description = opts.Description,
		Order = opts.Order or (#self.Sections + 1),
	}

	local section = Section.new(self, title, sectionOptions)

	section.Instance.Parent = self.Scrolling

	table.insert(self.Sections, section)

	self:Relayout()

	return section
end

--- Aliases keep the API discoverable for different naming tastes.
Page.Panel = Page.Groupbox
Page.Section = Page.Groupbox
Page.Card = Page.Groupbox

function Page._removeSection(self: Page, section: any)
	for index, stored in self.Sections do
		if stored == section then
			table.remove(self.Sections, index)
			break
		end
	end

	self:Relayout()
end

function Page.GetSections(self: Page): { any }
	return self.Sections
end

--- Every element of every section (used by the search palette).
function Page.GetElements(self: Page): { any }
	local elements: { any } = {}

	for _, section in self.Sections do
		for _, element in section:GetElements() do
			table.insert(elements, element)
		end
	end

	return elements
end

function Page.FindSection(self: Page, title: string): any
	for _, section in self.Sections do
		if section.Name == title then
			return section
		end
	end

	return nil
end

--// Visibility -------------------------------------------------------

function Page.IsVisible(self: Page): boolean
	return self._visible
end

function Page.Show(self: Page, animate: boolean?)
	self._visible = true
	self.Root.Visible = true

	local theme = self.Theme

	if animate == false or not theme.Animation.Enabled then
		self.Root.GroupTransparency = 0

		for _, section in self.Sections do
			section:Appear(0, true)
		end

		self:Relayout()

		return
	end

	self.Root.GroupTransparency = 1
	self:Relayout()

	local index = 0

	for _, section in self.Sections do
		section:Appear(index * 0.025, false)

		index += 1
	end

	Util.tween(self.Root, { GroupTransparency = 0 }, theme, {
		Duration = theme.Animation.Normal,
	})
end

function Page.Hide(self: Page, instant: boolean?)
	self._visible = false

	if instant == true or not self.Theme.Animation.Enabled then
		self.Root.Visible = false
		self.Root.GroupTransparency = 1

		return
	end

	Util.tween(self.Root, { GroupTransparency = 1 }, self.Theme, {
		Duration = self.Theme.Animation.Fast,
	})

	task.delay(self.Theme.Animation.Fast, function()
		if not self._visible then
			self.Root.Visible = false
		end
	end)
end

--- Scrolls the page so that a section becomes visible.
function Page.ScrollToSection(self: Page, section: any, animate: boolean?)
	local position = section.Instance.Position

	Util.tween(
		self.Scrolling,
		{ CanvasPosition = Vector2.new(0, math.max(0, position.Y.Offset - 12)) },
		self.Theme,
		{ Duration = animate == false and 0 or 0.35 }
	)
end

--// Destructor -------------------------------------------------------

function Page.Destroy(self: Page)
	if self._destroyed then
		return
	end

	self._destroyed = true

	for index = #self.Sections, 1, -1 do
		local section = self.Sections[index]
		self.Sections[index] = nil

		section:Destroy()
	end

	self._maid:Destroy()
	self.Root:Destroy()

	if self.Tab ~= nil then
		self.Tab:_removePage(self)
	end

	self.Tab = nil
	self.Window = nil
end

function Page.IsDestroyed(self: Page): boolean
	return self._destroyed
end

return Page
end

__modules["src/Popup"] = function()
--!strict
--[[
	MidnightUI · Popup
	------------------------------------------------------------------
	Floating surface used by Dropdown, ColorPicker, the search bar, the
	settings panel and tooltips.

	Popups live in the window's overlay layer (never inside a
	ScrollingFrame), so they are never clipped. While a popup is open
	its position is refreshed every frame, which keeps it glued to its
	anchor even when the page underneath is being scrolled.

	Behaviour included out of the box:
		· auto flip when there is not enough space below the anchor
		· click-outside / Escape to close
		· scale + fade opening animation
		· one popup at a time per window
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Maid = __req("src/Maid")
local Util = __req("src/Util")

local Popup = {}
Popup.__index = Popup

export type ContentCallback = (parent: Frame) -> number

export type Config = {
	Anchor: GuiObject,
	Width: number?,
	Content: ContentCallback,
	Direction: ("Down" | "Up" | "Auto")?,
	Offset: number?,
	Padding: number?,
	Radius: number?,
	OnClose: (() -> ())?,
	Name: string?,
	--- `false` lets the caller manage its own children (used by the
	--- dropdown so that its search box keeps focus while filtering).
	Rebuild: boolean?,
}

export type Popup = typeof(setmetatable(
	{} :: {
		Window: any,
		Theme: any,
		Anchor: GuiObject,
		Root: Frame,
		Inner: Frame,
		Scale: UIScale,
		Width: number,
		Height: number,
		Direction: string,
		Offset: number,
		Padding: number,
		Open: boolean,
		Closing: boolean,
		_content: ContentCallback,
		_rebuild: boolean,
		_onClose: (() -> ())?,
		_maid: any,
	},
	Popup
))

--// Positioning ------------------------------------------------------

function Popup._computePosition(self: Popup)
	local window = self.Window
	local overlay = window.Overlay
	local anchor = self.Anchor

	if anchor == nil or anchor.Parent == nil or overlay == nil or overlay.Parent == nil then
		Popup.Close(self)

		return
	end

	local scale = math.max(window:GetScale(), 0.01)
	local anchorPosition = anchor.AbsolutePosition - overlay.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize
	local overlaySize = overlay.AbsoluteSize

	local width = self.Width * scale
	local height = self.Height * scale

	local direction = self.Direction

	if direction == "Auto" then
		local spaceBelow = overlaySize.Y - (anchorPosition.Y + anchorSize.Y)
		local spaceAbove = anchorPosition.Y

		direction = (spaceBelow >= height + self.Offset * scale or spaceBelow >= spaceAbove) and "Down" or "Up"
	end

	local y: number

	if direction == "Down" then
		y = anchorPosition.Y + anchorSize.Y + self.Offset * scale
	else
		y = anchorPosition.Y - height - self.Offset * scale
	end

	local x = anchorPosition.X

	if x + width > overlaySize.X then
		x = overlaySize.X - width
	end

	x = math.max(0, math.min(x, math.max(0, overlaySize.X - width)))
	y = math.max(0, math.min(y, math.max(0, overlaySize.Y - height)))

	self.Root.Position = UDim2.fromOffset(math.floor(x / scale), math.floor(y / scale))
end

--// Input ------------------------------------------------------------

local function isInside(position: Vector2, objectPosition: Vector2, objectSize: Vector2): boolean
	return position.X >= objectPosition.X
		and position.X <= objectPosition.X + objectSize.X
		and position.Y >= objectPosition.Y
		and position.Y <= objectPosition.Y + objectSize.Y
end

function Popup._bindInput(self: Popup)
	self._maid:Add(UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed or not self:IsOpen() then
			return
		end

		if input.KeyCode == Enum.KeyCode.Escape then
			Popup.Close(self)

			return
		end

		local inputType = input.UserInputType

		if inputType ~= Enum.UserInputType.MouseButton1
			and inputType ~= Enum.UserInputType.MouseButton2
			and inputType ~= Enum.UserInputType.Touch
		then
			return
		end

		local position = Vector2.new(input.Position.X, input.Position.Y)

		if isInside(position, self.Root.AbsolutePosition, self.Root.AbsoluteSize) then
			return
		end

		if isInside(position, self.Anchor.AbsolutePosition, self.Anchor.AbsoluteSize) then
			return
		end

		Popup.Close(self)
	end))

	self._maid:Add(RunService.RenderStepped:Connect(function()
		if self:IsOpen() then
			Popup._computePosition(self)
		end
	end))

	self._maid:Add(self.Window.VisibilityChanged:Connect(function(visible: boolean)
		if not visible then
			Popup.Close(self)
		end
	end))

	self._maid:Add(self.Window.ThemeChanged:Connect(function()
		Popup.Close(self)
	end))
end

--// Construction -----------------------------------------------------

function Popup.new(window: any, config: Config): Popup
	local theme = window.Theme
	local metrics = theme.Metrics

	local self: any = setmetatable({}, Popup)

	self.Window = window
	self.Theme = theme
	self.Anchor = config.Anchor
	self.Direction = config.Direction or "Auto"
	self.Offset = config.Offset or metrics.Popup.Offset
	self.Padding = config.Padding or metrics.Popup.Padding
	self.Open = true
	self.Closing = false
	self._content = config.Content
	self._onClose = config.OnClose
	self._rebuild = config.Rebuild ~= false
	self._maid = Maid.new()

	local radius = config.Radius or metrics.Popup.Radius
	local width = config.Width or config.Anchor.AbsoluteSize.X

	if width == nil or width <= 0 then
		width = 160
	end

	self.Width = width

	local root = Instance.new("Frame")

	root.Name = config.Name or "Popup"
	root.BackgroundColor3 = theme.Colors.Popup
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = false
	root.Size = UDim2.fromOffset(width, 0)
	root.ZIndex = 20
	root.Parent = window.Overlay

	Util.addCorner(root, radius)

	local stroke = Util.addStroke(root, theme.Colors.PopupBorder, 1, 1)

	local scale = Instance.new("UIScale")

	scale.Scale = 0.97
	scale.Parent = root

	local inner = Instance.new("Frame")

	inner.Name = "Content"
	inner.BackgroundTransparency = 1
	inner.BorderSizePixel = 0
	inner.Position = UDim2.fromOffset(self.Padding, self.Padding)
	inner.Size = UDim2.new(1, -self.Padding * 2, 1, -self.Padding * 2)
	inner.ClipsDescendants = false
	inner.ZIndex = 21
	inner.Parent = root

	self.Root = root
	self.Inner = inner
	self.Scale = scale

	local contentHeight = self._content(inner) or 0

	self.Height = math.max(0, contentHeight) + self.Padding * 2
	root.Size = UDim2.fromOffset(width, self.Height)

	Popup._computePosition(self)
	Popup._bindInput(self)

	Util.tween(root, { BackgroundTransparency = 0 }, theme, {
		Duration = theme.Animation.Fast,
	})
	Util.tween(stroke, { Transparency = 0 }, theme, {
		Duration = theme.Animation.Fast,
	})
	Util.tween(scale, { Scale = 1 }, theme, {
		Duration = theme.Animation.Normal,
		Style = theme.Animation.EasingBounce,
	})

	return self :: Popup
end

--// Public API -------------------------------------------------------

--- Rebuilds the popup content and resizes it (dropdowns use this while
--- filtering, colour pickers when switching to the advanced view, …).
function Popup.Refresh(self: Popup)
	if not self:IsOpen() then
		return
	end

	if self._rebuild then
		Util.clearChildren(self.Inner)
	end

	local contentHeight = self._content(self.Inner) or 0

	self.Height = math.max(0, contentHeight) + self.Padding * 2
	self.Root.Size = UDim2.fromOffset(self.Width, self.Height)

	Popup._computePosition(self)
end

--- Changes the popup width (e.g. when the anchor resized).
function Popup.SetWidth(self: Popup, width: number)
	if width <= 0 or width == self.Width then
		return
	end

	self.Width = width
	self.Root.Size = UDim2.fromOffset(width, self.Height)

	Popup._computePosition(self)
end

function Popup.Close(self: Popup)
	if self.Closing or not self.Open then
		return
	end

	self.Closing = true

	local theme = self.Theme
	local root = self.Root
	local stroke = Util.findClass(root, "UIStroke")
	local duration = theme.Animation.Enabled and theme.Animation.Fast or 0

	Util.tween(root, { BackgroundTransparency = 1 }, theme, { Duration = duration })
	Util.tween(self.Scale, { Scale = 0.97 }, theme, { Duration = duration })

	if stroke ~= nil then
		Util.tween(stroke, { Transparency = 1 }, theme, { Duration = duration })
	end

	task.delay(duration, function()
		self.Open = false
		self._maid:Destroy()

		if root.Parent ~= nil then
			root:Destroy()
		end

		if self._onClose ~= nil then
			local ok, err = pcall(self._onClose)

			if not ok then
				warn(("[MidnightUI] Popup close handler errored: %s"):format(tostring(err)))
			end
		end
	end)
end

function Popup.IsOpen(self: Popup): boolean
	return self.Open and not self.Closing
end

return Popup
end

